@inject Microsoft.Extensions.Options.IOptions<PoliticaPrecios> Politica
@{
    ViewData["Title"] = "Disponibilidad";
    var cabanas = (List<Cabana>)ViewBag.Cabanas;
    var reservas = (List<Reserva>)ViewBag.Reservas;
    var promos = (List<PromoEstadia>)ViewBag.Promos;
    var tarifas = (List<TarifaDia>)ViewBag.Tarifas;
    var fines = (List<FinDeSemanaLargo>)ViewBag.FinesDeSemanaLargos;
    DateTime primerDia = ViewBag.PrimerDia;
    DateTime ultimoDia = ViewBag.UltimoDia;
    DateTime mesAnterior = ViewBag.MesAnterior;
    DateTime mesSiguiente = ViewBag.MesSiguiente;
    bool permitirMesAnterior = ViewBag.PermitirMesAnterior;
    var hoy = DateTime.Today;

    bool NoDisponible(int cabanaId, DateTime dia) => reservas.Any(r => r.CabanaId == cabanaId && r.FechaDesde <= dia && dia < r.FechaHasta);
    int CabanasLibres(DateTime dia) => cabanas.Count(c => !NoDisponible(c.Id, dia));
    bool CabanaEnPromo(int cabanaId, DateTime dia) => promos.Any(p => p.CabanaId == cabanaId && p.FechaDesde.Date <= dia.Date && p.FechaHasta.Date >= dia.Date);
    bool DiaConPromoDisponible(DateTime dia) => cabanas.Any(c => !NoDisponible(c.Id, dia) && CabanaEnPromo(c.Id, dia));
    decimal? PrecioDesdeDelDia(DateTime dia)
    {
        var precios = cabanas
            .Where(c => !NoDisponible(c.Id, dia))
            .Select(c => tarifas.FirstOrDefault(t => t.CabanaId == c.Id && t.Fecha.Date == dia.Date)?.Precio2)
            .Where(p => p.HasValue)
            .Select(p => p!.Value)
            .ToList();
        return precios.Count > 0 ? precios.Min() : (decimal?)null;
    }
    string FormatoCompacto(decimal precio)
    {
        if (precio >= 1000)
        {
            var miles = precio / 1000m;
            var texto = miles == Math.Floor(miles) ? miles.ToString("0") : miles.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
            return texto + "k";
        }
        return precio.ToString("0");
    }

    int offset = ((int)primerDia.DayOfWeek + 6) % 7;
    var celdas = new List<DateTime?>();
    for (int i = 0; i < offset; i++) celdas.Add(null);
    for (int d = 1; d <= ultimoDia.Day; d++) celdas.Add(primerDia.AddDays(d - 1));
    while (celdas.Count % 7 != 0) celdas.Add(null);

    var mesTitulo = primerDia.ToString("MMMM yyyy");
    mesTitulo = char.ToUpper(mesTitulo[0]) + mesTitulo.Substring(1);
}

@Html.AntiForgeryToken()

<a asp-controller="Home" asp-action="Index" class="mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 transition hover:text-river-700">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
    </svg>
    Volver a todas las cabañas
</a>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Disponibilidad &middot; @mesTitulo</h1>
    <div class="flex gap-2">
        @if (permitirMesAnterior)
        {
            <a asp-action="Disponibilidad" asp-route-anio="@mesAnterior.Year" asp-route-mes="@mesAnterior.Month"
               asp-route-desde="@ViewBag.SeleccionDesde" asp-route-hasta="@ViewBag.SeleccionHasta"
               class="nav-mes-link whitespace-nowrap rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700 sm:px-4 sm:py-2 sm:text-sm">&larr; Mes anterior</a>
        }
        <a asp-action="Disponibilidad" asp-route-anio="@mesSiguiente.Year" asp-route-mes="@mesSiguiente.Month"
           asp-route-desde="@ViewBag.SeleccionDesde" asp-route-hasta="@ViewBag.SeleccionHasta"
           class="nav-mes-link whitespace-nowrap rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700 sm:px-4 sm:py-2 sm:text-sm">Mes siguiente &rarr;</a>
    </div>
</div>

<div id="tab-general" class="rounded-2.5xl bg-white p-4 shadow-soft ring-1 ring-ink-100 sm:p-6">
    <partial name="_AvisoFinDeSemanaLargo" model="fines" />

    <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold uppercase tracking-wide text-ink-400">
        <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
    </div>
    <div class="mt-3 grid grid-cols-7 gap-1">
        @foreach (var dia in celdas)
        {
            if (dia is null)
            {
                <div></div>
            }
            else if (dia.Value < hoy)
            {
                var marcoPasado = FinDeSemanaLargo.ClasesMarco(fines, dia.Value);
                <div class="day-cell relative flex h-14 flex-col items-center justify-center rounded-lg bg-ink-50 text-xs leading-tight text-ink-300">
                    @if (marcoPasado is not null)
                    {
                        <span class="@marcoPasado"></span>
                    }
                    @dia.Value.Day
                </div>
            }
            else
            {
                var marco = FinDeSemanaLargo.ClasesMarco(fines, dia.Value);
                var libres = CabanasLibres(dia.Value);
                var conPromo = libres > 0 && DiaConPromoDisponible(dia.Value);
                var precioDesde = libres > 0 ? PrecioDesdeDelDia(dia.Value) : null;
                var clases = libres > 0
                    ? "bg-river-100 text-river-700 hover:bg-river-200"
                    : "bg-rose-100 text-rose-600 hover:bg-rose-200";
                var titulo = conPromo ? "Disponible · con promoción" : (libres > 0 ? "Disponible" : "No disponible");
                if (precioDesde.HasValue)
                {
                    titulo += $" · Desde ${precioDesde.Value:N0} estándar para 2 personas";
                }
                if (marco is not null)
                {
                    titulo += " · Fin de semana largo: se reserva completo";
                }
                <button type="button" onclick="seleccionarDiaGeneral(this)" data-fecha="@dia.Value.ToString("yyyy-MM-dd")"
                        data-clase-base="@clases"
                        title="@titulo"
                        class="day-cell relative flex h-14 flex-col items-center justify-center gap-0 rounded-lg text-sm font-semibold leading-none transition @clases @(conPromo ? "promo-glow" : "")">
                    @if (marco is not null)
                    {
                        <span class="@marco"></span>
                    }
                    @if (conPromo)
                    {
                        <span class="absolute -top-2 right-0.5 text-[9px] font-bold uppercase tracking-wide text-amber-600">Promo</span>
                    }
                    @dia.Value.Day
                    @if (precioDesde.HasValue)
                    {
                        <span class="text-[8px] font-bold leading-none opacity-80">$@FormatoCompacto(precioDesde.Value)</span>
                    }
                </button>
            }
        }
    </div>
    <div class="mt-5 flex flex-wrap items-center gap-4 text-xs text-ink-500">
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-river-100"></span> Disponible</span>
        <span class="flex items-center gap-1.5"><span class="promo-glow h-3 w-3 rounded-full bg-river-100"></span> Con promoción 🎉</span>
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-rose-100"></span> No disponible</span>
        <span class="flex items-center gap-1.5"><span class="font-bold text-ink-700">$</span> Precio para 2 personas</span>
        @if (fines.Count > 0)
        {
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm border-2 border-amber-500"></span> Fin de semana largo (se reserva completo)</span>
        }
    </div>
    <p class="mt-2 text-xs text-ink-400">El precio que ves en cada día del calendario es la tarifa estándar para 2 personas.</p>

    <div id="resumen-seleccion" class="mt-4 flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-river-100 bg-river-50 px-4 py-3">
        <div class="flex items-center gap-2 text-sm font-medium text-river-800">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span id="resumen-seleccion-texto">Tocá un día para elegir la fecha de entrada</span>
        </div>
        <button type="button" id="btn-limpiar-seleccion" onclick="limpiarSeleccionGeneral()" class="hidden shrink-0 text-xs font-semibold text-river-600 underline underline-offset-2">Limpiar filtro</button>
    </div>

    <div class="mt-6 rounded-2xl border border-ink-100 bg-sand-50 p-4 sm:p-5">
        <h2 class="font-display text-base font-semibold text-ink-900">Reservar para estas fechas</h2>
        <p class="mt-1 text-sm text-ink-500">Completá tus datos para reservar las fechas elegidas arriba.</p>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
            <div>
                <label for="general-nombre" class="mb-1 block text-sm font-medium text-ink-700">Nombre y apellido</label>
                <input id="general-nombre" type="text" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
            <div>
                <label for="general-telefono" class="mb-1 block text-sm font-medium text-ink-700">Teléfono</label>
                <input id="general-telefono" type="tel" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
            <div>
                <label for="general-email" class="mb-1 block text-sm font-medium text-ink-700">Email (opcional)</label>
                <input id="general-email" type="email" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
            <div>
                <label for="general-adultos" class="mb-1 block text-sm font-medium text-ink-700">Adultos</label>
                <input id="general-adultos" type="number" min="1" max="@PoliticaPrecios.MaxPersonasPorReserva" value="2" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
            <div>
                <label for="general-menores" class="mb-1 block text-sm font-medium text-ink-700">Menores</label>
                <input id="general-menores" type="number" min="0" max="@(PoliticaPrecios.MaxPersonasPorReserva - 1)" value="0" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
        </div>
        <p class="mt-2 text-xs text-ink-400">
            Máximo @PoliticaPrecios.MaxPersonasPorReserva personas por reserva (contando a los menores). Si son más de 4 te ofrecemos Maia (hasta 6) o repartirse en dos cabañas; si son más de 6, siempre en dos cabañas.
            Los primeros @Politica.Value.MenoresSinCargo menores no suman al precio; del tercero en adelante cuentan como adultos.
        </p>

        <p id="general-error" class="mt-3 hidden text-sm font-medium text-rose-600"></p>

        <button type="button" onclick="buscarOpcionesGeneral()" class="mt-4 rounded-full bg-river-700 px-6 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">
            Reservar
        </button>
    </div>
</div>

<style>
    @@keyframes promoGlow {
        0%, 100% { box-shadow: 0 0 0 0 rgba(217, 119, 6, 0.35); }
        50% { box-shadow: 0 0 0 5px rgba(217, 119, 6, 0.16); }
    }
    .promo-glow {
        animation: promoGlow 2.4s ease-in-out infinite;
    }
</style>

<div id="modal-opciones" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink-950/60 p-4 backdrop-blur-sm">
    <div class="max-h-[85vh] w-full max-w-lg overflow-y-auto rounded-2.5xl bg-white p-5 shadow-lift sm:p-7">
        <div id="modal-opciones-contenido"></div>
        <button type="button" id="btn-cerrar-modal-opciones" onclick="cerrarModalOpciones()" class="mt-5 text-sm font-medium text-ink-400 transition hover:text-ink-600">Cerrar</button>
    </div>
</div>

@section Scripts {
    <script>
        let __generalDesde = @Html.Raw(ViewBag.SeleccionDesde is string sd ? $"'{sd}'" : "''");
        let __generalHasta = @Html.Raw(ViewBag.SeleccionHasta is string sh ? $"'{sh}'" : "''");
        const __generalError = document.getElementById('general-error');

        function formatearFechaCorta(iso) {
            const [anio, mes, dia] = iso.split('-');
            return `${dia}/${mes}/${anio}`;
        }

        function formatearFechaLarga(iso) {
            const [anio, mes, dia] = iso.split('-').map(Number);
            const fecha = new Date(anio, mes - 1, dia);
            const texto = fecha.toLocaleDateString('es-AR', { weekday: 'short', day: 'numeric', month: 'short' });
            return texto.charAt(0).toUpperCase() + texto.slice(1);
        }

        function limpiarClaseSeleccionCelda(celda) {
            celda.classList.remove('bg-river-700', 'bg-river-300', 'text-white', 'text-river-900', 'rounded-full', 'font-bold', 'ring-4', 'ring-river-200');
            celda.classList.add('rounded-lg');
            (celda.dataset.claseBase || '').split(' ').filter(Boolean).forEach(c => celda.classList.add(c));
        }

        function aplicarClaseSeleccionCelda(celda, tipo) {
            (celda.dataset.claseBase || '').split(' ').filter(Boolean).forEach(c => celda.classList.remove(c));
            celda.classList.remove('rounded-lg');
            if (tipo === 'punta') {
                celda.classList.add('bg-river-700', 'text-white', 'rounded-full', 'font-bold', 'ring-4', 'ring-river-200');
            } else {
                celda.classList.add('bg-river-300', 'text-river-900');
            }
        }

        function actualizarResumenSeleccion() {
            const texto = document.getElementById('resumen-seleccion-texto');
            const btnLimpiar = document.getElementById('btn-limpiar-seleccion');

            if (!__generalDesde) {
                texto.innerHTML = 'Tocá un día en el calendario para elegir la <strong>fecha de entrada</strong>';
                btnLimpiar.classList.add('hidden');
            } else if (!__generalHasta) {
                texto.innerHTML = `Entrada: <strong>${formatearFechaLarga(__generalDesde)}</strong> — ahora tocá el día de <strong>salida</strong>`;
                btnLimpiar.classList.remove('hidden');
            } else {
                const msPorDia = 24 * 60 * 60 * 1000;
                const noches = Math.round((new Date(__generalHasta + 'T00:00:00') - new Date(__generalDesde + 'T00:00:00')) / msPorDia);
                texto.innerHTML = `<strong class="whitespace-nowrap">${formatearFechaLarga(__generalDesde)}</strong> → <strong class="whitespace-nowrap">${formatearFechaLarga(__generalHasta)}</strong> · <span class="whitespace-nowrap">${noches} ${noches === 1 ? 'noche' : 'noches'}</span>`;
                btnLimpiar.classList.remove('hidden');
            }
        }

        function actualizarLinksNavegacionMes() {
            document.querySelectorAll('.nav-mes-link').forEach(function (link) {
                const url = new URL(link.href, window.location.origin);
                if (__generalDesde) url.searchParams.set('desde', __generalDesde); else url.searchParams.delete('desde');
                if (__generalHasta) url.searchParams.set('hasta', __generalHasta); else url.searchParams.delete('hasta');
                link.href = url.toString();
            });
        }

        function actualizarResaltadoGeneral() {
            document.querySelectorAll('#tab-general .day-cell[data-fecha]').forEach(function (celda) {
                const f = celda.dataset.fecha;
                limpiarClaseSeleccionCelda(celda);
                if (__generalDesde && (f === __generalDesde || f === __generalHasta)) {
                    aplicarClaseSeleccionCelda(celda, 'punta');
                } else if (__generalDesde && __generalHasta && f > __generalDesde && f < __generalHasta) {
                    aplicarClaseSeleccionCelda(celda, 'rango');
                }
            });

            actualizarResumenSeleccion();
            actualizarLinksNavegacionMes();
        }

        actualizarResaltadoGeneral();

        function limpiarSeleccionGeneral() {
            __generalDesde = '';
            __generalHasta = '';
            actualizarResaltadoGeneral();
        }

        function seleccionarDiaGeneral(btn) {
            const fecha = btn.dataset.fecha;

            if (!__generalDesde || (__generalDesde && __generalHasta)) {
                __generalDesde = fecha;
                __generalHasta = '';
            } else if (fecha <= __generalDesde) {
                __generalDesde = fecha;
                __generalHasta = '';
            } else {
                __generalHasta = fecha;
            }

            actualizarResaltadoGeneral();
        }

        function mostrarErrorGeneral(mensaje) {
            __generalError.textContent = mensaje;
            __generalError.classList.remove('hidden');
        }

        function abrirModalOpciones() {
            document.getElementById('modal-opciones').classList.remove('hidden');
            document.getElementById('modal-opciones').classList.add('flex');
            document.getElementById('btn-cerrar-modal-opciones').classList.remove('hidden');
        }

        function cerrarModalOpciones() {
            document.getElementById('modal-opciones').classList.add('hidden');
            document.getElementById('modal-opciones').classList.remove('flex');
        }

        const __maxPersonas = @PoliticaPrecios.MaxPersonasPorReserva;
        const __patronTelefono = /^(?=(?:\D*\d){8,15}\D*$)\+?[\d\s\-.()]+$/;
        const __patronEmail = /^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/;
        let __ultimaOpcionesBusqueda = [];
        let __datosHuesped = {};
        let __opcionesSalidaAnticipada = {};

        async function buscarOpcionesGeneral() {
            __generalError.classList.add('hidden');

            const nombre = document.getElementById('general-nombre').value.trim();
            const telefono = document.getElementById('general-telefono').value.trim();
            const email = document.getElementById('general-email').value.trim();
            const adultos = parseInt(document.getElementById('general-adultos').value, 10) || 0;
            const menores = parseInt(document.getElementById('general-menores').value, 10) || 0;

            if (!__generalDesde || !__generalHasta) {
                mostrarErrorGeneral('Elegí la fecha de entrada y de salida en el calendario.');
                return;
            }
            if (!nombre) {
                mostrarErrorGeneral('Ingresá tu nombre.');
                return;
            }
            if (!telefono) {
                mostrarErrorGeneral('Ingresá un teléfono de contacto.');
                return;
            }
            if (!__patronTelefono.test(telefono)) {
                mostrarErrorGeneral('Ingresá un teléfono válido, con al menos 8 números.');
                return;
            }
            if (email && !__patronEmail.test(email)) {
                mostrarErrorGeneral('Ingresá un email válido (ejemplo: nombre@@dominio.com).');
                return;
            }
            if (adultos < 1) {
                mostrarErrorGeneral('Tiene que haber al menos un adulto.');
                return;
            }
            if (adultos + menores > __maxPersonas) {
                mostrarErrorGeneral(`Podemos recibir hasta ${__maxPersonas} personas por reserva (contando a los menores).`);
                return;
            }

            __datosHuesped = { nombre, telefono, email, adultos, menores };

            const contenido = document.getElementById('modal-opciones-contenido');
            contenido.innerHTML = '<p class="text-sm text-ink-500">Buscando disponibilidad...</p>';
            abrirModalOpciones();

            try {
                const resp = await fetch(`/Cabanas/BuscarOpciones?desde=${__generalDesde}&hasta=${__generalHasta}&adultos=${adultos}&menores=${menores}`);
                const data = await resp.json();

                if (!data.valido) {
                    contenido.innerHTML = `<p class="text-sm font-medium text-rose-600">${data.mensaje || 'No pudimos calcular la disponibilidad.'}</p>`;
                    return;
                }

                __ultimaOpcionesBusqueda = data.opciones || [];
                __opcionesSalidaAnticipada = {};
                renderizarOpciones(data);
            } catch (e) {
                contenido.innerHTML = '<p class="text-sm font-medium text-rose-600">Ocurrió un error buscando disponibilidad. Probá de nuevo.</p>';
            }
        }

        function actualizarTotalConSalidaAnticipada(idx, checked) {
            __opcionesSalidaAnticipada[idx] = checked;
            const opcion = __ultimaOpcionesBusqueda[idx];
            if (!opcion || opcion.total === null) return;

            const monto = checked ? (opcion.montoSalidaAnticipada || 0) : 0;
            const nuevoTotal = opcion.total - monto;
            const elTotal = document.querySelector(`[data-total-idx="${idx}"]`);
            if (elTotal) elTotal.textContent = `$${Number(nuevoTotal).toLocaleString('es-AR')}`;

            const elTachado = document.querySelector(`[data-total-tachado-idx="${idx}"]`);
            if (elTachado) {
                if (checked) {
                    elTachado.textContent = `$${Number(opcion.total).toLocaleString('es-AR')}`;
                    elTachado.classList.remove('hidden');
                    elTachado.classList.add('block');
                } else {
                    elTachado.classList.add('hidden');
                    elTachado.classList.remove('block');
                }
            }
        }

        function renderizarOpciones(data) {
            const contenido = document.getElementById('modal-opciones-contenido');

            if (!data.cobreTotal) {
                const dias = (data.diasSinCobertura || []).map(formatearFechaCorta).join(', ');
                contenido.innerHTML =
                    '<h3 class="font-display text-xl font-semibold text-ink-900">No hay disponibilidad completa</h3>' +
                    `<p class="mt-2 text-sm text-ink-600">${data.mensaje || 'No hay ninguna cabaña libre para todo el rango elegido.'}</p>` +
                    (dias ? `<p class="mt-3 rounded-xl bg-rose-50 px-4 py-2.5 text-sm text-rose-700">Sin ninguna cabaña libre: ${dias}</p>` : '');
                return;
            }

            if (!data.opciones || data.opciones.length === 0) {
                contenido.innerHTML = '<p class="text-sm text-ink-600">No encontramos ninguna combinación de cabañas para ese rango.</p>';
                return;
            }

            const personas = __datosHuesped.adultos + __datosHuesped.menores;
            const todasRepartidas = data.opciones.every(o => o.repartida);
            const algunaRepartida = data.opciones.some(o => o.repartida);
            const soloSucesivas = data.opciones.every(o => !o.repartida && o.segmentos.length > 1);
            const hayParesContiguos = data.opciones.some(o => o.repartida && o.contiguas);
            const hayParesSeparados = data.opciones.some(o => o.repartida && !o.contiguas);

            let titulo = 'Opciones disponibles';
            let bajada = '';
            if (todasRepartidas) {
                titulo = 'Tu grupo se aloja en dos cabañas';
                bajada = `Para ${personas} personas hacen falta dos cabañas. Las reservamos juntas, en las mismas fechas.`;
            } else if (algunaRepartida) {
                bajada = `Para ${personas} personas podés reservar una sola cabaña o repartirte en dos, en las mismas fechas.`;
            } else if (soloSucesivas) {
                titulo = 'Estas fechas requieren combinar cabañas';
            }

            let html = `<h3 class="font-display text-xl font-semibold text-ink-900">${titulo}</h3>`;
            if (bajada) {
                html += `<p class="mt-2 text-sm text-ink-600">${bajada}</p>`;
            }
            html += '<div class="mt-4 space-y-3">';

            data.opciones.forEach((opcion, idx) => {
                const totalTexto = opcion.total !== null ? `$${Number(opcion.total).toLocaleString('es-AR')}` : 'A consultar';
                const segmentosHtml = opcion.segmentos.map(s => {
                    const subtotalTexto = s.subtotal !== null ? `$${Number(s.subtotal).toLocaleString('es-AR')}` : 'a consultar';
                    const subtotalHtml = s.subtotalSinPromo
                        ? `<span class="block text-xs text-ink-400 line-through decoration-rose-500">$${Number(s.subtotalSinPromo).toLocaleString('es-AR')}</span><span>${subtotalTexto}</span>`
                        : `<span>${subtotalTexto}</span>`;
                    const promoHtml = s.promoAplicada
                        ? `<div class="mt-0.5 text-xs font-semibold text-amber-700">🎉 ${s.etiquetaPromo || 'Promoción'} aplicada</div>`
                        : (s.etiquetaTarifa ? `<div class="mt-0.5 text-xs text-ink-500">${s.etiquetaTarifa}</div>` : '');
                    const detallePersonas = `${s.personas} ${s.personas === 1 ? 'persona' : 'personas'}` +
                        (s.menores > 0 ? ` (${s.adultos} ${s.adultos === 1 ? 'adulto' : 'adultos'} y ${s.menores} ${s.menores === 1 ? 'menor' : 'menores'})` : '');
                    const titulo = opcion.repartida
                        ? `<strong class="whitespace-nowrap text-ink-900">${s.cabanaNombre}</strong> · ${detallePersonas}`
                        : `<span class="whitespace-nowrap">${formatearFechaCorta(s.desde)} – ${formatearFechaCorta(s.hasta)}</span>: <strong class="whitespace-nowrap text-ink-900">${s.cabanaNombre}</strong>`;
                    return `<div class="flex justify-between gap-3 text-sm text-ink-600">
                        <div class="min-w-0">
                            <span>${titulo}</span>
                            ${promoHtml}
                        </div>
                        <span class="shrink-0 whitespace-nowrap text-right">${subtotalHtml}</span>
                    </div>`;
                }).join('');
                const fechasRepartida = opcion.repartida
                    ? `<div class="mb-2 text-xs font-semibold uppercase tracking-wide text-ink-400"><span class="whitespace-nowrap">${formatearFechaCorta(opcion.segmentos[0].desde)} – ${formatearFechaCorta(opcion.segmentos[0].hasta)}</span> · 2 cabañas</div>`
                    : '';
                let cercania = '';
                if (opcion.repartida && opcion.contiguas) {
                    cercania = hayParesSeparados
                        ? '<div class="mb-2 rounded-lg bg-river-50 px-3 py-1.5 text-xs font-semibold text-river-800">📍 Te conviene: son cabañas contiguas, quedan una al lado de la otra</div>'
                        : '<div class="mb-2 rounded-lg bg-river-50 px-3 py-1.5 text-xs font-semibold text-river-800">📍 Cabañas contiguas: quedan una al lado de la otra</div>';
                } else if (opcion.repartida && hayParesContiguos) {
                    cercania = '<div class="mb-2 rounded-lg bg-ink-50 px-3 py-1.5 text-xs font-medium text-ink-500">Estas cabañas no quedan una al lado de la otra</div>';
                } else if (opcion.repartida) {
                    cercania = '<div class="mb-2 rounded-lg bg-ink-50 px-3 py-1.5 text-xs font-medium text-ink-500">Ojo: estas cabañas no quedan una al lado de la otra</div>';
                }

                const claseCard = opcion.promoAplicada ? 'rounded-xl border-2 border-amber-300 bg-amber-50 p-4' : 'rounded-xl border border-ink-100 p-4';

                const salidaAnticipadaHtml = (opcion.elegibleSalidaAnticipada && opcion.montoSalidaAnticipada > 0 && opcion.total !== null)
                    ? `<label class="mt-2 flex items-start gap-2 rounded-lg bg-amber-50 px-3 py-2 text-xs font-medium text-amber-900">
                        <input type="checkbox" class="mt-0.5 h-4 w-4 rounded border-amber-300 text-amber-700 focus:ring-amber-400"
                               onchange="actualizarTotalConSalidaAnticipada(${idx}, this.checked)" />
                        <span>Salgo el domingo a la noche (ahorrás $${Number(opcion.montoSalidaAnticipada).toLocaleString('es-AR')})</span>
                    </label>`
                    : '';

                html += `<div class="${claseCard}">
                    ${fechasRepartida}
                    ${cercania}
                    <div class="space-y-1.5">${segmentosHtml}</div>
                    <div class="mt-2 flex items-center justify-between border-t border-ink-100 pt-2">
                        <span class="text-sm font-semibold text-ink-900">Total</span>
                        <span class="shrink-0 whitespace-nowrap text-right">
                            ${opcion.totalSinPromo ? `<span class="block text-sm font-semibold text-ink-400 line-through decoration-rose-500">$${Number(opcion.totalSinPromo).toLocaleString('es-AR')}</span>` : ''}
                            <span class="hidden text-sm font-semibold text-ink-400 line-through decoration-rose-500" data-total-tachado-idx="${idx}"></span>
                            <span class="whitespace-nowrap text-lg font-bold text-river-700" data-total-idx="${idx}">${totalTexto}</span>
                        </span>
                    </div>
                    ${opcion.totalSinPromo ? `<div class="mt-1 text-right text-xs font-bold text-amber-700">Ahorrás $${Number(opcion.totalSinPromo - opcion.total).toLocaleString('es-AR')}</div>` : ''}
                    ${salidaAnticipadaHtml}
                    <button type="button" onclick="reservarOpcionGeneral(${idx})"
                            class="mt-3 w-full rounded-full bg-river-700 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">
                        ${opcion.repartida ? 'Reservar en estas dos cabañas' : (opcion.segmentos.length > 1 ? 'Reservar esta combinación' : 'Reservar esta opción')}
                    </button>
                </div>`;
            });

            html += '</div>';
            contenido.innerHTML = html;
        }

        // Si el huésped nos escribe por WhatsApp, ya no hace falta que el admin lo marque a mano.
        async function marcarContactoWhatsApp(ids) {
            ids = (ids || []).filter(id => id);
            if (ids.length === 0) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!token) return;
            const body = new URLSearchParams();
            ids.forEach(id => body.append('ids', id));
            body.set('__RequestVerificationToken', token.value);
            try {
                await fetch('/Cabanas/MarcarContactoWhatsApp', { method: 'POST', body });
            } catch {
                // Si falla, no pasa nada grave: el admin igual lo puede tildar a mano.
            }
        }

        async function reservarOpcionGeneral(idx) {
            const opcion = __ultimaOpcionesBusqueda[idx];
            if (!opcion) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const params = new URLSearchParams();
            params.append('__RequestVerificationToken', token);
            params.append('NombreHuesped', __datosHuesped.nombre);
            params.append('Telefono', __datosHuesped.telefono);
            params.append('Email', __datosHuesped.email);
            params.append('CantidadAdultos', __datosHuesped.adultos);
            params.append('CantidadMenores', __datosHuesped.menores);
            params.append('SalidaAnticipada', __opcionesSalidaAnticipada[idx] ? 'true' : 'false');
            opcion.segmentos.forEach((s, i) => {
                params.append(`Segmentos[${i}].CabanaId`, s.cabanaId);
                params.append(`Segmentos[${i}].FechaDesde`, s.desde);
                params.append(`Segmentos[${i}].FechaHasta`, s.hasta);
                params.append(`Segmentos[${i}].Adultos`, s.adultos);
                params.append(`Segmentos[${i}].Menores`, s.menores);
            });

            const contenido = document.getElementById('modal-opciones-contenido');
            contenido.innerHTML = '<p class="text-sm text-ink-500">Enviando tu solicitud...</p>';

            try {
                const resp = await fetch('/Cabanas/SolicitarOpcion', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: params.toString()
                });
                const data = await resp.json();

                if (!data.exito) {
                    contenido.innerHTML = `<p class="text-sm font-medium text-rose-600">${data.mensaje || 'No pudimos completar la solicitud.'}</p>
                        <button type="button" onclick="buscarOpcionesGeneral()" class="mt-4 rounded-full bg-river-700 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:bg-river-800">Volver a buscar</button>`;
                    return;
                }

                mostrarExitoGeneral(data);
            } catch (e) {
                contenido.innerHTML = '<p class="text-sm font-medium text-rose-600">Ocurrió un error enviando la solicitud. Probá de nuevo.</p>';
            }
        }

        function mostrarExitoGeneral(data) {
            const contenido = document.getElementById('modal-opciones-contenido');
            const btnCerrar = document.getElementById('btn-cerrar-modal-opciones');
            const totalTexto = data.total !== null ? `$${Number(data.total).toLocaleString('es-AR')}` : 'a consultar';
            const cabanasTexto = data.cabanas.join(' y ');
            const personasTexto = `${data.cantidadPersonas} ${data.cantidadPersonas === 1 ? 'persona' : 'personas'}`;

            const mensajeWhatsApp = encodeURIComponent(
                `Hola! Soy ${data.nombreHuesped}. Quiero coordinar mi solicitud de reserva en ${cabanasTexto} ` +
                `del ${data.desde} al ${data.hasta} para ${data.cantidadPersonas} personas. Valor total aproximado: ${totalTexto}.` +
                (data.salidaAnticipada ? ' Salgo el domingo a la noche.' : '')
            );

            const notaFinal = data.tieneEmail
                ? 'Te enviamos el resumen por mail.'
                : 'Escribinos ahora para no perder los datos de tu solicitud.';

            const filaTotal = data.total !== null
                ? `<p class="mt-0.5">Total aprox. <span class="font-semibold text-ink-900">${totalTexto}</span></p>`
                : '';

            const filaSalidaAnticipada = data.salidaAnticipada
                ? '<p class="mt-0.5 font-medium text-amber-700">Salís el domingo a la noche</p>'
                : '';

            const botonCerrar = data.tieneEmail
                ? `<button type="button" onclick="cerrarModalOpciones()" class="mt-2 text-sm font-medium text-ink-400 transition hover:text-ink-600">Cerrar</button>`
                : '';

            btnCerrar.classList.add('hidden');

            contenido.innerHTML = `
                <div class="text-center">
                    <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-river-100 text-river-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <h3 class="font-display text-xl font-semibold text-ink-900">¡Solicitud enviada!</h3>

                    <div class="mt-4 rounded-xl bg-sand-50 px-4 py-3 text-sm text-ink-600">
                        <p class="font-semibold text-ink-900">${cabanasTexto}</p>
                        <p class="mt-0.5"><span class="whitespace-nowrap">${data.desde} – ${data.hasta}</span> · <span class="whitespace-nowrap">${personasTexto}</span></p>
                        ${filaTotal}
                        ${filaSalidaAnticipada}
                    </div>

                    <div class="mt-3 flex items-start gap-3 rounded-xl bg-amber-50 p-4 text-left text-sm text-amber-900">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <div>
                            <p class="font-semibold">Tu reserva todavía no está confirmada</p>
                            <p class="mt-0.5 text-amber-800">Tenés 24 hs para escribirnos por WhatsApp y coordinar el pago. Pasado ese plazo, la solicitud se da de baja.</p>
                        </div>
                    </div>

                    <a href="https://wa.me/5491156293054?text=${mensajeWhatsApp}" target="_blank" rel="noopener"
                       onclick="marcarContactoWhatsApp(${JSON.stringify(data.reservaIds || [])}); cerrarModalOpciones()"
                       class="mt-4 flex items-center justify-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:shadow-lift">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
                            <path d="M12.004 2C6.478 2 2.003 6.475 2.003 12c0 1.85.499 3.583 1.368 5.076L2 22l5.06-1.327A9.953 9.953 0 0012.004 22C17.53 22 22 17.525 22 12S17.53 2 12.004 2zm0 18.062a8.038 8.038 0 01-4.099-1.12l-.294-.175-3.005.788.803-2.93-.192-.302a8.03 8.03 0 01-1.24-4.323c0-4.44 3.613-8.052 8.031-8.052 4.417 0 8.03 3.612 8.03 8.052 0 4.44-3.613 8.062-8.034 8.062z" />
                        </svg>
                        <span>Escribinos por WhatsApp al <span class="whitespace-nowrap">11 5629-3054</span></span>
                    </a>
                    <p class="mt-3 text-xs text-ink-400">${notaFinal}</p>
                    ${botonCerrar}
                </div>`;
        }
    </script>
}
