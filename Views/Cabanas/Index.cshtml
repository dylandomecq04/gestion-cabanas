@model List<Cabana>
@{
    ViewData["Title"] = "Nuestras cabañas";
}

<div class="mb-8">
    <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Nuestras cabañas</h2>
    <p class="mt-1 text-ink-500">Elegí la que mejor se adapte a tu grupo.</p>
</div>

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var cabana in Model)
    {
        var portada = cabana.Fotos.OrderBy(f => f.Orden).FirstOrDefault();
        <a asp-controller="Cabanas" asp-action="Details" asp-route-id="@cabana.Id"
           class="group flex flex-col overflow-hidden rounded-2.5xl bg-white shadow-soft ring-1 ring-ink-100 transition duration-300 hover:-translate-y-1 hover:shadow-lift">
            <div class="relative h-52 w-full overflow-hidden bg-sand-100">
                @if (portada != null)
                {
                    <img src="@portada.RutaArchivo" alt="@cabana.Nombre"
                         class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                }
                else
                {
                    <div class="flex h-full w-full items-center justify-center text-4xl">🏡</div>
                }
                @if (cabana.PrecioPorNoche.HasValue)
                {
                    <span class="absolute right-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-river-800 shadow-soft backdrop-blur">
                        Desde $@cabana.PrecioPorNoche.Value.ToString("N0") / noche
                    </span>
                }
            </div>
            <div class="flex flex-1 flex-col gap-2 p-5">
                <h3 class="font-display text-lg font-semibold text-ink-900">@cabana.Nombre</h3>
                <p class="flex items-center gap-1.5 text-sm text-ink-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m5-4.13a4 4 0 100-8 4 4 0 000 8zm6 4a4 4 0 00-3-3.87" />
                    </svg>
                    Hasta @cabana.Capacidad personas
                </p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-river-700 transition group-hover:gap-2">
                    Ver disponibilidad y reservar
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                </span>
            </div>
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="rounded-2.5xl border border-dashed border-ink-200 bg-white/60 py-16 text-center text-ink-500">
        Todavía no hay cabañas cargadas.
    </div>
}
