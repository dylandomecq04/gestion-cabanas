@{
    Layout = null;
    var token = (string)ViewBag.Token;
    var cabanas = (List<Cabana>)ViewBag.Cabanas;
    var salidas = (List<Reserva>)ViewBag.Salidas;
    DateTime dia = ViewBag.Dia;
    var hoy = DateTime.Today;

    // Sólo interesan las cabañas donde se va gente ese día, en el orden habitual de las cabañas.
    var recambios = cabanas
        .Select(c => (Cabana: c, Sale: salidas.FirstOrDefault(r => r.CabanaId == c.Id)))
        .Where(x => x.Sale is not null)
        .ToList();

    string Capitalizar(string texto) => char.ToUpper(texto[0]) + texto.Substring(1);
    string Iso(DateTime d) => d.ToString("yyyy-MM-dd");

    var diaSemana = Capitalizar(dia.ToString("dddd"));
    var mesAnio = Capitalizar(dia.ToString("MMMM yyyy"));
    var etiquetaRelativa = (dia - hoy).Days switch
    {
        -1 => "Ayer",
        0 => "Hoy",
        1 => "Mañana",
        _ => null
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recambios · Cabañas Sidharta</title>
    <partial name="_TailwindConfig" />
</head>
<body class="bg-sand-50 text-ink-900 antialiased">
    <header class="border-b border-ink-100 bg-white px-4 py-4 sm:px-6">
        <div class="mx-auto flex max-w-md items-center gap-2">
            <img src="~/images/logo-sidharta.png" alt="Cabañas Sidharta" class="h-9 w-9 rounded-xl shadow-soft" />
            <span class="font-display text-base font-semibold text-river-800 sm:text-lg">Cabañas Sidharta · Recambios</span>
        </div>
    </header>

    <main class="mx-auto max-w-md px-4 py-6">
        <div class="flex items-center justify-between gap-2">
            <a class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700"
               asp-controller="Recambios" asp-action="Index" asp-route-token="@token" asp-route-fecha="@Iso(dia.AddDays(-1))">&larr; <span class="hidden sm:inline">Día </span>anterior</a>
            @if (dia != hoy)
            {
                <a class="rounded-full bg-river-700 px-4 py-2 text-sm font-semibold text-white shadow-soft transition hover:bg-river-800"
                   asp-controller="Recambios" asp-action="Index" asp-route-token="@token">Hoy</a>
            }
            <a class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700"
               asp-controller="Recambios" asp-action="Index" asp-route-token="@token" asp-route-fecha="@Iso(dia.AddDays(1))"><span class="hidden sm:inline">Día </span>siguiente &rarr;</a>
        </div>

        <section class="mt-5 overflow-hidden rounded-2.5xl bg-white shadow-soft ring-1 ring-ink-100">
            <div class="@(dia == hoy ? "bg-river-600 text-white" : "bg-sand-100 text-ink-800") px-6 py-5 text-center">
                <div class="text-xs font-semibold uppercase tracking-wide opacity-80">@diaSemana@(etiquetaRelativa is not null ? " · " + etiquetaRelativa : "")</div>
                <div class="font-display text-6xl font-bold leading-none">@dia.Day</div>
                <div class="mt-1 text-sm font-medium opacity-80">@mesAnio</div>
            </div>

            <div class="p-4">
                @if (recambios.Count == 0)
                {
                    <p class="py-6 text-center text-sm text-ink-400">No hay recambios este día.</p>
                }
                else
                {
                    <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-400">
                        @(recambios.Count == 1 ? "1 recambio" : recambios.Count + " recambios")
                    </p>
                    <ul class="space-y-2">
                        @foreach (var (cabana, sale) in recambios)
                        {
                            <li>
                                <a asp-controller="Recambios" asp-action="Cabana" asp-route-token="@token" asp-route-id="@cabana.Id"
                                   asp-route-anio="@dia.Year" asp-route-mes="@dia.Month"
                                   class="flex items-center justify-between gap-3 rounded-xl bg-sky-100 px-4 py-3 transition hover:bg-sky-200">
                                    <span class="text-base font-semibold text-ink-900">@cabana.Nombre</span>
                                    <span class="truncate text-sm text-rose-700" title="Sale: @sale!.NombreHuesped">↓ @sale.NombreHuesped</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>

        <section class="mt-6">
            <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-ink-400">Ver una cabaña</h2>
            <div class="flex flex-wrap gap-2">
                @foreach (var cabana in cabanas)
                {
                    <a asp-controller="Recambios" asp-action="Cabana" asp-route-token="@token" asp-route-id="@cabana.Id"
                       asp-route-anio="@dia.Year" asp-route-mes="@dia.Month"
                       class="inline-flex items-center rounded-full bg-sand-100 px-3 py-1.5 text-sm font-semibold text-ink-800 ring-1 ring-sand-200 transition hover:bg-sand-200">@cabana.Nombre</a>
                }
            </div>
        </section>
    </main>
</body>
</html>
