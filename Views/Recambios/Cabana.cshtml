@{
    Layout = null;
    var token = (string)ViewBag.Token;
    var cabanas = (List<Cabana>)ViewBag.Cabanas;
    var cabana = (Cabana)ViewBag.Cabana;
    var reservas = (List<Reserva>)ViewBag.Reservas;
    DateTime primerDia = ViewBag.PrimerDia;
    DateTime ultimoDia = ViewBag.UltimoDia;
    DateTime mesAnterior = ViewBag.MesAnterior;
    DateTime mesSiguiente = ViewBag.MesSiguiente;
    var hoy = DateTime.Today;

    string[] diasSemana = { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" };
    int IndiceDiaSemana(DateTime d) => ((int)d.DayOfWeek + 6) % 7;

    // Grilla de semanas (lunes a domingo) con celdas vacías antes del 1 y después del último día.
    var celdas = new List<DateTime?>();
    for (var i = 0; i < IndiceDiaSemana(primerDia); i++) celdas.Add(null);
    for (var d = primerDia; d <= ultimoDia; d = d.AddDays(1)) celdas.Add(d);
    while (celdas.Count % 7 != 0) celdas.Add(null);

    Reserva? ReservaQueLlegaEseDia(DateTime d) => reservas.FirstOrDefault(r => r.FechaDesde.Date == d.Date);
    Reserva? ReservaQueSaleEseDia(DateTime d) => reservas.FirstOrDefault(r => r.FechaHasta.Date == d.Date);
    bool HayHuespedEsaNoche(DateTime d) => reservas.Any(r => r.FechaDesde.Date <= d.Date && d.Date < r.FechaHasta.Date);

    var mesTitulo = primerDia.ToString("MMMM yyyy");
    mesTitulo = char.ToUpper(mesTitulo[0]) + mesTitulo.Substring(1);

    string PrimerNombre(string nombreCompleto) => nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? nombreCompleto;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@cabana.Nombre · Recambios · Cabañas Sidharta</title>
    <partial name="_TailwindConfig" />
</head>
<body class="bg-sand-50 text-ink-900 antialiased">
    <header class="border-b border-ink-100 bg-white px-4 py-4 sm:px-6">
        <div class="mx-auto flex max-w-3xl items-center gap-2">
            <img src="~/images/logo-sidharta.png" alt="Cabañas Sidharta" class="h-9 w-9 rounded-xl shadow-soft" />
            <span class="font-display text-base font-semibold text-river-800 sm:text-lg">Cabañas Sidharta · Recambios</span>
        </div>
    </header>

    <main class="mx-auto max-w-3xl px-3 py-6 sm:px-6">
        <a class="inline-flex items-center gap-1 text-sm font-medium text-ink-500 transition hover:text-river-700"
           asp-controller="Recambios" asp-action="Index" asp-route-token="@token">&larr; Volver a los recambios del día</a>

        <div class="scroll-fino mt-3 flex gap-2 overflow-x-auto pb-1">
            @foreach (var c in cabanas)
            {
                var activa = c.Id == cabana.Id;
                <a asp-controller="Recambios" asp-action="Cabana" asp-route-token="@token" asp-route-id="@c.Id"
                   asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month"
                   class="shrink-0 rounded-full px-3 py-1.5 text-sm font-semibold ring-1 transition @(activa ? "bg-river-700 text-white ring-river-700" : "bg-sand-100 text-ink-800 ring-sand-200 hover:bg-sand-200")">@c.Nombre</a>
            }
        </div>

        <div class="mb-3 mt-4 flex flex-wrap items-center justify-between gap-2">
            <h1 class="font-display text-lg font-semibold text-ink-900 sm:text-2xl">@cabana.Nombre &middot; @mesTitulo</h1>
            <div class="flex gap-2">
                <a class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700 sm:px-4 sm:py-2 sm:text-sm"
                   asp-controller="Recambios" asp-action="Cabana" asp-route-token="@token" asp-route-id="@cabana.Id" asp-route-anio="@mesAnterior.Year" asp-route-mes="@mesAnterior.Month">&larr; <span class="hidden sm:inline">Mes </span>anterior</a>
                <a class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700 sm:px-4 sm:py-2 sm:text-sm"
                   asp-controller="Recambios" asp-action="Cabana" asp-route-token="@token" asp-route-id="@cabana.Id" asp-route-anio="@mesSiguiente.Year" asp-route-mes="@mesSiguiente.Month"><span class="hidden sm:inline">Mes </span>siguiente &rarr;</a>
            </div>
        </div>

        <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-medium text-ink-500">
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-green-200"></span> Hay huésped</span>
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-sky-200"></span> Sale (hay que limpiar)</span>
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-amber-300"></span> Sale y entra otro</span>
            <span class="flex items-center gap-1.5"><span class="font-bold text-river-700">↑</span> Entra</span>
            <span class="flex items-center gap-1.5"><span class="font-bold text-rose-600">↓</span> Sale</span>
        </div>

        <div class="rounded-2.5xl bg-white p-2 shadow-soft ring-1 ring-ink-100 sm:p-3">
            <div class="grid grid-cols-7 gap-1 sm:gap-1.5">
                @foreach (var nombreDia in diasSemana)
                {
                    <div class="py-1 text-center text-[10px] font-semibold uppercase text-ink-400 sm:text-xs">@nombreDia</div>
                }
                @foreach (var d in celdas)
                {
                    if (d is null)
                    {
                        <div></div>
                        continue;
                    }
                    var dia = d.Value;
                    var llega = ReservaQueLlegaEseDia(dia);
                    var sale = ReservaQueSaleEseDia(dia);
                    var clase = llega is not null && sale is not null
                        ? "bg-amber-200"
                        : sale is not null
                            ? "bg-sky-100"
                            : HayHuespedEsaNoche(dia)
                                ? "bg-green-100"
                                : "bg-sand-50";
                    var anillo = dia.Date == hoy ? "ring-2 ring-river-600" : "";
                    <div class="flex min-h-[64px] flex-col gap-0.5 rounded-lg p-1 sm:min-h-[84px] sm:p-1.5 @clase @anillo">
                        <div class="text-[11px] font-bold @(dia.Date == hoy ? "text-river-700" : "text-ink-500") sm:text-sm">@dia.Day</div>
                        @if (sale is not null)
                        {
                            <div class="truncate text-[9px] font-semibold leading-tight text-rose-700 sm:text-[11px]" title="Sale: @sale.NombreHuesped">↓ @PrimerNombre(sale.NombreHuesped)</div>
                        }
                        @if (llega is not null)
                        {
                            <div class="truncate text-[9px] font-semibold leading-tight text-river-700 sm:text-[11px]" title="Entra: @llega.NombreHuesped">↑ @PrimerNombre(llega.NombreHuesped)</div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (reservas.Count > 0)
        {
            <section class="mt-5">
                <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-ink-400">Huéspedes del mes</h2>
                <ul class="divide-y divide-ink-100 rounded-2.5xl bg-white shadow-soft ring-1 ring-ink-100">
                    @foreach (var r in reservas.OrderBy(r => r.FechaDesde))
                    {
                        <li class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm">
                            <span class="truncate font-semibold text-ink-800">@r.NombreHuesped</span>
                            <span class="shrink-0 text-xs text-ink-500"><span class="font-bold text-river-700">↑</span> @r.FechaDesde.ToString("d/M") &middot; <span class="font-bold text-rose-600">↓</span> @r.FechaHasta.ToString("d/M")</span>
                        </li>
                    }
                </ul>
            </section>
        }
    </main>

    <style>
        .scroll-fino::-webkit-scrollbar { height: 8px; }
        .scroll-fino::-webkit-scrollbar-track { background: transparent; }
        .scroll-fino::-webkit-scrollbar-thumb { background-color: #d8d2c4; border-radius: 999px; }
        .scroll-fino { scrollbar-width: thin; scrollbar-color: #d8d2c4 transparent; }
    </style>
</body>
</html>
