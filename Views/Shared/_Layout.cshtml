<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cabañas Sidharta</title>
    <partial name="_TailwindConfig" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-sand-50 text-ink-900 antialiased">
    <header class="sticky top-0 z-40 border-b border-ink-100 bg-sand-50/80 backdrop-blur-md">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-2 font-display text-lg font-semibold text-river-800">
                <img src="~/images/logo-sidharta.png" alt="Cabañas Sidharta" class="h-10 w-10 rounded-xl shadow-soft" />
                Cabañas Sidharta
            </a>

            <nav class="hidden items-center gap-1 sm:flex">
                <a asp-area="" asp-controller="Home" asp-action="Index"
                   class="rounded-full px-4 py-2 text-sm font-medium text-ink-600 transition hover:bg-river-50 hover:text-river-800">Cabañas</a>
                <a asp-area="" asp-controller="Cabanas" asp-action="Disponibilidad"
                   class="rounded-full px-4 py-2 text-sm font-medium text-ink-600 transition hover:bg-river-50 hover:text-river-800">Disponibilidad</a>
                <a asp-area="Admin" asp-controller="Reservas" asp-action="Index"
                   class="ml-2 rounded-full border border-ink-200 px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-river-300 hover:text-river-800">Panel de administración</a>
                <a href="https://www.instagram.com/cabaniasidharta/" target="_blank" rel="noopener" aria-label="Instagram"
                   class="ml-1 flex h-9 w-9 items-center justify-center rounded-full text-ink-500 transition hover:bg-river-50 hover:text-river-800">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
                    </svg>
                </a>
            </nav>

            <button type="button" onclick="document.getElementById('menu-movil').classList.toggle('hidden')"
                    class="flex h-10 w-10 items-center justify-center rounded-full border border-ink-200 text-ink-700 sm:hidden" aria-label="Abrir menú">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>

        <div id="menu-movil" class="hidden border-t border-ink-100 bg-sand-50 px-4 py-3 sm:hidden">
            <div class="flex flex-col gap-1">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="rounded-xl px-3 py-2 text-sm font-medium text-ink-700 hover:bg-river-50">Cabañas</a>
                <a asp-area="" asp-controller="Cabanas" asp-action="Disponibilidad" class="rounded-xl px-3 py-2 text-sm font-medium text-ink-700 hover:bg-river-50">Disponibilidad</a>
                <a asp-area="Admin" asp-controller="Reservas" asp-action="Index" class="rounded-xl px-3 py-2 text-sm font-medium text-ink-700 hover:bg-river-50">Panel de administración</a>
                <a href="https://www.instagram.com/cabaniasidharta/" target="_blank" rel="noopener" class="rounded-xl px-3 py-2 text-sm font-medium text-ink-700 hover:bg-river-50">Instagram @@cabaniasidharta</a>
            </div>
        </div>
    </header>

    <main class="mx-auto min-h-[60vh] max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
        @RenderBody()
    </main>

    <footer class="mt-16 border-t border-ink-100 bg-white/60">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-ink-500 sm:px-6">
            <p>&copy; @DateTime.Now.Year Cabañas Sidharta &middot; El Tigre, Delta del Paraná.</p>
            <div class="flex items-center gap-3">
                <a href="https://www.instagram.com/cabaniasidharta/" target="_blank" rel="noopener" aria-label="Instagram"
                   class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-500 transition hover:border-river-300 hover:text-river-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
                    </svg>
                </a>
                <a href="https://wa.me/5491156293054?text=Hola!%20Quer%C3%ADa%20consultar%20por%20las%20caba%C3%B1as"
                   target="_blank" rel="noopener" aria-label="WhatsApp"
                   class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-500 transition hover:border-river-300 hover:text-river-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
                        <path d="M12.004 2C6.478 2 2.003 6.475 2.003 12c0 1.85.499 3.583 1.368 5.076L2 22l5.06-1.327A9.953 9.953 0 0012.004 22C17.53 22 22 17.525 22 12S17.53 2 12.004 2zm0 18.062a8.038 8.038 0 01-4.099-1.12l-.294-.175-3.005.788.803-2.93-.192-.302a8.03 8.03 0 01-1.24-4.323c0-4.44 3.613-8.052 8.031-8.052 4.417 0 8.03 3.612 8.03 8.052 0 4.44-3.613 8.062-8.034 8.062z" />
                    </svg>
                </a>
            </div>
        </div>
    </footer>

    <a href="https://wa.me/5491156293054?text=Hola!%20Quer%C3%ADa%20consultar%20por%20las%20caba%C3%B1as"
       target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp"
       class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lift transition hover:scale-105">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
            <path d="M12.004 2C6.478 2 2.003 6.475 2.003 12c0 1.85.499 3.583 1.368 5.076L2 22l5.06-1.327A9.953 9.953 0 0012.004 22C17.53 22 22 17.525 22 12S17.53 2 12.004 2zm0 18.062a8.038 8.038 0 01-4.099-1.12l-.294-.175-3.005.788.803-2.93-.192-.302a8.03 8.03 0 01-1.24-4.323c0-4.44 3.613-8.052 8.031-8.052 4.417 0 8.03 3.612 8.03 8.052 0 4.44-3.613 8.062-8.034 8.062z" />
        </svg>
    </a>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
