@model GestionCabanas.Models.PromoEstadia

<div class="promo-card flex flex-1 flex-col items-center gap-3 px-6 py-5 text-center sm:flex-row sm:justify-between sm:gap-6 sm:text-left">
    <div class="flex flex-col items-center gap-1.5 sm:flex-row sm:items-center sm:gap-4">
        <span class="promo-badge inline-block shrink-0 rounded-full bg-sand-300 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wide text-river-900">
            OFERTA
        </span>
        <div>
            <h3 class="font-display text-base font-bold leading-tight sm:text-lg">@(string.IsNullOrWhiteSpace(Model.Nombre) ? "Promoción especial" : Model.Nombre)</h3>
            @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
            {
                <p class="mt-0.5 text-sm text-white/85">@Model.Descripcion</p>
            }
        </div>
    </div>
    <a href="https://wa.me/5491156293054?text=Hola!%20Quer%C3%ADa%20consultar%20por%20la%20promoci%C3%B3n"
       target="_blank" rel="noopener"
       class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-river-800 shadow-soft transition hover:-translate-y-0.5">
        Consultar
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
    </a>
</div>
