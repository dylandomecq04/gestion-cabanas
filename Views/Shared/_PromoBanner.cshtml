@model GestionCabanas.Models.Promocion

<div class="rounded-2.5xl bg-gradient-to-br from-amber-400 via-orange-500 to-rose-500 p-5 text-white shadow-lift">
    @if (!string.IsNullOrWhiteSpace(Model.Etiqueta))
    {
        <span class="inline-block rounded-full bg-white/25 px-3 py-1 text-xs font-bold uppercase tracking-wide backdrop-blur">
            @Model.Etiqueta
        </span>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Titulo))
    {
        <h3 class="mt-3 font-display text-lg font-bold leading-tight">@Model.Titulo</h3>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
    {
        <p class="mt-2 text-sm text-white/90">@Model.Descripcion</p>
    }
    <a href="https://wa.me/5491156293054?text=Hola!%20Quer%C3%ADa%20consultar%20por%20la%20promoci%C3%B3n"
       target="_blank" rel="noopener"
       class="mt-4 inline-flex items-center gap-1 rounded-full bg-white px-4 py-2 text-xs font-semibold text-rose-600 shadow-soft transition hover:-translate-y-0.5">
        Consultar
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
    </a>
</div>
