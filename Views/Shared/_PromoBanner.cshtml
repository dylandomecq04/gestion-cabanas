@model GestionCabanas.Models.PromoEstadia

<a asp-area="" asp-controller="Cabanas" asp-action="Disponibilidad"
   class="promo-card group flex flex-1 items-center gap-3 px-4 py-2.5 transition hover:bg-white/5">
    <span class="promo-badge inline-flex shrink-0 items-center rounded-full bg-sand-300 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-river-900">
        Promo
    </span>
    <span class="min-w-0 flex-1">
        <span class="block truncate font-display text-sm font-bold leading-tight">@(string.IsNullOrWhiteSpace(Model.Nombre) ? "Promoción especial" : Model.Nombre)</span>
        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
        {
            <span class="block truncate text-xs text-white/75">@Model.Descripcion</span>
        }
    </span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-white/70 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
    </svg>
</a>
