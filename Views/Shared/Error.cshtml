@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="mx-auto max-w-xl rounded-2.5xl bg-white p-8 text-center shadow-soft ring-1 ring-ink-100">
    <span class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-rose-100 text-2xl">⚠️</span>
    <h1 class="font-display text-2xl font-semibold text-ink-900">Ocurrió un error</h1>
    <p class="mt-2 text-ink-500">No pudimos procesar tu solicitud. Volvé a intentarlo en unos minutos.</p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-4 text-xs text-ink-400">ID de solicitud: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="mt-6 inline-block rounded-full bg-river-700 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">Volver al inicio</a>
</div>
