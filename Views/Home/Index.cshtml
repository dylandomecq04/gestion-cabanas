@model List<Cabana>
@{
    ViewData["Title"] = "Cabañas Sidharta";
    var promoIzquierda = ViewBag.PromoIzquierda as Promocion;
    var promoDerecha = ViewBag.PromoDerecha as Promocion;
    var hayPromoActiva = promoIzquierda?.Activa == true || promoDerecha?.Activa == true;

    // Fotos de ejemplo para el fondo del hero (temporal, se pueden reemplazar por las reales).
    var heroFotos = new[] { "foto_2.jpg", "foto_3.jpg", "foto_4.jpg", "foto_5.jpg", "foto_6.jpg", "foto_7.jpg", "foto_8.jpg" };
}

@if (hayPromoActiva)
{
    <div class="mb-6 overflow-hidden rounded-2.5xl bg-gradient-to-r from-river-600 via-river-700 to-river-800 text-white shadow-lift">
        <div class="flex flex-col divide-y divide-white/15 sm:flex-row sm:divide-x sm:divide-y-0">
            @if (promoIzquierda?.Activa == true)
            {
                <partial name="_PromoBanner" model="promoIzquierda" />
            }
            @if (promoDerecha?.Activa == true)
            {
                <partial name="_PromoBanner" model="promoDerecha" />
            }
        </div>
    </div>
}

<section class="group relative -mx-4 mb-14 flex min-h-screen items-center overflow-hidden rounded-3xl bg-river-800 text-center text-white shadow-lift sm:-mx-6">
    <div class="absolute inset-0 bg-gradient-to-br from-river-700 via-river-600 to-river-800"></div>
    @for (int i = 0; i < heroFotos.Length; i++)
    {
        <img src="~/images/hero/@heroFotos[i]" alt=""
             class="hero-fondo-img absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ease-in-out @(i == 0 ? "opacity-100" : "opacity-0")" />
    }
    <div class="absolute inset-0 bg-gradient-to-b from-river-950/75 via-river-900/55 to-river-950/80"></div>
    <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-river-400/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-16 h-72 w-72 rounded-full bg-sand-300/15 blur-3xl"></div>

    <button type="button" onclick="moverFondoHeroManual(-1)" aria-label="Foto anterior"
            class="absolute left-4 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/30 bg-white/10 text-white opacity-0 backdrop-blur transition hover:bg-white/25 group-hover:opacity-100 sm:left-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <button type="button" onclick="moverFondoHeroManual(1)" aria-label="Foto siguiente"
            class="absolute right-4 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/30 bg-white/10 text-white opacity-0 backdrop-blur transition hover:bg-white/25 group-hover:opacity-100 sm:right-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
    </button>

    <div class="relative mx-auto max-w-2xl px-6 py-16 sm:px-10">
        <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-river-100">Cabañas Sidharta &middot; El Tigre, Delta del Paraná</p>
        <h1 class="font-display text-4xl font-semibold sm:text-5xl md:text-6xl">Tu escapada frente al río</h1>
        <p class="mx-auto mt-4 max-w-xl text-base text-river-50/90 sm:text-lg">
            5 cabañas de madera a metros del agua, listas para desconectar en familia o con amigos.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a href="#cabanas" class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-river-800 shadow-soft transition hover:-translate-y-0.5 hover:shadow-lift">Ver cabañas</a>
            <a asp-controller="Cabanas" asp-action="Disponibilidad" class="rounded-full border border-white/40 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">Ver disponibilidad</a>
        </div>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-medium tracking-wide text-river-100/80">
            <span class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                A metros del agua
            </span>
            <span class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                5 cabañas de madera
            </span>
            <span class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Ideal en familia o con amigos
            </span>
        </div>
    </div>
</section>

<div id="cabanas" class="mb-8 flex scroll-mt-24 items-end justify-between">
    <div>
        <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Nuestras cabañas</h2>
        <p class="mt-1 text-ink-500">Elegí la que mejor se adapte a tu grupo.</p>
    </div>
</div>

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var cabana in Model)
    {
        var portada = cabana.Fotos.OrderBy(f => f.Orden).FirstOrDefault();
        <a asp-controller="Cabanas" asp-action="Details" asp-route-id="@cabana.Id"
           class="group flex flex-col overflow-hidden rounded-2.5xl bg-white shadow-soft ring-1 ring-ink-100 transition duration-300 hover:-translate-y-1 hover:shadow-lift">
            <div class="relative h-52 w-full overflow-hidden bg-sand-100">
                @if (portada != null)
                {
                    <img src="~/@portada.RutaArchivo" alt="@cabana.Nombre"
                         class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                }
                else
                {
                    <div class="flex h-full w-full items-center justify-center text-4xl">🏡</div>
                }
                @if (cabana.PrecioPorNoche.HasValue)
                {
                    <span class="absolute right-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-river-800 shadow-soft backdrop-blur">
                        Desde $@cabana.PrecioPorNoche.Value.ToString("N0") / noche
                    </span>
                }
            </div>
            <div class="flex flex-1 flex-col gap-2 p-5">
                <h3 class="font-display text-lg font-semibold text-ink-900">@cabana.Nombre</h3>
                <p class="flex items-center gap-1.5 text-sm text-ink-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m5-4.13a4 4 0 100-8 4 4 0 000 8zm6 4a4 4 0 00-3-3.87" />
                    </svg>
                    Hasta @cabana.Capacidad personas
                </p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-river-700 transition group-hover:gap-2">
                    Ver disponibilidad y reservar
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                </span>
            </div>
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="rounded-2.5xl border border-dashed border-ink-200 bg-white/60 py-16 text-center text-ink-500">
        Todavía no hay cabañas cargadas.
    </div>
}

@section Scripts {
    <script>
        let __heroFondoIndex = 0;
        let __heroFondoTimer = null;

        function moverFondoHero(delta) {
            const imgs = document.querySelectorAll('.hero-fondo-img');
            if (imgs.length < 2) return;
            imgs[__heroFondoIndex].classList.remove('opacity-100');
            imgs[__heroFondoIndex].classList.add('opacity-0');
            __heroFondoIndex = ((__heroFondoIndex + delta) % imgs.length + imgs.length) % imgs.length;
            imgs[__heroFondoIndex].classList.remove('opacity-0');
            imgs[__heroFondoIndex].classList.add('opacity-100');
        }

        function iniciarAutoAvanceHero() {
            if (__heroFondoTimer) clearInterval(__heroFondoTimer);
            __heroFondoTimer = setInterval(() => moverFondoHero(1), 4000);
        }

        function moverFondoHeroManual(delta) {
            moverFondoHero(delta);
            iniciarAutoAvanceHero();
        }

        iniciarAutoAvanceHero();

        const irACabanas = function () {
            const destino = document.getElementById('cabanas');
            if (destino) destino.scrollIntoView({ behavior: 'instant', block: 'start' });
        };
        if (location.hash === '#cabanas') {
            irACabanas();
            window.addEventListener('load', irACabanas);
            setTimeout(irACabanas, 400);
        }
        window.addEventListener('hashchange', function () {
            if (location.hash === '#cabanas') irACabanas();
        });
    </script>
}
