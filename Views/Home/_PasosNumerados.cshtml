@model List<string>

<ol class="mt-3 space-y-3">
    @for (var i = 0; i < Model.Count; i++)
    {
        <li class="flex gap-3">
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-river-100 text-xs font-bold text-river-800" aria-hidden="true">@(i + 1)</span>
            <span class="min-w-0 break-words text-sm leading-relaxed text-ink-700 sm:text-base">@Model[i]</span>
        </li>
    }
</ol>
