@model InformacionSitio
@{
    ViewData["Title"] = "Información";
    var preguntas = (List<PreguntaFrecuente>)ViewBag.Preguntas;
    var comodidades = (Model.Comodidades ?? "")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var linkMapa = !string.IsNullOrWhiteSpace(Model.Direccion)
        ? "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(Model.Direccion)
        : null;
}

<div class="mb-10 text-center">
    <h1 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Información</h1>
    <p class="mt-2 text-ink-500">Cómo llegar, qué encontrás en el complejo y las dudas más frecuentes.</p>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="rounded-2.5xl bg-white p-6 shadow-soft ring-1 ring-ink-100">
        <h2 class="font-display text-xl font-semibold text-ink-900">Cómo llegar</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Direccion))
        {
            <p class="mt-2 flex items-start gap-2 text-sm text-ink-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-river-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                @Model.Direccion
            </p>
        }
        @if (linkMapa != null)
        {
            <a href="@linkMapa" target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-river-700 hover:gap-2">
                Ver en Google Maps
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ComoLlegar))
        {
            <p class="mt-4 whitespace-pre-line leading-relaxed text-ink-600">@Model.ComoLlegar</p>
        }
    </div>

    <div class="rounded-2.5xl bg-white p-6 shadow-soft ring-1 ring-ink-100">
        <h2 class="font-display text-xl font-semibold text-ink-900">Comodidades del complejo</h2>
        @if (comodidades.Any())
        {
            <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
                @foreach (var item in comodidades)
                {
                    <li class="flex items-center gap-2 text-sm text-ink-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-river-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        @item
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="mt-2 text-sm text-ink-400">Todavía no se cargaron las comodidades.</p>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.InformacionAdicional))
    {
        <div class="rounded-2.5xl bg-white p-6 shadow-soft ring-1 ring-ink-100 lg:col-span-2">
            <h2 class="font-display text-xl font-semibold text-ink-900">Información adicional</h2>
            <p class="mt-2 whitespace-pre-line leading-relaxed text-ink-600">@Model.InformacionAdicional</p>
        </div>
    }

    <div class="rounded-2.5xl bg-white p-6 shadow-soft ring-1 ring-ink-100 lg:col-span-2">
        <h2 class="font-display text-xl font-semibold text-ink-900">Preguntas frecuentes</h2>
        <div class="mt-4 divide-y divide-ink-100">
            @foreach (var pregunta in preguntas)
            {
                <details class="group py-3">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-ink-900 marker:content-none">
                        @pregunta.Pregunta
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-ink-400 transition group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </summary>
                    <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-ink-600">@pregunta.Respuesta</p>
                </details>
            }
            @if (!preguntas.Any())
            {
                <p class="py-3 text-sm text-ink-400">Todavía no hay preguntas frecuentes cargadas.</p>
            }
        </div>
    </div>
</div>
