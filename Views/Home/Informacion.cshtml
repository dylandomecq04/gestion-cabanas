@model InformacionSitio
@functions {
    static List<string> Lineas(string? texto) => (texto ?? "")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();

    static string LinkLlamar(string telefono) =>
        "tel:" + new string(telefono.Where(c => char.IsDigit(c) || c == '+').ToArray());
}
@{
    ViewData["Title"] = "Información";
    var preguntas = (List<PreguntaFrecuente>)ViewBag.Preguntas;
    var comodidades = Lineas(Model.Comodidades);
    var introComoLlegar = Lineas(Model.ComoLlegar);
    var pasosAuto = Lineas(Model.ComoLlegarAuto);
    var pasosTren = Lineas(Model.ComoLlegarTren);
    var dondeComprar = Lineas(Model.DondeComprar);
    var actividades = Lineas(Model.Actividades);
    var normas = Lineas(Model.Normas);

    // Cada lancha remis se carga como "Nombre | Teléfono | Nota" (la nota es opcional).
    var remis = Lineas(Model.LanchasRemis)
        .Select(l => l.Split('|', StringSplitOptions.TrimEntries))
        .Where(p => p.Length >= 2 && p[0].Length > 0 && p[1].Length > 0)
        .Select(p => (Nombre: p[0], Telefono: p[1], Nota: p.Length > 2 ? p[2] : ""))
        .ToList();

    var linkMapa = !string.IsNullOrWhiteSpace(Model.Direccion)
        ? "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(Model.Direccion)
        : null;

    var tieneEmbarcadero = !string.IsNullOrWhiteSpace(Model.EmbarcaderoNombre) || !string.IsNullOrWhiteSpace(Model.EmbarcaderoDireccion);
    var linkEmbarcadero = tieneEmbarcadero
        ? "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(string.Join(", ", new[] { Model.EmbarcaderoNombre, Model.EmbarcaderoDireccion }.Where(x => !string.IsNullOrWhiteSpace(x))))
        : null;

    var tieneComoLlegar = !string.IsNullOrWhiteSpace(Model.Direccion) || !string.IsNullOrWhiteSpace(Model.ComoLlegar)
        || pasosAuto.Any() || pasosTren.Any() || tieneEmbarcadero || remis.Any();
    var tieneZona = dondeComprar.Any() || actividades.Any();

    var chip = "rounded-full bg-white px-4 py-2 text-sm font-semibold text-ink-700 shadow-soft ring-1 ring-ink-100 transition hover:text-river-700 hover:ring-river-200";
}

<section class="mb-6 text-center sm:mb-8">
    <p class="mb-2 text-sm font-medium uppercase tracking-[0.2em] text-river-600">Antes de venir</p>
    <h1 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Información</h1>
    <p class="mx-auto mt-3 max-w-xl text-sm text-ink-500 sm:text-base">Cómo llegar, qué encontrás en el complejo y las dudas más frecuentes.</p>
</section>

@* Accesos rápidos: en el celu la página es larga y las preguntas quedan al final. Se acomodan en varias filas, sin scroll lateral. *@
<nav aria-label="Ir a una sección" class="mx-auto mb-8 flex max-w-2xl flex-wrap justify-center gap-2 sm:mb-10">
    @if (tieneComoLlegar)
    {
        <a href="#como-llegar" class="@chip">Cómo llegar</a>
    }
    <a href="#comodidades" class="@chip">Comodidades</a>
    @if (tieneZona)
    {
        <a href="#en-la-zona" class="@chip">En la zona</a>
    }
    @if (normas.Any())
    {
        <a href="#normas" class="@chip">A tener en cuenta</a>
    }
    <a href="#preguntas" class="@chip">Preguntas</a>
</nav>

<section id="como-llegar" aria-labelledby="titulo-como-llegar" class="scroll-mt-24 rounded-2.5xl bg-white p-5 shadow-soft ring-1 ring-ink-100 sm:p-6">
    <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-river-50 text-river-700" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
        </span>
        <h2 id="titulo-como-llegar" class="font-display text-lg font-semibold text-ink-900 sm:text-xl">Cómo llegar</h2>
    </div>

    @if (introComoLlegar.Any())
    {
        <div class="mt-4 space-y-2.5">
            @foreach (var parrafo in introComoLlegar)
            {
                <p class="break-words text-sm leading-relaxed text-ink-600 sm:text-base">@parrafo</p>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Direccion))
    {
        <div class="mt-4 rounded-2xl bg-sand-50 px-4 py-3.5">
            <p class="text-xs font-semibold uppercase tracking-wide text-ink-400">Dirección</p>
            <p class="mt-1 break-words font-medium leading-snug text-ink-900">@Model.Direccion</p>
        </div>
        <a href="@linkMapa" target="_blank" rel="noopener"
           class="mt-3 flex w-full items-center justify-center gap-2 rounded-full bg-river-700 px-5 py-3 text-sm font-semibold text-white shadow-soft transition hover:bg-river-800 sm:inline-flex sm:w-auto">
            Ver en Google Maps
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
    }

    @if (pasosAuto.Any() || pasosTren.Any())
    {
        <div class="mt-5 grid grid-cols-1 gap-4 lg:grid-cols-2">
            @if (pasosAuto.Any())
            {
                <div class="rounded-2xl bg-sand-50 p-4 sm:p-5">
                    <h3 class="flex items-center gap-2 font-display text-base font-semibold text-ink-900">
                        <span aria-hidden="true">🚗</span> En auto
                    </h3>
                    <partial name="_PasosNumerados" model="pasosAuto" />
                </div>
            }
            @if (pasosTren.Any())
            {
                <div class="rounded-2xl bg-sand-50 p-4 sm:p-5">
                    <h3 class="flex items-center gap-2 font-display text-base font-semibold text-ink-900">
                        <span aria-hidden="true">🚆</span> En tren
                    </h3>
                    <partial name="_PasosNumerados" model="pasosTren" />
                </div>
            }
        </div>
    }

    @if (tieneEmbarcadero || remis.Any())
    {
        <div class="mt-4 rounded-2xl bg-river-50 p-3 ring-1 ring-river-100 sm:p-5">
            <h3 class="flex items-center gap-2 font-display text-base font-semibold text-river-900">
                <span aria-hidden="true">🚤</span> Dónde tomar la lancha
            </h3>

            @if (tieneEmbarcadero)
            {
                <div class="mt-3">
                    @if (!string.IsNullOrWhiteSpace(Model.EmbarcaderoNombre))
                    {
                        <p class="break-words font-semibold text-ink-900">@Model.EmbarcaderoNombre</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.EmbarcaderoDireccion))
                    {
                        <p class="break-words text-sm text-ink-600">@Model.EmbarcaderoDireccion</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.EmbarcaderoTelefono))
                    {
                        <p class="mt-0.5 break-words text-sm text-ink-600">Tel. @Model.EmbarcaderoTelefono</p>
                    }
                    <div class="mt-3 flex flex-col gap-2 sm:flex-row">
                        <a href="@linkEmbarcadero" target="_blank" rel="noopener"
                           class="inline-flex items-center justify-center gap-2 rounded-full bg-river-700 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:bg-river-800">
                            Ver en Google Maps
                        </a>
                        @if (!string.IsNullOrWhiteSpace(Model.EmbarcaderoTelefono))
                        {
                            <a href="@LinkLlamar(Model.EmbarcaderoTelefono)"
                               class="inline-flex items-center justify-center gap-2 rounded-full border border-river-300 bg-white px-5 py-2.5 text-sm font-semibold text-river-800 transition hover:bg-river-100">
                                Llamar
                            </a>
                        }
                    </div>
                </div>
            }

            @if (remis.Any())
            {
                <p class="@(tieneEmbarcadero ? "mt-5" : "mt-3") text-xs font-semibold uppercase tracking-wide text-river-800">Lanchas remis</p>
                <ul class="mt-2 divide-y divide-river-100 rounded-2xl bg-white ring-1 ring-river-100">
                    @foreach (var lancha in remis)
                    {
                        <li class="flex items-center justify-between gap-3 px-3 py-3 sm:px-4">
                            <div class="min-w-0">
                                <p class="break-words font-semibold text-ink-900">@lancha.Nombre</p>
                                <p class="whitespace-nowrap text-sm text-ink-600">@lancha.Telefono</p>
                                @if (!string.IsNullOrWhiteSpace(lancha.Nota))
                                {
                                    <p class="mt-0.5 break-words text-xs font-medium text-river-700">@lancha.Nota</p>
                                }
                            </div>
                            <a href="@LinkLlamar(lancha.Telefono)" aria-label="Llamar a @lancha.Nombre"
                               class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-river-700 px-3.5 py-2 text-sm font-semibold text-white shadow-soft transition hover:bg-river-800">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                                Llamar
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    }

    @if (!tieneComoLlegar)
    {
        <p class="mt-4 text-sm text-ink-400">Todavía no se cargó cómo llegar. Escribinos y te ayudamos.</p>
    }
</section>

<div class="mt-5 grid grid-cols-1 gap-5 lg:mt-6 lg:grid-cols-2 lg:gap-6">
    <section id="comodidades" aria-labelledby="titulo-comodidades-complejo" class="scroll-mt-24 rounded-2.5xl bg-white p-5 shadow-soft ring-1 ring-ink-100 sm:p-6">
        <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-river-50 text-river-700" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
            </span>
            <h2 id="titulo-comodidades-complejo" class="font-display text-lg font-semibold text-ink-900 sm:text-xl">Comodidades del complejo</h2>
        </div>

        @if (comodidades.Any())
        {
            <ul class="mt-4 flex flex-wrap gap-2">
                @foreach (var item in comodidades)
                {
                    <li class="flex max-w-full items-center gap-2 rounded-2xl bg-sand-50 px-3.5 py-2 text-sm leading-snug text-ink-700 ring-1 ring-sand-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-river-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="min-w-0 break-words">@item</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="mt-4 text-sm text-ink-400">Todavía no se cargaron las comodidades.</p>
        }
    </section>

    @if (dondeComprar.Any())
    {
        <section id="en-la-zona" aria-labelledby="titulo-donde-comprar" class="scroll-mt-24 rounded-2.5xl bg-white p-5 shadow-soft ring-1 ring-ink-100 sm:p-6">
            <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-river-50 text-river-700" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </span>
                <h2 id="titulo-donde-comprar" class="font-display text-lg font-semibold text-ink-900 sm:text-xl">Dónde comprar</h2>
            </div>
            <partial name="_ListaPuntos" model="dondeComprar" />
        </section>
    }

    @if (actividades.Any())
    {
        <section id="@(dondeComprar.Any() ? "actividades" : "en-la-zona")" aria-labelledby="titulo-actividades" class="scroll-mt-24 rounded-2.5xl bg-white p-5 shadow-soft ring-1 ring-ink-100 sm:p-6">
            <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-river-50 text-river-700" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                    </svg>
                </span>
                <h2 id="titulo-actividades" class="font-display text-lg font-semibold text-ink-900 sm:text-xl">Actividades en la isla</h2>
            </div>
            <partial name="_ListaPuntos" model="actividades" />
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(Model.InformacionAdicional))
    {
        <section aria-labelledby="titulo-info-adicional" class="rounded-2.5xl bg-sand-100/70 p-5 ring-1 ring-sand-200 sm:p-6 lg:col-span-2">
            <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-sand-700 shadow-soft" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </span>
                <h2 id="titulo-info-adicional" class="font-display text-lg font-semibold text-ink-900 sm:text-xl">Información adicional</h2>
            </div>
            <p class="mt-3 whitespace-pre-line break-words text-sm leading-relaxed text-ink-700 sm:text-base">@Model.InformacionAdicional</p>
        </section>
    }
</div>

@if (normas.Any())
{
    <section id="normas" aria-labelledby="titulo-normas" class="mt-5 scroll-mt-24 rounded-2.5xl bg-white p-5 shadow-soft ring-1 ring-ink-100 sm:p-6 lg:mt-6">
        <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-50 text-amber-600" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                </svg>
            </span>
            <div class="min-w-0">
                <h2 id="titulo-normas" class="font-display text-lg font-semibold text-ink-900 sm:text-xl">A tener en cuenta</h2>
                <p class="text-xs text-ink-500 sm:text-sm">Leelo antes de reservar.</p>
            </div>
        </div>
        <ul class="mt-4 grid grid-cols-1 gap-x-8 gap-y-3 lg:grid-cols-2">
            @foreach (var norma in normas)
            {
                <li class="flex gap-3">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500" aria-hidden="true"></span>
                    <span class="min-w-0 break-words text-sm leading-relaxed text-ink-700 sm:text-base">@norma</span>
                </li>
            }
        </ul>
    </section>
}

<section id="preguntas" aria-labelledby="titulo-preguntas" class="mx-auto mt-10 max-w-3xl scroll-mt-24 sm:mt-12">
    <div class="mb-4 flex items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-river-50 text-river-700" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </span>
        <h2 id="titulo-preguntas" class="font-display text-lg font-semibold text-ink-900 sm:text-xl">Preguntas frecuentes</h2>
    </div>

    @if (preguntas.Any())
    {
        <div class="space-y-2.5">
            @foreach (var pregunta in preguntas)
            {
                <details class="group rounded-2xl bg-white shadow-soft ring-1 ring-ink-100 transition open:ring-river-200">
                    <summary class="flex min-h-[3.5rem] cursor-pointer list-none items-center justify-between gap-3 px-4 py-3.5 text-sm font-semibold leading-snug text-ink-900 marker:content-none sm:px-5 sm:text-base [&::-webkit-details-marker]:hidden">
                        <span class="min-w-0 break-words">@pregunta.Pregunta</span>
                        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-50 text-ink-500 transition group-open:rotate-180 group-open:bg-river-100 group-open:text-river-700" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </summary>
                    <div class="px-4 pb-4 sm:px-5">
                        <p class="whitespace-pre-line break-words border-t border-ink-100 pt-3 text-sm leading-relaxed text-ink-600 sm:text-base">@pregunta.Respuesta</p>
                    </div>
                </details>
            }
        </div>
    }
    else
    {
        <p class="rounded-2xl bg-white px-4 py-4 text-sm text-ink-400 shadow-soft ring-1 ring-ink-100">Todavía no hay preguntas frecuentes cargadas.</p>
    }
</section>

<section class="mx-auto mt-10 max-w-3xl rounded-2.5xl bg-river-800 px-5 py-7 text-center text-white shadow-lift sm:mt-12 sm:px-8 sm:py-8">
    <h2 class="font-display text-xl font-semibold sm:text-2xl">¿Listo para reservar?</h2>
    <p class="mx-auto mt-2 max-w-md text-sm text-river-100 sm:text-base">Elegí tus fechas y mandá tu solicitud; nos contactamos con vos para confirmarla.</p>
    <a asp-area="" asp-controller="Cabanas" asp-action="Disponibilidad"
       class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-river-800 shadow-soft transition hover:bg-river-50 sm:w-auto">
        Ver disponibilidad
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
    </a>
</section>
