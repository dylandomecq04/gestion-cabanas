@model List<string>

<ul class="mt-4 space-y-3">
    @foreach (var item in Model)
    {
        <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-river-500" aria-hidden="true"></span>
            <span class="min-w-0 break-words text-sm leading-relaxed text-ink-700 sm:text-base">@item</span>
        </li>
    }
</ul>
