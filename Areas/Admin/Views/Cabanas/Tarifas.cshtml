@{
    ViewData["Title"] = "Precios y disponibilidad";
    var cabana = (Cabana)ViewBag.Cabana;
    var dias = (List<DiaTarifaVista>)ViewBag.Dias;
    DateTime primerDia = ViewBag.PrimerDia;
    DateTime mesAnterior = ViewBag.MesAnterior;
    DateTime mesSiguiente = ViewBag.MesSiguiente;
    bool permitirMesAnterior = ViewBag.PermitirMesAnterior;
    int indice = 0;

    int offset = ((int)primerDia.DayOfWeek + 6) % 7;
    var celdas = new List<DiaTarifaVista?>();
    for (int i = 0; i < offset; i++) celdas.Add(null);
    celdas.AddRange(dias);
    while (celdas.Count % 7 != 0) celdas.Add(null);

    var precioBaseTexto = cabana.PrecioPorNoche.HasValue ? "$" + cabana.PrecioPorNoche.Value.ToString("N0") : "Sin precio base";
}

<a asp-action="Index" class="mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 transition hover:text-river-700">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
    </svg>
    Volver a cabañas
</a>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="font-display text-2xl font-semibold text-ink-900">Precios y disponibilidad</h1>
        <p class="mt-1 text-sm text-ink-500">
            @cabana.Nombre &middot; precio base:
            @(cabana.PrecioPorNoche.HasValue ? "$" + cabana.PrecioPorNoche.Value.ToString("N0") + " / noche" : "sin definir")
        </p>
    </div>
    <div class="flex gap-2">
        @if (permitirMesAnterior)
        {
            <a asp-action="Tarifas" asp-route-id="@cabana.Id" asp-route-anio="@mesAnterior.Year" asp-route-mes="@mesAnterior.Month"
               class="rounded-full border border-ink-200 px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700">&larr; Mes anterior</a>
        }
        <a asp-action="Tarifas" asp-route-id="@cabana.Id" asp-route-anio="@mesSiguiente.Year" asp-route-mes="@mesSiguiente.Month"
           class="rounded-full border border-ink-200 px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700">Mes siguiente &rarr;</a>
    </div>
</div>

<p class="mb-4 text-sm text-ink-500">
    Tocá uno o varios días para seleccionarlos (podés elegir varios a la vez) y después ponerles precio o bloquearlos juntos.
</p>

<form id="form-tarifas" asp-action="GuardarTarifas" asp-route-id="@cabana.Id" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post" class="pb-24">
    <div class="rounded-2.5xl bg-white p-6 shadow-soft ring-1 ring-ink-100">
        <div class="grid grid-cols-7 gap-1.5 text-center text-xs font-semibold uppercase tracking-wide text-ink-400">
            <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
        </div>
        <div class="mt-1 grid grid-cols-7 gap-1">
            @foreach (var dia in celdas)
            {
                if (dia is null)
                {
                    <div></div>
                }
                else if (dia.Pasada)
                {
                    <div class="day-cell flex h-12 items-center justify-center rounded-lg bg-ink-50 text-[10px] text-ink-300">@dia.Fecha.Day</div>
                }
                else if (dia.Reservada)
                {
                    <div class="day-cell flex h-12 flex-col items-center justify-center gap-0.5 rounded-lg bg-river-100 font-medium text-river-700" title="Reservada">
                        <span class="text-[9px] opacity-70">@dia.Fecha.Day</span>
                        <span class="text-[10px] font-bold uppercase">Reservada</span>
                    </div>
                }
                else
                {
                    var precioTexto = dia.Precio?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "";
                    var etiqueta = dia.Bloqueada ? "Bloqueada" : (dia.Precio.HasValue ? "$" + dia.Precio.Value.ToString("N0") : precioBaseTexto);
                    var clases = dia.Bloqueada ? "bg-ink-200 text-ink-500" : "bg-river-50 text-river-700 hover:bg-river-100";

                    <div class="contents">
                        <button type="button" data-index="@indice"
                                data-precio="@precioTexto"
                                data-bloqueada="@(dia.Bloqueada ? "true" : "false")"
                                onclick="alternarSeleccionDia(this)"
                                class="dia-editable day-cell relative flex h-12 flex-col items-center justify-center gap-0.5 rounded-lg font-medium ring-2 ring-inset ring-transparent transition hover:ring-river-300 @clases">
                            <span class="text-[9px] opacity-70">@dia.Fecha.Day</span>
                            <span class="etiqueta-precio text-[11px] font-bold leading-none">@etiqueta</span>
                            <span class="badge-seleccionado absolute -right-1 -top-1 hidden h-3.5 w-3.5 items-center justify-center rounded-full bg-river-700 text-[9px] text-white shadow-soft">✓</span>
                        </button>
                        <input type="hidden" name="dias[@indice].Fecha" value="@dia.Fecha.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="dias[@indice].Precio" value="@precioTexto" />
                        <input type="hidden" name="dias[@indice].Bloqueada" value="@(dia.Bloqueada ? "true" : "false")" />
                    </div>
                    indice++;
                }
            }
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-4 text-xs text-ink-500">
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-river-50 ring-1 ring-inset ring-river-200"></span> Disponible (precio base)</span>
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-ink-200"></span> Bloqueada</span>
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-river-100"></span> Reservada</span>
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-ink-50"></span> Fecha pasada</span>
        </div>
    </div>

    <div class="mt-4 flex items-center gap-3">
        <button type="submit" class="rounded-full bg-river-700 px-6 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">
            Guardar cambios
        </button>
        <span class="text-xs text-ink-400">Los cambios se guardan recién cuando tocás este botón.</span>
    </div>
</form>

<div id="barra-seleccion" class="hidden fixed inset-x-0 bottom-0 z-40 border-t border-ink-100 bg-white/95 p-4 shadow-lift backdrop-blur">
    <div class="mx-auto flex max-w-4xl flex-wrap items-end gap-3">
        <div class="text-sm font-medium text-ink-700"><span id="contador-seleccion">0</span> día(s) seleccionados</div>
        <div class="min-w-[140px] flex-1">
            <label class="mb-1 block text-xs font-medium text-ink-600">Precio esa noche (vacío = @precioBaseTexto)</label>
            <input id="bulk-precio" type="text" inputmode="numeric" placeholder="@precioBaseTexto"
                   oninput="formatearMiles(this)"
                   class="w-full rounded-xl border border-ink-200 px-3.5 py-2 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
        </div>
        <label class="flex items-center gap-2 pb-2 text-sm font-medium text-ink-700">
            <input id="bulk-bloqueada" type="checkbox" class="h-4 w-4 rounded border-ink-300 text-rose-600 focus:ring-rose-400" />
            Bloquear
        </label>
        <button type="button" onclick="aplicarSeleccion()" class="rounded-full bg-river-700 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:bg-river-800">
            Aplicar a seleccionados
        </button>
        <button type="button" onclick="cancelarSeleccion()" class="rounded-full border border-ink-200 px-4 py-2.5 text-sm font-medium text-ink-600 transition hover:border-ink-300">
            Cancelar selección
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const precioBaseTexto = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(precioBaseTexto));
        const seleccionDias = new Set();

        function alternarSeleccionDia(btn) {
            const idx = btn.dataset.index;
            const badge = btn.querySelector('.badge-seleccionado');
            if (seleccionDias.has(idx)) {
                seleccionDias.delete(idx);
                btn.classList.remove('ring-river-600');
                badge.classList.add('hidden');
                badge.classList.remove('flex');
            } else {
                seleccionDias.add(idx);
                btn.classList.add('ring-river-600');
                badge.classList.remove('hidden');
                badge.classList.add('flex');
            }
            actualizarBarraSeleccion();
        }

        function actualizarBarraSeleccion() {
            const barra = document.getElementById('barra-seleccion');
            document.getElementById('contador-seleccion').textContent = seleccionDias.size;
            barra.classList.toggle('hidden', seleccionDias.size === 0);
        }

        function cancelarSeleccion() {
            seleccionDias.forEach(idx => {
                const btn = document.querySelector(`.dia-editable[data-index="${idx}"]`);
                if (!btn) return;
                btn.classList.remove('ring-river-600');
                const badge = btn.querySelector('.badge-seleccionado');
                badge.classList.add('hidden');
                badge.classList.remove('flex');
            });
            seleccionDias.clear();
            document.getElementById('bulk-precio').value = '';
            document.getElementById('bulk-bloqueada').checked = false;
            actualizarBarraSeleccion();
        }

        function formatearMiles(input) {
            const soloDigitos = input.value.replace(/\D/g, '');
            input.value = soloDigitos ? Number(soloDigitos).toLocaleString('es-AR') : '';
        }

        function aplicarSeleccion() {
            const precioTexto = document.getElementById('bulk-precio').value.replace(/\D/g, '');
            const bloqueada = document.getElementById('bulk-bloqueada').checked;

            seleccionDias.forEach(idx => {
                const btn = document.querySelector(`.dia-editable[data-index="${idx}"]`);
                if (!btn) return;

                btn.dataset.precio = precioTexto;
                btn.dataset.bloqueada = bloqueada ? 'true' : 'false';

                document.querySelector(`input[name="dias[${idx}].Precio"]`).value = precioTexto;
                document.querySelector(`input[name="dias[${idx}].Bloqueada"]`).value = bloqueada ? 'true' : 'false';

                btn.classList.remove('bg-ink-200', 'text-ink-500', 'bg-river-50', 'text-river-700', 'hover:bg-river-100');
                if (bloqueada) {
                    btn.classList.add('bg-ink-200', 'text-ink-500');
                } else {
                    btn.classList.add('bg-river-50', 'text-river-700', 'hover:bg-river-100');
                }

                const etiqueta = btn.querySelector('.etiqueta-precio');
                if (etiqueta) {
                    etiqueta.textContent = bloqueada ? 'Bloqueada' : (precioTexto ? '$' + Number(precioTexto).toLocaleString('es-AR') : precioBaseTexto);
                }
            });

            cancelarSeleccion();
        }
    </script>
}
