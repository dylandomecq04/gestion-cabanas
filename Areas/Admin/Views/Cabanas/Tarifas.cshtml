@{
    ViewData["Title"] = "Precios y disponibilidad";
    var cabana = (Cabana)ViewBag.Cabana;
    var dias = (List<DiaTarifaVista>)ViewBag.Dias;
    var promos = (List<PromoEstadia>)ViewBag.PromosEstadia;
    DateTime primerDia = ViewBag.PrimerDia;
    DateTime mesAnterior = ViewBag.MesAnterior;
    DateTime mesSiguiente = ViewBag.MesSiguiente;
    bool permitirMesAnterior = ViewBag.PermitirMesAnterior;
    int indice = 0;

    // Solo se cargan los tramos que la cabaña admite (una cabaña para 4 no tiene precio para 6).
    var tramos = cabana.TramosDePrecio().ToList();
    var textoTramos = tramos.Count > 1
        ? string.Join(", ", tramos.Take(tramos.Count - 1)) + " y " + tramos.Last()
        : tramos.First().ToString();

    int offset = ((int)primerDia.DayOfWeek + 6) % 7;
    var celdas = new List<DiaTarifaVista?>();
    for (int i = 0; i < offset; i++) celdas.Add(null);
    celdas.AddRange(dias);
    while (celdas.Count % 7 != 0) celdas.Add(null);

    string Miles(decimal? precio) => precio.HasValue ? precio.Value.ToString("N0") : "–";
    string Plano(decimal? precio) => precio?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "";
}

<a asp-action="Index" class="mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-ink-500 transition hover:text-river-700">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
    </svg>
    Volver a cabañas
</a>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="font-display text-2xl font-semibold text-ink-900">Precios y disponibilidad</h1>
        <p class="mt-1 text-sm text-ink-500">@cabana.Nombre &middot; precio por noche según cantidad de personas (para @textoTramos) &middot; hasta @cabana.Capacidad personas</p>
    </div>
    <div class="flex gap-2">
        @if (permitirMesAnterior)
        {
            <a asp-action="Tarifas" asp-route-id="@cabana.Id" asp-route-anio="@mesAnterior.Year" asp-route-mes="@mesAnterior.Month"
               class="whitespace-nowrap rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700 sm:px-4 sm:py-2 sm:text-sm">&larr; Mes anterior</a>
        }
        <a asp-action="Tarifas" asp-route-id="@cabana.Id" asp-route-anio="@mesSiguiente.Year" asp-route-mes="@mesSiguiente.Month"
           class="whitespace-nowrap rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700 sm:px-4 sm:py-2 sm:text-sm">Mes siguiente &rarr;</a>
    </div>
</div>

<p class="mb-4 text-sm text-ink-500">
    Tocá uno o varios días para seleccionarlos (podés elegir varios a la vez) y después ponerles precio juntos.
    En cada día se ven, de arriba hacia abajo, los precios para @textoTramos personas.
</p>

<form id="form-tarifas" asp-action="GuardarTarifas" asp-route-id="@cabana.Id" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post" class="pb-44 sm:pb-24">
    <div class="rounded-2.5xl bg-white p-3 shadow-soft ring-1 ring-ink-100 sm:p-6">
        <div class="grid grid-cols-7 gap-1.5 text-center text-xs font-semibold uppercase tracking-wide text-ink-400">
            <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
        </div>
        <div class="mt-1 grid grid-cols-7 gap-1">
            @foreach (var dia in celdas)
            {
                if (dia is null)
                {
                    <div></div>
                }
                else if (dia.Pasada)
                {
                    <div class="day-cell flex h-16 items-center justify-center rounded-lg bg-ink-50 text-[10px] text-ink-300">@dia.Fecha.Day</div>
                }
                else if (dia.Reservada)
                {
                    <div class="day-cell flex h-16 flex-col items-center justify-center gap-0.5 rounded-lg bg-river-100 font-medium text-river-700" title="Reservada">
                        <span class="text-[9px] opacity-70">@dia.Fecha.Day</span>
                        <span class="text-[10px] font-bold uppercase"><span class="sm:hidden">Res.</span><span class="hidden sm:inline">Reservada</span></span>
                    </div>
                }
                else
                {
                    var clases = dia.EnPromo ? "bg-amber-100 text-amber-800 hover:bg-amber-200" : "bg-river-50 text-river-700 hover:bg-river-100";

                    <div class="contents">
                        <button type="button" data-index="@indice"
                                data-precio2="@Plano(dia.Precio2)" data-precio4="@Plano(dia.Precio4)" data-precio6="@Plano(dia.Precio6)"
                                onclick="alternarSeleccionDia(this)"
                                class="dia-editable day-cell relative flex h-16 flex-col items-center justify-center gap-0.5 rounded-lg font-medium ring-2 ring-inset ring-transparent transition hover:ring-river-300 @clases">
                            @if (dia.EnPromo)
                            {
                                <span class="absolute -top-1.5 left-0.5 text-[7px] font-bold uppercase tracking-wide text-amber-600">Promo</span>
                            }
                            <span class="text-[9px] opacity-70">@dia.Fecha.Day</span>
                            <span class="etiqueta-precio flex flex-col items-center text-[9px] font-bold leading-tight">
                                @foreach (var tramo in tramos)
                                {
                                    <span data-tramo="@tramo">@Miles(dia.PrecioDelTramo(tramo))</span>
                                }
                            </span>
                            <span class="badge-seleccionado absolute -right-1 -top-1 hidden h-3.5 w-3.5 items-center justify-center rounded-full bg-river-700 text-[9px] text-white shadow-soft">✓</span>
                        </button>
                        <input type="hidden" name="dias[@indice].Fecha" value="@dia.Fecha.ToString("yyyy-MM-dd")" />
                        @foreach (var tramo in tramos)
                        {
                            <input type="hidden" name="dias[@indice].Precio@(tramo)" value="@Plano(dia.PrecioDelTramo(tramo))" />
                        }
                    </div>
                    indice++;
                }
            }
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-ink-500">
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 shrink-0 rounded-full bg-river-50 ring-1 ring-inset ring-river-200"></span> Disponible (precios para @string.Join(" · ", tramos) personas)</span>
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-amber-100"></span> Con promoción</span>
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-river-100"></span> Reservada</span>
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-ink-50"></span> Fecha pasada</span>
        </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
        <button type="submit" class="whitespace-nowrap rounded-full bg-river-700 px-6 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">
            Guardar cambios
        </button>
        <span class="text-xs text-ink-400">Los cambios se guardan recién cuando tocás este botón.</span>
    </div>
</form>

<div class="mt-6 rounded-2.5xl bg-white p-4 shadow-soft ring-1 ring-ink-100 sm:p-6">
    <h2 class="mb-1 font-display text-lg font-semibold text-ink-900">Promociones por estadía</h2>
    <p class="mb-4 text-sm text-ink-500">Precios especiales por cantidad de noches para un rango de fechas. Se aplican automáticamente cuando alguien reserva desde el sitio dentro de ese rango.</p>

    @if (promos.Count == 0)
    {
        <p class="text-sm text-ink-400">Todavía no hay promociones para esta cabaña.</p>
    }
    else
    {
        <div class="space-y-2">
            @foreach (var promo in promos)
            {
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-ink-100 px-4 py-3 text-sm @(promo.Activa ? "bg-amber-50" : "bg-ink-50 opacity-70")">
                    <div>
                        <p class="font-semibold text-ink-900">@(string.IsNullOrWhiteSpace(promo.Nombre) ? "Promoción" : promo.Nombre) &middot; @promo.FechaDesde.ToString("dd/MM/yyyy") al @promo.FechaHasta.ToString("dd/MM/yyyy")</p>
                        @if (!string.IsNullOrWhiteSpace(promo.Descripcion))
                        {
                            <p class="mt-0.5 text-xs text-ink-500">@promo.Descripcion</p>
                        }
                        <p class="mt-0.5 text-xs text-ink-500">
                            @(promo.Precio1Noche.HasValue ? "1 noche: $" + promo.Precio1Noche.Value.ToString("N0") : "1 noche: -")
                            &middot; @(promo.Precio2Noches.HasValue ? "2 noches: $" + promo.Precio2Noches.Value.ToString("N0") : "2 noches: -")
                            &middot; @(promo.Precio3Noches.HasValue ? "3 noches: $" + promo.Precio3Noches.Value.ToString("N0") : "3 noches: -")
                            @if (!promo.Activa)
                            {
                                <span class="font-semibold text-ink-400"> · Inactiva</span>
                            }
                        </p>
                    </div>
                    <div class="flex shrink-0 gap-2">
                        <form asp-action="AlternarPromoEstadia" asp-route-id="@promo.Id" asp-route-cabanaId="@cabana.Id" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post">
                            <button type="submit" class="rounded-full border border-ink-200 px-3.5 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700">
                                @(promo.Activa ? "Desactivar" : "Activar")
                            </button>
                        </form>
                        <form asp-action="EliminarPromoEstadia" asp-route-id="@promo.Id" asp-route-cabanaId="@cabana.Id" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post" onsubmit="return confirm('¿Eliminar esta promoción?');">
                            <button type="submit" class="rounded-full border border-rose-200 px-3.5 py-1.5 text-xs font-medium text-rose-600 transition hover:border-rose-300 hover:bg-rose-50">
                                Eliminar
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div id="barra-seleccion" class="hidden fixed inset-x-0 bottom-0 z-40 border-t border-ink-100 bg-white/95 px-3 py-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] shadow-lift backdrop-blur sm:p-4">
    <div class="mx-auto flex max-w-4xl flex-wrap items-end gap-x-2 gap-y-2 sm:gap-3">
        <div id="texto-seleccion" class="flex h-9 shrink-0 items-center whitespace-nowrap rounded-full bg-river-50 px-2.5 text-xs font-semibold text-river-800 sm:h-auto sm:bg-transparent sm:px-0 sm:text-sm sm:font-medium sm:text-ink-700">0 días seleccionados</div>
        @foreach (var tramo in tramos)
        {
            <div class="min-w-0 flex-1 sm:min-w-[110px]">
                <label class="mb-0.5 block whitespace-nowrap text-[11px] font-medium text-ink-600 sm:mb-1 sm:text-xs">Para @tramo<span class="hidden sm:inline"> (vacío = no cambia)</span></label>
                <input id="bulk-precio-@tramo" type="text" inputmode="numeric" placeholder="$"
                       oninput="formatearMiles(this)"
                       class="h-9 w-full rounded-xl border border-ink-200 px-2 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100 sm:h-auto sm:px-3.5 sm:py-2" />
            </div>
        }
        <div class="flex w-full items-center gap-2 sm:w-auto">
            <button type="button" onclick="aplicarSeleccion(false)" class="h-9 flex-1 whitespace-nowrap rounded-full bg-river-700 px-3 text-xs font-semibold text-white shadow-soft transition hover:bg-river-800 sm:h-auto sm:flex-none sm:px-5 sm:py-2.5 sm:text-sm">
                Aplicar<span class="hidden sm:inline"> a seleccionados</span>
            </button>
            <button type="button" onclick="aplicarSeleccion(true)" class="h-9 flex-1 whitespace-nowrap rounded-full border border-rose-200 px-3 text-xs font-medium text-rose-600 transition hover:bg-rose-50 sm:h-auto sm:flex-none sm:px-4 sm:py-2.5 sm:text-sm">
                Borrar precios
            </button>
            <button type="button" onclick="cancelarSeleccion()" class="h-9 flex-1 whitespace-nowrap rounded-full border border-ink-200 px-3 text-xs font-medium text-ink-600 transition hover:border-ink-300 sm:h-auto sm:flex-none sm:px-4 sm:py-2.5 sm:text-sm">
                Cancelar<span class="hidden sm:inline"> selección</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const TRAMOS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tramos));
        const seleccionDias = new Set();

        function alternarSeleccionDia(btn) {
            const idx = btn.dataset.index;
            const badge = btn.querySelector('.badge-seleccionado');
            if (seleccionDias.has(idx)) {
                seleccionDias.delete(idx);
                btn.classList.remove('ring-river-600');
                badge.classList.add('hidden');
                badge.classList.remove('flex');
            } else {
                seleccionDias.add(idx);
                btn.classList.add('ring-river-600');
                badge.classList.remove('hidden');
                badge.classList.add('flex');
            }
            actualizarBarraSeleccion();
        }

        function actualizarBarraSeleccion() {
            const barra = document.getElementById('barra-seleccion');
            const cantidadSeleccion = seleccionDias.size;
            // En el celu alcanza con "2 días"; el "seleccionados" solo se muestra en pantallas grandes.
            document.getElementById('texto-seleccion').innerHTML =
                cantidadSeleccion + (cantidadSeleccion === 1 ? ' día' : ' días') +
                '<span class="hidden sm:inline">&nbsp;' + (cantidadSeleccion === 1 ? 'seleccionado' : 'seleccionados') + '</span>';
            barra.classList.toggle('hidden', cantidadSeleccion === 0);
        }

        function cancelarSeleccion() {
            seleccionDias.forEach(idx => {
                const btn = document.querySelector(`.dia-editable[data-index="${idx}"]`);
                if (!btn) return;
                btn.classList.remove('ring-river-600');
                const badge = btn.querySelector('.badge-seleccionado');
                badge.classList.add('hidden');
                badge.classList.remove('flex');
            });
            seleccionDias.clear();
            TRAMOS.forEach(t => { document.getElementById('bulk-precio-' + t).value = ''; });
            actualizarBarraSeleccion();
        }

        function formatearMiles(input) {
            const soloDigitos = input.value.replace(/\D/g, '');
            input.value = soloDigitos ? Number(soloDigitos).toLocaleString('es-AR') : '';
        }

        // Con borrar = true se vacían los tres precios de los días elegidos; si no, sólo se
        // pisan los tramos que tengan un valor cargado.
        function aplicarSeleccion(borrar) {
            const nuevos = {};
            TRAMOS.forEach(t => {
                nuevos[t] = document.getElementById('bulk-precio-' + t).value.replace(/\D/g, '');
            });

            seleccionDias.forEach(idx => {
                const btn = document.querySelector(`.dia-editable[data-index="${idx}"]`);
                if (!btn) return;

                TRAMOS.forEach(t => {
                    if (!borrar && !nuevos[t]) return;
                    const valor = borrar ? '' : nuevos[t];
                    btn.dataset['precio' + t] = valor;
                    document.querySelector(`input[name="dias[${idx}].Precio${t}"]`).value = valor;
                    const linea = btn.querySelector(`.etiqueta-precio [data-tramo="${t}"]`);
                    if (linea) {
                        linea.textContent = valor ? Number(valor).toLocaleString('es-AR') : '–';
                    }
                });
            });

            cancelarSeleccion();
        }
    </script>
}
