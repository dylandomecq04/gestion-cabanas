@model List<Cabana>
@{
    ViewData["Title"] = "Cabañas";
}

<div class="mb-6 flex items-center justify-between">
    <h1 class="font-display text-2xl font-semibold text-ink-900">Cabañas</h1>
    <a asp-action="Create" class="rounded-full bg-river-700 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">+ Nueva cabaña</a>
</div>

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var cabana in Model)
    {
        var portada = cabana.Fotos.OrderBy(f => f.Orden).FirstOrDefault();
        <div class="group overflow-hidden rounded-2.5xl bg-white shadow-soft ring-1 ring-ink-100 transition hover:-translate-y-0.5 hover:shadow-lift">
            <div class="relative h-40 w-full overflow-hidden bg-sand-100">
                @if (portada != null)
                {
                    <img src="~/@portada.RutaArchivo" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
                }
                else
                {
                    <div class="flex h-full w-full items-center justify-center text-4xl">🏡</div>
                }
                @if (!cabana.Activa)
                {
                    <span class="absolute right-3 top-3 rounded-full bg-ink-900/80 px-2.5 py-1 text-xs font-semibold text-white">Inactiva</span>
                }
            </div>
            <div class="p-5">
                <h2 class="font-display text-lg font-semibold text-ink-900">@cabana.Nombre</h2>
                <p class="mt-1 flex items-center gap-1.5 text-sm text-ink-500">
                    <span>👥</span> Hasta @cabana.Capacidad personas
                </p>
                <div class="mt-4 flex gap-2">
                    <a asp-action="Edit" asp-route-id="@cabana.Id" class="flex-1 rounded-full border border-ink-200 px-3 py-2 text-center text-xs font-semibold text-ink-600 transition hover:border-river-300 hover:text-river-700">Editar</a>
                    <form asp-action="Delete" asp-route-id="@cabana.Id" method="post" onsubmit="return confirmarAccion(event, '¿Eliminar esta cabaña?');" class="flex-1">
                        <button type="submit" class="w-full rounded-full border border-rose-200 px-3 py-2 text-xs font-semibold text-rose-600 transition hover:bg-rose-50">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
