@model Cabana
@{
    ViewData["Title"] = "Editar cabaña";
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-display text-2xl font-semibold text-ink-900">Editar cabaña</h1>
    <a asp-action="Tarifas" asp-route-id="@Model.Id" class="rounded-full border border-ink-200 px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700">Precios y disponibilidad &rarr;</a>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data"
          class="space-y-4 rounded-2.5xl bg-white p-4 shadow-soft ring-1 ring-ink-100 sm:p-6">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="@(ViewData.ModelState.IsValid ? "hidden" : "rounded-xl bg-rose-50 px-4 py-2 text-sm font-medium text-rose-700")"></div>

        <div>
            <label asp-for="Nombre" class="mb-1 block text-sm font-medium text-ink-700"></label>
            <input asp-for="Nombre" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            <span asp-validation-for="Nombre" class="mt-1 block text-xs font-medium text-rose-600"></span>
        </div>
        <div>
            <label asp-for="Capacidad" class="mb-1 block text-sm font-medium text-ink-700"></label>
            <input asp-for="Capacidad" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            <span asp-validation-for="Capacidad" class="mt-1 block text-xs font-medium text-rose-600"></span>
        </div>
        <div>
            <label asp-for="Orden" class="mb-1 block text-sm font-medium text-ink-700"></label>
            <input asp-for="Orden" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            <span asp-validation-for="Orden" class="mt-1 block text-xs font-medium text-rose-600"></span>
            <p class="mt-1 text-xs text-ink-400">1 es la primera cabaña de la fila, 2 la que sigue, y así. Se usa para recomendar cabañas contiguas cuando un grupo se reparte en dos.</p>
        </div>
        <label class="flex items-center gap-2 text-sm font-medium text-ink-700">
            <input asp-for="Activa" class="h-4 w-4 rounded border-ink-300 text-river-600 focus:ring-river-400" />
            Visible en el sitio público
        </label>
        <div>
            <label class="mb-1 block text-sm font-medium text-ink-700">Agregar fotos</label>
            <input type="file" name="fotos" multiple accept=".jpg,.jpeg,.png,.webp"
                   class="block w-full text-sm text-ink-600 file:mr-4 file:rounded-full file:border-0 file:bg-river-50 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-river-700 hover:file:bg-river-100" />
        </div>
        <div class="flex items-center gap-3 pt-2">
            <button type="submit" class="rounded-full bg-river-700 px-6 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">Guardar</button>
            <a asp-action="Index" class="text-sm font-medium text-ink-500 hover:text-ink-700">Cancelar</a>
        </div>
    </form>

    <div class="rounded-2.5xl bg-white p-4 shadow-soft ring-1 ring-ink-100 sm:p-6">
        <div class="mb-1 flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
            <h2 class="text-sm font-semibold text-ink-700">Fotos actuales</h2>
            @if (Model.Fotos.Any())
            {
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <label class="flex items-center gap-1.5 whitespace-nowrap text-xs font-medium text-ink-500">
                        <input type="checkbox" id="seleccionar-todas-fotos-cabana" onchange="toggleTodasFotosCabana(this)" class="h-4 w-4 rounded border-ink-300 text-river-700 focus:ring-river-400" />
                        Seleccionar todo
                    </label>
                    <button type="button" id="btn-eliminar-fotos-cabana" onclick="eliminarSeleccionadasFotosCabana()" disabled
                            class="whitespace-nowrap rounded-full bg-rose-600 px-4 py-1.5 text-xs font-semibold text-white shadow-soft transition hover:bg-rose-700 disabled:cursor-not-allowed disabled:opacity-40">
                        Eliminar seleccionadas (<span id="contador-fotos-cabana">0</span>)
                    </button>
                </div>
            }
        </div>
        <p class="mb-3 text-xs text-ink-400">Arrastrá las fotos para ordenarlas. La primera es la portada que se muestra en el sitio público.</p>
        <form id="form-reordenar-fotos" asp-action="ReordenarFotos" asp-route-cabanaId="@Model.Id" method="post"></form>
        <form id="form-eliminar-fotos-cabana" asp-action="EliminarFotos" asp-route-cabanaId="@Model.Id" method="post"
              onsubmit="return confirmarAccion(event, '¿Eliminar las fotos seleccionadas?');">
            <div id="fotos-grid" class="grid grid-cols-3 gap-3">
                @{ var fotosOrdenadas = Model.Fotos.OrderBy(f => f.Orden).ToList(); }
                @for (var i = 0; i < fotosOrdenadas.Count; i++)
                {
                    var foto = fotosOrdenadas[i];
                    <div class="foto-item relative cursor-grab overflow-hidden rounded-xl active:cursor-grabbing" draggable="true" data-id="@foto.Id">
                        <img src="@foto.RutaArchivo" draggable="false" class="h-24 w-full select-none object-cover" />
                        <span class="badge-portada absolute left-1 top-1 rounded-full bg-river-700 px-2 py-0.5 text-[10px] font-semibold text-white shadow-soft @(i == 0 ? "" : "hidden")">Portada</span>
                        <label class="absolute bottom-1 left-1 flex h-6 w-6 items-center justify-center rounded-full bg-white/80 shadow-soft" draggable="false" onmousedown="event.stopPropagation();">
                            <input type="checkbox" name="ids" value="@foto.Id" draggable="false" onchange="actualizarSeleccionFotosCabana()" class="h-4 w-4 rounded border-ink-300 text-river-700 focus:ring-river-400" />
                        </label>
                        <button type="button" onclick="eliminarUnaFotoCabana(@foto.Id)"
                                class="absolute right-1 top-1 flex h-6 w-6 items-center justify-center rounded-full bg-rose-600 text-xs font-bold text-white shadow-soft transition hover:bg-rose-700">&times;</button>
                    </div>
                }
            </div>
        </form>
        @if (!Model.Fotos.Any())
        {
            <p class="text-sm text-ink-400">Todavía no hay fotos cargadas.</p>
        }
    </div>
</div>

<form id="form-eliminar-una-foto-cabana" asp-action="EliminarFoto" asp-route-cabanaId="@Model.Id" method="post" class="hidden"
      onsubmit="return confirmarAccion(event, '¿Eliminar esta foto?');">
    <input type="hidden" id="id-eliminar-una-foto-cabana" name="id" value="" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const grid = document.getElementById('fotos-grid');
            if (!grid) return;

            let arrastrada = null;

            function actualizarBadgePortada() {
                grid.querySelectorAll('.badge-portada').forEach((badge, i) => badge.classList.toggle('hidden', i !== 0));
            }

            async function guardarOrden() {
                const form = document.getElementById('form-reordenar-fotos');
                const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (!token) return;

                const body = new URLSearchParams();
                body.set('__RequestVerificationToken', token);
                grid.querySelectorAll('.foto-item').forEach(item => body.append('idsFotos', item.dataset.id));

                try {
                    await fetch(form.action, { method: 'POST', body });
                } catch {
                    // Si falla, el orden vuelve a sincronizarse al recargar la página.
                }
            }

            grid.addEventListener('dragstart', function (e) {
                arrastrada = e.target.closest('.foto-item');
                e.dataTransfer.effectAllowed = 'move';
                setTimeout(() => arrastrada?.classList.add('opacity-40'), 0);
            });

            grid.addEventListener('dragover', function (e) {
                e.preventDefault();
                const item = e.target.closest('.foto-item');
                if (!item || !arrastrada || item === arrastrada) return;

                const rect = item.getBoundingClientRect();
                let antes;
                if (e.clientY < rect.top + 4) {
                    antes = true;
                } else if (e.clientY > rect.bottom - 4) {
                    antes = false;
                } else {
                    antes = e.clientX < rect.left + rect.width / 2;
                }
                item.parentNode.insertBefore(arrastrada, antes ? item : item.nextSibling);
                actualizarBadgePortada();
            });

            grid.addEventListener('drop', function (e) {
                e.preventDefault();
            });

            grid.addEventListener('dragend', function () {
                arrastrada?.classList.remove('opacity-40');
                arrastrada = null;
                actualizarBadgePortada();
                guardarOrden();
            });
        })();

        function obtenerCheckboxesFotosCabana() {
            return Array.from(document.querySelectorAll('#form-eliminar-fotos-cabana input[name="ids"]'));
        }

        function toggleTodasFotosCabana(origen) {
            obtenerCheckboxesFotosCabana().forEach(function (checkbox) {
                checkbox.checked = origen.checked;
            });
            actualizarSeleccionFotosCabana();
        }

        function actualizarSeleccionFotosCabana() {
            var checkboxes = obtenerCheckboxesFotosCabana();
            var seleccionadas = checkboxes.filter(function (checkbox) { return checkbox.checked; });

            document.getElementById('contador-fotos-cabana').textContent = seleccionadas.length;
            document.getElementById('btn-eliminar-fotos-cabana').disabled = seleccionadas.length === 0;

            var seleccionarTodas = document.getElementById('seleccionar-todas-fotos-cabana');
            seleccionarTodas.checked = checkboxes.length > 0 && seleccionadas.length === checkboxes.length;
            seleccionarTodas.indeterminate = seleccionadas.length > 0 && seleccionadas.length < checkboxes.length;
        }

        function eliminarSeleccionadasFotosCabana() {
            document.getElementById('form-eliminar-fotos-cabana').requestSubmit();
        }

        function eliminarUnaFotoCabana(id) {
            document.getElementById('id-eliminar-una-foto-cabana').value = id;
            document.getElementById('form-eliminar-una-foto-cabana').requestSubmit();
        }
    </script>
}
