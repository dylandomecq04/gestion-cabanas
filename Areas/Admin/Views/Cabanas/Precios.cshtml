@inject Microsoft.Extensions.Options.IOptions<PoliticaPrecios> Politica
@{
    ViewData["Title"] = "Precios";
    var cabanas = (List<Cabana>)ViewBag.Cabanas;
    DateTime primerDia = ViewBag.PrimerDia;
    DateTime mesAnterior = ViewBag.MesAnterior;
    DateTime mesSiguiente = ViewBag.MesSiguiente;
    bool permitirMesAnterior = ViewBag.PermitirMesAnterior;
    decimal? descuentoSalidaAnticipada = ViewBag.DescuentoSalidaAnticipada;
    var minimosNoches = (Dictionary<DateTime, int>)ViewBag.MinimosNoches;
    var promos = (List<PromoEstadia>)ViewBag.PromosEstadia;
    var mesTitulo = primerDia.ToString("MMMM yyyy");
    mesTitulo = char.ToUpper(mesTitulo[0]) + mesTitulo.Substring(1);

    // En el celu no hay lugar para "Lunes a viernes", así que se abrevia.
    string etiquetaCorta(string clave) => clave switch { "Semana" => "Lun a vie", _ => clave == "Sabado" ? "Sábado" : "Domingo" };

    var diasSemana = new[]
    {
        (DayOfWeek.Monday, "Lunes"),
        (DayOfWeek.Tuesday, "Martes"),
        (DayOfWeek.Wednesday, "Miércoles"),
        (DayOfWeek.Thursday, "Jueves"),
        (DayOfWeek.Friday, "Viernes"),
        (DayOfWeek.Saturday, "Sábado"),
        (DayOfWeek.Sunday, "Domingo")
    };

    var hoy = DateTime.Today;
    var diasDelMesMinimo = Enumerable.Range(1, DateTime.DaysInMonth(primerDia.Year, primerDia.Month))
        .Select(d => new DateTime(primerDia.Year, primerDia.Month, d)).ToList();
    int offsetMinimo = ((int)primerDia.DayOfWeek + 6) % 7;
    var celdasMinimo = new List<DateTime?>();
    for (int i = 0; i < offsetMinimo; i++) celdasMinimo.Add(null);
    celdasMinimo.AddRange(diasDelMesMinimo.Select(d => (DateTime?)d));
    while (celdasMinimo.Count % 7 != 0) celdasMinimo.Add(null);
    int indiceMinimo = 0;
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="font-display text-2xl font-semibold text-ink-900">Precios</h1>
        <p class="mt-1 text-sm text-ink-500">@mesTitulo</p>
    </div>
    <div class="flex gap-2">
        @if (permitirMesAnterior)
        {
            <a asp-action="Precios" asp-route-anio="@mesAnterior.Year" asp-route-mes="@mesAnterior.Month"
               class="whitespace-nowrap rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700 sm:px-4 sm:py-2 sm:text-sm">&larr; Mes anterior</a>
        }
        <a asp-action="Precios" asp-route-anio="@mesSiguiente.Year" asp-route-mes="@mesSiguiente.Month"
           class="whitespace-nowrap rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700 sm:px-4 sm:py-2 sm:text-sm">Mes siguiente &rarr;</a>
    </div>
</div>

<div class="rounded-2.5xl bg-white p-4 shadow-soft ring-1 ring-ink-100 sm:p-6">
    <form asp-action="AplicarPreciosPorDiaSemana" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post">
        <div class="mb-5">
            <label class="mb-2 block text-sm font-medium text-ink-700">Cabañas</label>
            <div class="flex flex-wrap gap-2">
                @foreach (var cabana in cabanas)
                {
                    <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-ink-200 px-3.5 py-2 text-sm text-ink-700 transition hover:border-river-300">
                        <input type="checkbox" name="cabanaIds" value="@cabana.Id" data-capacidad="@cabana.Capacidad"
                               onchange="actualizarTramosDisponibles()"
                               class="h-4 w-4 rounded border-ink-300 text-river-700 focus:ring-river-400" />
                        @cabana.Nombre
                    </label>
                }
            </div>
        </div>
        <p class="mb-3 text-sm text-ink-500">
            Precio de la noche según la cantidad de personas que pagan. Con 3 o 5 adultos se cobra el tramo inferior más un recargo
            y los primeros @Politica.Value.MenoresSinCargo menores no suman. Lo que dejes vacío no se modifica.
        </p>
        <div class="overflow-x-auto">
            <table class="w-full text-sm sm:min-w-[420px]">
                <thead>
                    <tr class="text-left text-xs font-semibold uppercase tracking-wide text-ink-400">
                        <th class="py-2 pr-2 sm:pr-3"></th>
                        @foreach (var tramo in Cabana.TodosLosTramos)
                        {
                            <th class="px-1 py-2 transition sm:px-2" data-columna-tramo="@tramo">Para @tramo</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (clave, etiqueta) in new[] { ("Semana", "Lunes a viernes"), ("Sabado", "Sábado"), ("Domingo", "Domingo") })
                    {
                        <tr>
                            <td class="whitespace-nowrap py-1.5 pr-2 font-medium text-ink-700 sm:pr-3"><span class="sm:hidden">@etiquetaCorta(clave)</span><span class="hidden sm:inline">@etiqueta</span></td>
                            @foreach (var tramo in Cabana.TodosLosTramos)
                            {
                                var idReal = $"precio-{clave}-{tramo}-real";
                                <td class="px-1 py-1.5 sm:px-2">
                                    <input type="text" inputmode="numeric" placeholder="$"
                                           data-tramo="@tramo" data-real="@idReal"
                                           oninput="formatearMilesConReal(this, '@idReal')"
                                           class="w-full min-w-0 rounded-xl border border-ink-200 px-1.5 py-2.5 text-sm text-ink-900 shadow-sm transition placeholder:text-xs focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100 disabled:cursor-not-allowed disabled:bg-ink-50 disabled:text-ink-300 sm:px-3.5 sm:placeholder:text-sm" />
                                    <input type="hidden" id="@idReal" name="precio@(clave)@(tramo)" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @foreach (var tramo in Cabana.TodosLosTramos.Where(t => t > 2))
        {
            var admiten = cabanas.Where(c => c.AdmiteTramo(tramo)).Select(c => c.Nombre).ToList();
            if (admiten.Count < cabanas.Count)
            {
                <p class="mt-3 text-xs text-ink-500">
                    El precio para @tramo solo se carga en @(admiten.Count > 0 ? string.Join(", ", admiten) : "ninguna cabaña"):
                    las demás llegan hasta @(tramo - 2) personas.
                </p>
            }
        }
        <div class="mt-4">
            <button type="submit" class="rounded-full bg-river-700 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">
                Aplicar
            </button>
        </div>
    </form>
</div>

<div class="mt-6 rounded-2.5xl bg-white p-4 shadow-soft ring-1 ring-ink-100 sm:p-6">
    <form asp-action="GuardarDescuentoSalidaAnticipada" method="post">
        <input type="hidden" name="anio" value="@primerDia.Year" />
        <input type="hidden" name="mes" value="@primerDia.Month" />
        <h2 class="font-display text-lg font-semibold text-ink-900">Descuento por salir el domingo a la noche</h2>
        <p class="mt-1 text-sm text-ink-500">
            Si la estadía termina un lunes después de sábado y domingo, al reservar el huésped puede elegir salir el domingo
            a la tarde-noche en vez de quedarse hasta el lunes a la mañana, y se le resta este monto del total.
            Cuenta el mes del sábado. Vacío o 0 = no se ofrece esta opción en @mesTitulo.
        </p>
        <div class="mt-4 flex flex-wrap items-end gap-3">
            <div class="w-full sm:w-56">
                <label for="salida-anticipada" class="mb-1 block text-sm font-medium text-ink-700">Monto a descontar</label>
                <input type="text" id="salida-anticipada" inputmode="numeric" placeholder="$"
                       value="@(descuentoSalidaAnticipada.HasValue ? descuentoSalidaAnticipada.Value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-AR")) : "")"
                       oninput="formatearMilesConReal(this, 'salida-anticipada-real')"
                       class="w-full min-w-0 rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
                <input type="hidden" id="salida-anticipada-real" name="monto" value="@(descuentoSalidaAnticipada.HasValue ? ((long)descuentoSalidaAnticipada.Value).ToString() : "")" />
            </div>
            <button type="submit" class="rounded-full bg-river-700 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">
                Guardar
            </button>
        </div>
    </form>
</div>

<div class="mt-6 rounded-2.5xl bg-white p-4 shadow-soft ring-1 ring-ink-100 sm:p-6">
    <h2 class="font-display text-lg font-semibold text-ink-900">Mínimo de noches</h2>
    <p class="mt-1 text-sm text-ink-500">
        Tocá una o varias fechas del mes para seleccionarlas y ponerles un mínimo de noches: si la estadía
        incluye alguna de esas noches, tiene que durar al menos esa cantidad (ej.: sábado 4/10 con mínimo 2
        no deja reservar una sola noche). Si igual fuera imposible llegar al mínimo por reservas ya cargadas
        alrededor, esa fecha no bloquea la reserva. No afecta a las reservas que cargás vos desde el panel.
    </p>

    <form id="form-minimo-noches" asp-action="GuardarMinimoNoches" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post" class="mt-4 grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_260px]">
        <div>
            <div class="grid grid-cols-7 gap-1.5 text-center text-xs font-semibold uppercase tracking-wide text-ink-400">
                <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
            </div>
            <div class="mt-1 grid grid-cols-7 gap-1">
                @foreach (var dia in celdasMinimo)
                {
                    if (dia is null)
                    {
                        <div></div>
                    }
                    else if (dia.Value.Date < hoy)
                    {
                        <div class="flex h-11 items-center justify-center rounded-lg bg-ink-50 text-xs text-ink-300">@dia.Value.Day</div>
                    }
                    else
                    {
                        var minimoActual = minimosNoches.TryGetValue(dia.Value.Date, out var m) ? m : (int?)null;
                        var clasesMinimo = minimoActual.HasValue ? "bg-river-100 text-river-800 hover:bg-river-200" : "text-ink-700 hover:bg-ink-50";

                        <div class="contents">
                            <button type="button" data-index="@indiceMinimo" data-clase-base="@clasesMinimo"
                                    onclick="alternarSeleccionMinimo(this)"
                                    class="dia-minimo-editable relative flex h-11 flex-col items-center justify-center gap-0 rounded-lg font-medium leading-none transition @clasesMinimo">
                                <span class="text-xs opacity-80">@dia.Value.Day</span>
                                <span class="etiqueta-minimo text-[10px] font-bold">@(minimoActual.HasValue ? minimoActual.ToString() : "–")</span>
                            </button>
                            <input type="hidden" name="dias[@indiceMinimo].Fecha" value="@dia.Value.ToString("yyyy-MM-dd")" />
                            <input type="hidden" id="minimo-valor-@indiceMinimo" name="dias[@indiceMinimo].Noches" value="@(minimoActual.HasValue ? minimoActual.ToString() : "")" />
                        </div>
                        indiceMinimo++;
                    }
                }
            </div>
        </div>

        <div class="h-fit rounded-xl border border-ink-200 bg-sand-50 p-4 lg:sticky lg:top-24">
            <p id="texto-seleccion-minimo" class="text-sm font-semibold text-ink-800">0 días seleccionados</p>
            <div class="mt-3">
                <label for="bulk-minimo-noches" class="mb-1 block text-sm font-medium text-ink-700">Cantidad mínima de noches</label>
                <input id="bulk-minimo-noches" type="number" min="1" max="30" step="1" placeholder="Ej: 2"
                       onkeydown="if (event.key === 'Enter') { event.preventDefault(); guardarMinimoSeleccion(); }"
                       class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
            <button type="button" onclick="guardarMinimoSeleccion()" class="mt-3 w-full rounded-full bg-river-700 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">
                Guardar
            </button>
            <button type="button" onclick="cancelarSeleccionMinimo()" class="mt-2 w-full text-xs font-medium text-ink-500 underline underline-offset-2 transition hover:text-ink-700">
                Cancelar selección
            </button>
            <p class="mt-3 text-xs text-ink-400">Dejalo vacío y tocá Guardar para quitar el mínimo de los días elegidos.</p>
        </div>
    </form>

    @{
        var proximosMinimos = minimosNoches.Where(kv => kv.Key.Date >= hoy).OrderBy(kv => kv.Key).ToList();
    }
    @if (proximosMinimos.Count > 0)
    {
        <ul class="mt-5 divide-y divide-ink-100 border-t border-ink-100">
            @foreach (var (fecha, valor) in proximosMinimos)
            {
                <li class="flex flex-wrap items-center justify-between gap-2 py-2.5">
                    <span class="text-sm text-ink-700"><span class="font-medium">@fecha.ToString("dddd d/M")</span>: mínimo @valor noches</span>
                    <form asp-action="EliminarMinimoNoches" method="post">
                        <input type="hidden" name="anio" value="@primerDia.Year" />
                        <input type="hidden" name="mes" value="@primerDia.Month" />
                        <input type="hidden" name="fecha" value="@fecha.ToString("yyyy-MM-dd")" />
                        <button type="submit" class="text-xs font-medium text-red-600 transition hover:text-red-700">Quitar</button>
                    </form>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="mt-4 text-sm text-ink-400">Todavía no hay restricciones cargadas.</p>
    }
</div>

<div class="mt-6 rounded-2.5xl bg-white p-4 shadow-soft ring-1 ring-ink-100 sm:p-6">
    <h2 class="mb-1 font-display text-lg font-semibold text-ink-900">Promociones</h2>
    <p class="mb-4 text-sm text-ink-500">
        Precios especiales por cantidad de noches para un rango de fechas. Se aplican automáticamente cuando alguien reserva
        desde el sitio dentro de ese rango, y las promos vigentes se muestran como cartel de oferta en la página de inicio.
    </p>

    <form asp-action="CrearPromoEstadia" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post" class="space-y-3">
        <div>
            <label class="mb-1 block text-sm font-medium text-ink-700">Cabañas</label>
            <div class="flex flex-wrap gap-2">
                @foreach (var cabana in cabanas)
                {
                    <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-ink-200 px-3.5 py-2 text-sm text-ink-700 transition hover:border-amber-300">
                        <input type="checkbox" name="CabanaIds" value="@cabana.Id"
                               class="h-4 w-4 rounded border-ink-300 text-amber-600 focus:ring-amber-400" />
                        @cabana.Nombre
                    </label>
                }
            </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
            <div>
                <label for="promo-nombre" class="mb-1 block text-sm font-medium text-ink-700">Nombre (opcional)</label>
                <input id="promo-nombre" name="Nombre" maxlength="80" placeholder="Ej: Promo temporada baja"
                       class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
            <div>
                <label for="promo-descripcion" class="mb-1 block text-sm font-medium text-ink-700">Descripción (opcional)</label>
                <input id="promo-descripcion" name="Descripcion" maxlength="300" placeholder="Ej: Reservando 3 noches, la última va por nuestra cuenta"
                       class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
            <div>
                <label for="promo-desde" class="mb-1 block text-sm font-medium text-ink-700">Desde</label>
                <input type="date" id="promo-desde" name="FechaDesde" required
                       class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
            <div>
                <label for="promo-hasta" class="mb-1 block text-sm font-medium text-ink-700">Hasta</label>
                <input type="date" id="promo-hasta" name="FechaHasta" required
                       class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
        </div>

        <div class="grid grid-cols-3 gap-2 sm:gap-3">
            <div>
                <label class="mb-1 block text-sm font-medium text-ink-700">1 noche</label>
                <input type="text" inputmode="numeric" placeholder="$"
                       oninput="formatearMilesConReal(this, 'promo-precio1-real')"
                       class="w-full min-w-0 rounded-xl border border-ink-200 px-2 py-2.5 text-sm text-ink-900 shadow-sm transition placeholder:text-xs focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100 sm:px-3.5 sm:placeholder:text-sm" />
                <input type="hidden" id="promo-precio1-real" name="Precio1Noche" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-ink-700">2 noches</label>
                <input type="text" inputmode="numeric" placeholder="$"
                       oninput="formatearMilesConReal(this, 'promo-precio2-real')"
                       class="w-full min-w-0 rounded-xl border border-ink-200 px-2 py-2.5 text-sm text-ink-900 shadow-sm transition placeholder:text-xs focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100 sm:px-3.5 sm:placeholder:text-sm" />
                <input type="hidden" id="promo-precio2-real" name="Precio2Noches" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-ink-700">3 noches</label>
                <input type="text" inputmode="numeric" placeholder="$"
                       oninput="formatearMilesConReal(this, 'promo-precio3-real')"
                       class="w-full min-w-0 rounded-xl border border-ink-200 px-2 py-2.5 text-sm text-ink-900 shadow-sm transition placeholder:text-xs focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100 sm:px-3.5 sm:placeholder:text-sm" />
                <input type="hidden" id="promo-precio3-real" name="Precio3Noches" />
            </div>
        </div>
        <p class="text-xs text-ink-400">Podés cargar sólo alguno de los precios. Para estadías más largas se cobran las primeras 3 noches a ese precio y el resto al precio normal.</p>

        <div>
            <button type="submit" class="rounded-full bg-amber-500 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-amber-600">
                Crear promoción
            </button>
        </div>
    </form>

    @if (promos.Count == 0)
    {
        <p class="mt-5 text-sm text-ink-400">Todavía no hay promociones cargadas.</p>
    }
    else
    {
        <div class="mt-5 space-y-2 border-t border-ink-100 pt-4">
            @foreach (var promo in promos)
            {
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-ink-100 px-4 py-3 text-sm @(promo.Activa ? "bg-amber-50" : "bg-ink-50 opacity-70")">
                    <div>
                        <p class="font-semibold text-ink-900">
                            @(string.IsNullOrWhiteSpace(promo.Nombre) ? "Promoción" : promo.Nombre) &middot; @promo.Cabana?.Nombre
                        </p>
                        <p class="mt-0.5 text-xs text-ink-500">@promo.FechaDesde.ToString("dd/MM/yyyy") al @promo.FechaHasta.ToString("dd/MM/yyyy")</p>
                        @if (!string.IsNullOrWhiteSpace(promo.Descripcion))
                        {
                            <p class="mt-0.5 text-xs text-ink-500">@promo.Descripcion</p>
                        }
                        <p class="mt-0.5 text-xs text-ink-500">
                            @(promo.Precio1Noche.HasValue ? "1 noche: $" + promo.Precio1Noche.Value.ToString("N0") : "1 noche: -")
                            &middot; @(promo.Precio2Noches.HasValue ? "2 noches: $" + promo.Precio2Noches.Value.ToString("N0") : "2 noches: -")
                            &middot; @(promo.Precio3Noches.HasValue ? "3 noches: $" + promo.Precio3Noches.Value.ToString("N0") : "3 noches: -")
                            @if (!promo.Activa)
                            {
                                <span class="font-semibold text-ink-400"> · Inactiva</span>
                            }
                        </p>
                    </div>
                    <div class="flex shrink-0 gap-2">
                        <form asp-action="AlternarPromoEstadiaEnPrecios" asp-route-id="@promo.Id" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post">
                            <button type="submit" class="rounded-full border border-ink-200 px-3.5 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700">
                                @(promo.Activa ? "Desactivar" : "Activar")
                            </button>
                        </form>
                        <form asp-action="EliminarPromoEstadiaEnPrecios" asp-route-id="@promo.Id" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post" onsubmit="return confirm('¿Eliminar esta promoción?');">
                            <button type="submit" class="rounded-full border border-rose-200 px-3.5 py-1.5 text-xs font-medium text-rose-600 transition hover:border-rose-300 hover:bg-rose-50">
                                Eliminar
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function formatearMilesConReal(input, idCampoReal) {
            const soloDigitos = input.value.replace(/\D/g, '');
            input.value = soloDigitos ? Number(soloDigitos).toLocaleString('es-AR') : '';
            document.getElementById(idCampoReal).value = soloDigitos;
        }

        // Un tramo (ej. "para 6") solo tiene sentido en cabañas con lugar para tantas personas. Si
        // entre las cabañas tildadas ninguna lo admite, esa columna se deshabilita y se vacía.
        function tramoAdmitido(tramo, capacidad) {
            return tramo <= 2 || capacidad > tramo - 2;
        }

        function actualizarTramosDisponibles() {
            const marcadas = [...document.querySelectorAll('input[name="cabanaIds"]:checked')];

            [4, 6].forEach(tramo => {
                const habilitado = marcadas.length === 0
                    || marcadas.some(c => tramoAdmitido(tramo, Number(c.dataset.capacidad)));

                document.querySelectorAll(`input[data-tramo="${tramo}"]`).forEach(input => {
                    input.disabled = !habilitado;
                    input.placeholder = habilitado ? '$' : 'No aplica';
                    if (!habilitado) {
                        input.value = '';
                        document.getElementById(input.dataset.real).value = '';
                    }
                });
                const encabezado = document.querySelector(`th[data-columna-tramo="${tramo}"]`);
                if (encabezado) {
                    encabezado.classList.toggle('opacity-40', !habilitado);
                }
            });
        }

        const seleccionMinimo = new Set();

        // Mismo estilo de "punta seleccionada" que ya usan los calendarios públicos: círculo verde relleno.
        function limpiarClaseSeleccionMinimo(btn) {
            btn.classList.remove('bg-river-700', 'text-white', 'rounded-full', 'font-bold', 'ring-4', 'ring-river-200');
            btn.classList.add('rounded-lg');
            (btn.dataset.claseBase || '').split(' ').filter(Boolean).forEach(c => btn.classList.add(c));
        }

        function aplicarClaseSeleccionMinimo(btn) {
            (btn.dataset.claseBase || '').split(' ').filter(Boolean).forEach(c => btn.classList.remove(c));
            btn.classList.remove('rounded-lg');
            btn.classList.add('bg-river-700', 'text-white', 'rounded-full', 'font-bold', 'ring-4', 'ring-river-200');
        }

        function alternarSeleccionMinimo(btn) {
            const idx = btn.dataset.index;
            if (seleccionMinimo.has(idx)) {
                seleccionMinimo.delete(idx);
                limpiarClaseSeleccionMinimo(btn);
            } else {
                seleccionMinimo.add(idx);
                aplicarClaseSeleccionMinimo(btn);
            }
            actualizarContadorSeleccionMinimo();
        }

        function actualizarContadorSeleccionMinimo() {
            const cantidad = seleccionMinimo.size;
            document.getElementById('texto-seleccion-minimo').textContent =
                cantidad + (cantidad === 1 ? ' día seleccionado' : ' días seleccionados');
        }

        function cancelarSeleccionMinimo() {
            seleccionMinimo.forEach(idx => {
                const btn = document.querySelector(`.dia-minimo-editable[data-index="${idx}"]`);
                if (btn) limpiarClaseSeleccionMinimo(btn);
            });
            seleccionMinimo.clear();
            document.getElementById('bulk-minimo-noches').value = '';
            actualizarContadorSeleccionMinimo();
        }

        // Deja vacío el campo y guardá para quitar el mínimo de los días elegidos.
        function guardarMinimoSeleccion() {
            if (seleccionMinimo.size === 0) return;

            const valor = document.getElementById('bulk-minimo-noches').value.replace(/\D/g, '');
            seleccionMinimo.forEach(idx => {
                const input = document.getElementById('minimo-valor-' + idx);
                if (input) input.value = valor;
            });

            document.getElementById('form-minimo-noches').requestSubmit();
        }
    </script>
}
