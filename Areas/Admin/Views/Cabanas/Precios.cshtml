@inject Microsoft.Extensions.Options.IOptions<PoliticaPrecios> Politica
@{
    ViewData["Title"] = "Precios";
    var cabanas = (List<Cabana>)ViewBag.Cabanas;
    DateTime primerDia = ViewBag.PrimerDia;
    DateTime mesAnterior = ViewBag.MesAnterior;
    DateTime mesSiguiente = ViewBag.MesSiguiente;
    bool permitirMesAnterior = ViewBag.PermitirMesAnterior;
    var mesTitulo = primerDia.ToString("MMMM yyyy");
    mesTitulo = char.ToUpper(mesTitulo[0]) + mesTitulo.Substring(1);
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="font-display text-2xl font-semibold text-ink-900">Precios</h1>
        <p class="mt-1 text-sm text-ink-500">@mesTitulo</p>
    </div>
    <div class="flex gap-2">
        @if (permitirMesAnterior)
        {
            <a asp-action="Precios" asp-route-anio="@mesAnterior.Year" asp-route-mes="@mesAnterior.Month"
               class="rounded-full border border-ink-200 px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700">&larr; Mes anterior</a>
        }
        <a asp-action="Precios" asp-route-anio="@mesSiguiente.Year" asp-route-mes="@mesSiguiente.Month"
           class="rounded-full border border-ink-200 px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700">Mes siguiente &rarr;</a>
    </div>
</div>

<div class="rounded-2.5xl bg-white p-6 shadow-soft ring-1 ring-ink-100">
    <form asp-action="AplicarPreciosPorDiaSemana" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post">
        <div class="mb-5">
            <label class="mb-2 block text-sm font-medium text-ink-700">Cabañas</label>
            <div class="flex flex-wrap gap-2">
                @foreach (var cabana in cabanas)
                {
                    <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-ink-200 px-3.5 py-2 text-sm text-ink-700 transition hover:border-river-300">
                        <input type="checkbox" name="cabanaIds" value="@cabana.Id" data-capacidad="@cabana.Capacidad"
                               onchange="actualizarTramosDisponibles()"
                               class="h-4 w-4 rounded border-ink-300 text-river-700 focus:ring-river-400" />
                        @cabana.Nombre
                    </label>
                }
            </div>
        </div>
        <p class="mb-3 text-sm text-ink-500">
            Precio de la noche según la cantidad de personas que pagan. Con 3 o 5 adultos se cobra el tramo inferior más un recargo
            y los primeros @Politica.Value.MenoresSinCargo menores no suman. Lo que dejes vacío no se modifica.
        </p>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[420px] text-sm">
                <thead>
                    <tr class="text-left text-xs font-semibold uppercase tracking-wide text-ink-400">
                        <th class="py-2 pr-3"></th>
                        @foreach (var tramo in Cabana.TodosLosTramos)
                        {
                            <th class="px-2 py-2 transition" data-columna-tramo="@tramo">Para @tramo</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (clave, etiqueta) in new[] { ("Semana", "Lunes a viernes"), ("Sabado", "Sábado"), ("Domingo", "Domingo") })
                    {
                        <tr>
                            <td class="py-1.5 pr-3 font-medium text-ink-700">@etiqueta</td>
                            @foreach (var tramo in Cabana.TodosLosTramos)
                            {
                                var idReal = $"precio-{clave}-{tramo}-real";
                                <td class="px-2 py-1.5">
                                    <input type="text" inputmode="numeric" placeholder="$"
                                           data-tramo="@tramo" data-real="@idReal"
                                           oninput="formatearMilesConReal(this, '@idReal')"
                                           class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100 disabled:cursor-not-allowed disabled:bg-ink-50 disabled:text-ink-300" />
                                    <input type="hidden" id="@idReal" name="precio@(clave)@(tramo)" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @foreach (var tramo in Cabana.TodosLosTramos.Where(t => t > 2))
        {
            var admiten = cabanas.Where(c => c.AdmiteTramo(tramo)).Select(c => c.Nombre).ToList();
            if (admiten.Count < cabanas.Count)
            {
                <p class="mt-3 text-xs text-ink-500">
                    El precio para @tramo solo se carga en @(admiten.Count > 0 ? string.Join(", ", admiten) : "ninguna cabaña"):
                    las demás llegan hasta @(tramo - 2) personas.
                </p>
            }
        }
        <div class="mt-4">
            <button type="submit" class="rounded-full bg-river-700 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">
                Aplicar
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function formatearMilesConReal(input, idCampoReal) {
            const soloDigitos = input.value.replace(/\D/g, '');
            input.value = soloDigitos ? Number(soloDigitos).toLocaleString('es-AR') : '';
            document.getElementById(idCampoReal).value = soloDigitos;
        }

        // Un tramo (ej. "para 6") solo tiene sentido en cabañas con lugar para tantas personas. Si
        // entre las cabañas tildadas ninguna lo admite, esa columna se deshabilita y se vacía.
        function tramoAdmitido(tramo, capacidad) {
            return tramo <= 2 || capacidad > tramo - 2;
        }

        function actualizarTramosDisponibles() {
            const marcadas = [...document.querySelectorAll('input[name="cabanaIds"]:checked')];

            [4, 6].forEach(tramo => {
                const habilitado = marcadas.length === 0
                    || marcadas.some(c => tramoAdmitido(tramo, Number(c.dataset.capacidad)));

                document.querySelectorAll(`input[data-tramo="${tramo}"]`).forEach(input => {
                    input.disabled = !habilitado;
                    input.placeholder = habilitado ? '$' : 'No aplica';
                    if (!habilitado) {
                        input.value = '';
                        document.getElementById(input.dataset.real).value = '';
                    }
                });
                const encabezado = document.querySelector(`th[data-columna-tramo="${tramo}"]`);
                if (encabezado) {
                    encabezado.classList.toggle('opacity-40', !habilitado);
                }
            });
        }
    </script>
}
