@using GestionCabanas.Models
@{
    ViewData["Title"] = "Sincronización con Excel";
    bool configurado = ViewBag.Configurado;
    var conexion = ViewBag.Conexion as OneDriveConexion;
    int anioSugerido = ViewBag.AnioSugerido;

    int? creadas = TempData["ResultadoCreadas"] as int?;
    int? omitidas = TempData["ResultadoOmitidas"] as int?;
    string? noInterpretadas = TempData["ResultadoNoInterpretadas"] as string;
    string? cabanasNoEncontradas = TempData["ResultadoCabanasNoEncontradas"] as string;
    string? superposiciones = TempData["ResultadoSuperposiciones"] as string;
}

<h1 class="mb-2 font-display text-2xl font-semibold text-ink-900">Sincronización con Excel</h1>
<p class="mb-6 max-w-2xl text-sm text-ink-500">
    Conectá tu cuenta de OneDrive una vez y después, cada vez que quieras, apretá "Sincronizar ahora" para traer
    al sistema las reservas nuevas que hayas cargado en tu Excel de siempre.
</p>

@if (!configurado)
{
    <div class="max-w-2xl rounded-2.5xl bg-amber-50 p-5 text-sm text-amber-800 ring-1 ring-amber-200">
        Todavía falta terminar de configurar la conexión con Microsoft (Client ID / Client Secret). Avisale a Dylan.
    </div>
}
else
{
    @if (creadas.HasValue)
    {
        <div class="mb-6 max-w-2xl rounded-2.5xl bg-river-50 p-5 text-sm text-river-800 ring-1 ring-river-100">
            <p class="font-semibold">Resultado de la última sincronización</p>
            <p class="mt-1">✅ @creadas reserva(s) nueva(s) creada(s)</p>
            <p>↪️ @omitidas reserva(s) que ya existían (se omitieron)</p>
            @if (!string.IsNullOrEmpty(cabanasNoEncontradas))
            {
                <p class="mt-2 text-amber-700">⚠️ No encontré estas cabañas en el sistema: @cabanasNoEncontradas</p>
            }
            @if (!string.IsNullOrEmpty(noInterpretadas))
            {
                <details class="mt-2">
                    <summary class="cursor-pointer text-amber-700">⚠️ Filas que no pude interpretar (clic para ver)</summary>
                    <p class="mt-1 text-xs text-ink-600">@noInterpretadas</p>
                </details>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(superposiciones))
    {
        <div class="mb-6 max-w-2xl rounded-2.5xl bg-rose-50 p-5 text-sm text-rose-800 ring-1 ring-rose-200">
            <p class="font-semibold">🚨 Hay fechas que se superponen en la misma cabaña</p>
            <p class="mt-1 text-rose-700">Revisá estas reservas y cancelá la que no corresponda:</p>
            <ul class="mt-2 list-disc space-y-1 pl-5">
                @foreach (var linea in superposiciones.Split(" | "))
                {
                    <li>@linea</li>
                }
            </ul>
        </div>
    }

    @if (conexion?.RefreshTokenCifrado is null)
    {
        <div class="max-w-2xl rounded-2.5xl bg-white p-6 shadow-soft ring-1 ring-ink-100">
            <p class="mb-4 text-sm text-ink-600">Todavía no conectaste tu cuenta de OneDrive.</p>
            <a asp-action="Conectar" class="inline-flex items-center gap-2 rounded-full bg-river-700 px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">
                Conectar con OneDrive
            </a>
        </div>
    }
    else
    {
        <div class="max-w-2xl rounded-2.5xl bg-white p-6 shadow-soft ring-1 ring-ink-100">
            <div class="mb-5 flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-ink-800">✅ Cuenta de OneDrive conectada</p>
                    <p class="text-xs text-ink-500">
                        Conectada desde @(conexion.FechaConexion?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        @if (conexion.UltimaSincronizacion.HasValue)
                        {
                            <text> · Última sincronización: @conexion.UltimaSincronizacion.Value.ToString("dd/MM/yyyy HH:mm")</text>
                        }
                    </p>
                </div>
                <form asp-action="Desconectar" method="post" onsubmit="return confirm('¿Desconectar la cuenta de OneDrive?');">
                    <button type="submit" class="rounded-full border border-rose-200 px-4 py-2 text-xs font-semibold text-rose-600 transition hover:bg-rose-50">Desconectar</button>
                </form>
            </div>

            <form asp-action="Sincronizar" method="post" class="flex flex-wrap items-end gap-3">
                <div>
                    <label class="mb-1 block text-xs font-medium text-ink-600">Año de las pestañas del Excel</label>
                    <input type="number" name="anio" value="@anioSugerido" min="2020" max="2100"
                           class="w-32 rounded-xl border border-ink-200 px-3.5 py-2 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
                </div>
                <button type="submit" class="rounded-full bg-river-700 px-6 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">
                    🔄 Sincronizar ahora
                </button>
            </form>
            <p class="mt-3 text-xs text-ink-400">
                Las reservas que ya estén cargadas (misma cabaña, huésped y fechas) no se van a duplicar.
            </p>
        </div>
    }
}
