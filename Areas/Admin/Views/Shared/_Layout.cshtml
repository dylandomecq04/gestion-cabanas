<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Panel de administración</title>
    <partial name="_TailwindConfig" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-sand-50 text-ink-900 antialiased">
    <header class="sticky top-0 z-40 border-b border-ink-100 bg-ink-950 text-white">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
            <a asp-area="Admin" asp-controller="Reservas" asp-action="Index" class="flex items-center gap-2 font-display text-base font-semibold">
                <img src="~/images/logo-sidharta.png" alt="Cabañas Sidharta" class="h-9 w-9 rounded-xl" />
                <span class="hidden sm:inline">Cabañas Sidharta &middot; Admin</span>
                <span class="sm:hidden">Admin</span>
            </a>

            <nav class="hidden items-center gap-1 md:flex">
                <a asp-area="Admin" asp-controller="Reservas" asp-action="Index"
                   class="relative flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">
                    Solicitudes y reservas
                    @await Component.InvokeAsync("PendientesBadge")
                </a>
                <a asp-area="Admin" asp-controller="Reservas" asp-action="Calendario"
                   class="rounded-full px-4 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Calendario</a>
                <a asp-area="Admin" asp-controller="Cabanas" asp-action="Index"
                   class="rounded-full px-4 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Cabañas</a>
                <a asp-area="Admin" asp-controller="Informacion" asp-action="Index"
                   class="rounded-full px-4 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Información</a>
                <a asp-area="Admin" asp-controller="Promociones" asp-action="Index"
                   class="rounded-full px-4 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Promociones</a>
                <a asp-area="Admin" asp-controller="Sincronizacion" asp-action="Index"
                   class="rounded-full px-4 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Sincronización</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank"
                   class="ml-1 rounded-full border border-white/20 px-4 py-2 text-sm font-medium text-ink-200 transition hover:border-white/40 hover:text-white">Ver sitio público</a>
            </nav>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="flex items-center gap-3">
                    <span class="hidden text-sm text-ink-300 sm:inline">@User.Identity!.Name</span>
                    <button type="submit" class="rounded-full border border-white/20 px-4 py-2 text-sm font-medium text-white transition hover:bg-white/10">Salir</button>
                </form>
            }
        </div>
        <nav class="flex items-center gap-1 overflow-x-auto border-t border-white/10 px-4 py-2 md:hidden">
            <a asp-area="Admin" asp-controller="Reservas" asp-action="Index" class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Reservas</a>
            <a asp-area="Admin" asp-controller="Reservas" asp-action="Calendario" class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Calendario</a>
            <a asp-area="Admin" asp-controller="Cabanas" asp-action="Index" class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Cabañas</a>
            <a asp-area="Admin" asp-controller="Informacion" asp-action="Index" class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Información</a>
            <a asp-area="Admin" asp-controller="Promociones" asp-action="Index" class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Promociones</a>
            <a asp-area="Admin" asp-controller="Sincronizacion" asp-action="Index" class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Sincronización</a>
            <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Sitio público</a>
        </nav>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
        @RenderBody()
    </main>

    @if (TempData["Mensaje"] != null)
    {
        <div id="mensaje-flash" class="fixed bottom-5 left-5 z-50 max-w-xs rounded-xl bg-river-50 px-4 py-3 text-sm font-medium text-river-800 shadow-lift ring-1 ring-river-100 transition-opacity duration-700">@TempData["Mensaje"]</div>
        <script>
            setTimeout(function () {
                var el = document.getElementById('mensaje-flash');
                if (el) {
                    el.style.opacity = '0';
                    setTimeout(function () { el.remove(); }, 700);
                }
            }, 3000);
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
