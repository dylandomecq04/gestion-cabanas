<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Panel de administración</title>
    <partial name="_TailwindConfig" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-sand-50 text-ink-900 antialiased">
    <header class="sticky top-0 z-40 border-b border-ink-100 bg-ink-950 text-white">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
            <a asp-area="Admin" asp-controller="Reservas" asp-action="Calendario" class="flex shrink-0 items-center gap-2 font-display text-base font-semibold">
                <img src="~/images/logo-sidharta.png" alt="Cabañas Sidharta" class="h-9 w-9 rounded-xl" />
                <span class="hidden whitespace-nowrap sm:inline">Cabañas Sidharta &middot; Admin</span>
                <span class="sm:hidden">Admin</span>
            </a>


            <div class="flex shrink-0 items-center gap-2">
            <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" title="Ver sitio público"
                   class="hidden shrink-0 items-center gap-1.5 md:inline-flex whitespace-nowrap rounded-full border border-white/20 px-3 py-2 text-sm font-medium text-ink-200 transition hover:border-white/40 hover:text-white">Ver sitio
                    <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 3h6v6M17 3l-8 8M8 5H4.5A1.5 1.5 0 0 0 3 6.5v9A1.5 1.5 0 0 0 4.5 17h9a1.5 1.5 0 0 0 1.5-1.5V12"/></svg></a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="flex shrink-0 items-center gap-3" data-skip-loading>
                    <span class="hidden whitespace-nowrap text-sm text-ink-300 xl:inline">@User.Identity!.Name</span>
                    <button type="submit" class="whitespace-nowrap rounded-full border border-white/20 px-4 py-2 text-sm font-medium text-white transition hover:bg-white/10">Salir</button>
                </form>
            }
            </div>
        </div>
            <nav class="mx-auto hidden max-w-7xl flex-wrap items-center justify-center gap-x-0.5 gap-y-1 border-t border-white/10 px-4 py-2 md:flex sm:px-6">
                <a asp-area="Admin" asp-controller="Reservas" asp-action="Index"
                   class="relative flex whitespace-nowrap items-center gap-1.5 rounded-full px-3 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">
                    Reservas
                    @await Component.InvokeAsync("PendientesBadge")
                </a>
                <a asp-area="Admin" asp-controller="Reservas" asp-action="Calendario"
                   class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Calendario</a>
                <a asp-area="Admin" asp-controller="Cabanas" asp-action="Precios"
                   class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Precios</a>
                <a asp-area="Admin" asp-controller="FinesDeSemanaLargos" asp-action="Index"
                   class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Finde largo</a>
                <a asp-area="Admin" asp-controller="Cabanas" asp-action="Index"
                   class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Cabañas</a>
                <a asp-area="Admin" asp-controller="Inicio" asp-action="Index"
                   class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Inicio</a>
                <a asp-area="Admin" asp-controller="Galeria" asp-action="Index"
                   class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Galería</a>
                <a asp-area="Admin" asp-controller="Informacion" asp-action="Index"
                   class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Información</a>
                <a asp-area="Admin" asp-controller="MensajesWhatsApp" asp-action="Index"
                   class="whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-ink-200 transition hover:bg-white/10 hover:text-white">Mensajes WhatsApp</a>

            </nav>
        <nav class="flex flex-wrap items-center justify-center gap-x-1 gap-y-0.5 border-t border-white/10 px-3 py-1.5 md:hidden">
            <a asp-area="Admin" asp-controller="Reservas" asp-action="Index" class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Reservas</a>
            <a asp-area="Admin" asp-controller="Reservas" asp-action="Calendario" class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Calendario</a>
            <a asp-area="Admin" asp-controller="Cabanas" asp-action="Precios" class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Precios</a>
            <a asp-area="Admin" asp-controller="FinesDeSemanaLargos" asp-action="Index" class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Finde largo</a>
            <a asp-area="Admin" asp-controller="Cabanas" asp-action="Index" class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Cabañas</a>
            <a asp-area="Admin" asp-controller="Inicio" asp-action="Index" class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Inicio</a>
            <a asp-area="Admin" asp-controller="Galeria" asp-action="Index" class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Galería</a>
            <a asp-area="Admin" asp-controller="Informacion" asp-action="Index" class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Información</a>
            <a asp-area="Admin" asp-controller="MensajesWhatsApp" asp-action="Index" class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Mensajes WhatsApp</a>
            <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-ink-200 hover:bg-white/10 hover:text-white">Sitio público</a>
        </nav>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
        @RenderBody()
    </main>

    <div id="overlay-cargando" class="hidden fixed inset-0 z-[70] flex items-center justify-center bg-ink-950/50 p-4 backdrop-blur-sm">
        <div class="w-full max-w-xs rounded-2.5xl bg-white p-5 text-center shadow-lift sm:p-6">
            <svg class="mx-auto h-8 w-8 animate-spin text-river-700" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <p id="overlay-cargando-texto" class="mt-3 text-sm font-medium text-ink-700">Guardando...</p>
            <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-ink-100">
                <div id="overlay-cargando-barra" class="h-full w-0 rounded-full bg-river-700 transition-[width] duration-200 ease-out"></div>
            </div>
        </div>
    </div>

    <div id="modal-confirmacion" class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-ink-950/40 p-4 backdrop-blur-sm" onclick="if (event.target === this) cerrarModalConfirmacion();">
        <div class="max-h-[90vh] w-full max-w-sm overflow-y-auto rounded-2.5xl bg-white p-5 shadow-lift sm:p-6">
            <div class="flex items-start gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-rose-50 text-rose-600">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-5 w-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                </span>
                <div class="pt-1.5">
                    <h3 class="font-display text-base font-semibold text-ink-900">Confirmar acción</h3>
                    <p id="modal-confirmacion-mensaje" class="mt-1 text-sm text-ink-600"></p>
                </div>
            </div>
            <div class="mt-5 flex justify-end gap-2">
                <button type="button" onclick="cerrarModalConfirmacion()" class="rounded-full border border-ink-200 px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-ink-300">Cancelar</button>
                <button type="button" id="modal-confirmacion-boton" class="rounded-full bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-soft transition hover:bg-rose-700">Confirmar</button>
            </div>
        </div>
    </div>
    <script>
        let __formPendienteConfirmacion = null;

        function mostrarConfirmacion(mensaje, form) {
            __formPendienteConfirmacion = form;
            document.getElementById('modal-confirmacion-mensaje').textContent = mensaje;
            document.getElementById('modal-confirmacion').classList.remove('hidden');
        }

        function confirmarAccion(event, mensaje) {
            event.preventDefault();
            mostrarConfirmacion(mensaje, event.target.closest('form'));
            return false;
        }

        function cerrarModalConfirmacion() {
            document.getElementById('modal-confirmacion').classList.add('hidden');
            __formPendienteConfirmacion = null;
        }

        document.getElementById('modal-confirmacion-boton').addEventListener('click', function () {
            const form = __formPendienteConfirmacion;
            cerrarModalConfirmacion();
            if (form) mostrarCargando(form);
            if (form) form.submit();
        });

        let __intervaloCargando = null;

        function mostrarCargando(form) {
            const overlay = document.getElementById('overlay-cargando');
            const barra = document.getElementById('overlay-cargando-barra');
            const texto = document.getElementById('overlay-cargando-texto');

            texto.textContent = form.dataset.loadingText || 'Guardando...';
            barra.style.width = '0%';
            overlay.classList.remove('hidden');

            const boton = form.querySelector('button[type="submit"]');
            if (boton) boton.disabled = true;

            let porcentaje = 0;
            clearInterval(__intervaloCargando);
            __intervaloCargando = setInterval(function () {
                porcentaje += (92 - porcentaje) * 0.1;
                barra.style.width = Math.min(porcentaje, 92) + '%';
            }, 200);
        }

        document.addEventListener('submit', function (event) {
            if (event.defaultPrevented) return;
            const form = event.target;
            if (!(form instanceof HTMLFormElement)) return;
            if (form.hasAttribute('data-skip-loading')) return;
            mostrarCargando(form);
        }, false);
    </script>

    @if (TempData["Mensaje"] != null)
    {
        <div id="mensaje-flash" class="fixed inset-x-4 bottom-4 z-50 rounded-xl sm:inset-x-auto sm:bottom-5 sm:left-5 sm:max-w-xs sm:rounded-xl bg-river-50 px-4 py-3 text-sm font-medium text-river-800 shadow-lift ring-1 ring-river-100 transition-opacity duration-700">@TempData["Mensaje"]</div>
        <script>
            setTimeout(function () {
                var el = document.getElementById('mensaje-flash');
                if (el) {
                    el.style.opacity = '0';
                    setTimeout(function () { el.remove(); }, 700);
                }
            }, 3000);
        </script>
    }

    @if (TempData["Alerta"] != null)
    {
        <div id="modal-alerta" class="fixed inset-0 z-[80] flex items-center justify-center bg-ink-950/60 p-4 backdrop-blur-sm" role="alertdialog" aria-modal="true" aria-labelledby="modal-alerta-titulo">
            <div class="max-h-[90vh] w-full max-w-md overflow-y-auto rounded-2.5xl bg-white p-5 text-center shadow-lift ring-2 ring-rose-500 sm:p-6">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-rose-100 text-rose-600">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-8 w-8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                    </svg>
                </span>
                <h3 id="modal-alerta-titulo" class="mt-4 font-display text-lg font-semibold text-rose-700">No se realizó la acción</h3>
                <p class="mt-2 text-sm font-medium text-ink-700">@TempData["Alerta"]</p>
                <button type="button" id="modal-alerta-boton" onclick="document.getElementById('modal-alerta').remove();" class="mt-6 rounded-full bg-rose-600 px-6 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:bg-rose-700">Entendido</button>
            </div>
        </div>
        <script>
            document.getElementById('modal-alerta-boton').focus();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
