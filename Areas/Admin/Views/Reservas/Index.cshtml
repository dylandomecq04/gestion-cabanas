@model List<Reserva>
@using PhoneNumbers
@{
    ViewData["Title"] = "Reservas";
    EstadoReserva filtro = ViewBag.EstadoFiltro;
    bool esSolicitudes = filtro == EstadoReserva.Pendiente;
    string? busqueda = ViewBag.Busqueda;
    int? cabanaIdFiltro = ViewBag.CabanaIdFiltro;
    var cabanas = (List<Cabana>)ViewBag.Cabanas;
    DateTime? primerDia = ViewBag.PrimerDia;
    DateTime? mesAnterior = ViewBag.MesAnterior;
    DateTime? mesSiguiente = ViewBag.MesSiguiente;
    List<DateTime> mesesConSolicitudes = esSolicitudes ? (List<DateTime>)ViewBag.MesesConSolicitudes : new();

    string ClasesTab(bool activo) => activo
        ? "rounded-full bg-river-700 px-4 py-2 text-sm font-semibold text-white shadow-soft"
        : "rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700";

    string TituloMes(DateTime dia)
    {
        var texto = dia.ToString("MMMM yyyy");
        return char.ToUpper(texto[0]) + texto.Substring(1);
    }

    // Las solicitudes se muestran todas juntas (la más nueva primero, según cuándo se cargaron),
    // sin agrupar por cabaña. Las reservas confirmadas siguen agrupadas por cabaña y ordenadas por fecha de estadía.
    var grupos = esSolicitudes
        ? new[] { ("", Model.OrderByDescending(r => r.FechaCreacion).AsEnumerable()) }
        : Model.GroupBy(r => r.Cabana?.Nombre ?? "Sin cabaña").OrderBy(g => g.Key)
            .Select(g => (g.Key, g.OrderBy(r => r.FechaDesde).AsEnumerable()));

    string LinkWhatsApp(Reserva r)
    {
        var digitos = DigitosWhatsApp(r);
        if (digitos == "") return "";
        var mensaje = $"Hola, cómo estás?\n\nRecibí tu solicitud de reserva para el período del {r.FechaDesde:dd/MM/yyyy} al {r.FechaHasta:dd/MM/yyyy}, a nombre de {r.NombreHuesped}. Te escribo para coordinar y confirmar la misma.\n\nPara poder mantener la reserva, contás con un plazo de 24 horas para realizar el pago. A continuación, te envío los datos de la cuenta.\n\nUna vez efectuado el pago, por favor enviame el comprobante para poder continuar con la confirmación de la reserva.\n\nMuchas gracias!";
        return $"https://wa.me/{digitos}?text={Uri.EscapeDataString(mensaje)}";
    }

    string DigitosWhatsApp(Reserva r)
    {
        if (string.IsNullOrWhiteSpace(r.Telefono)) return "";
        try
        {
            var util = PhoneNumberUtil.GetInstance();
            var numero = util.Parse(r.Telefono, "AR");
            if (!util.IsValidNumber(numero)) return "";
            if (numero.CountryCode == 54)
            {
                // Los huéspedes son personas con celular: forzamos el "9" de
                // WhatsApp aunque el teléfono se haya cargado sin el 15 ni el 9.
                var nacional = util.GetNationalSignificantNumber(numero);
                if (nacional.StartsWith("9")) nacional = nacional.Substring(1);
                return "549" + nacional;
            }
            return util.Format(numero, PhoneNumberFormat.E164).TrimStart('+');
        }
        catch (NumberParseException)
        {
            return "";
        }
    }

    string LinkWhatsAppConfirmacion(Reserva r)
    {
        var digitos = DigitosWhatsApp(r);
        if (digitos == "") return "";
        return $"https://wa.me/{digitos}?text={Uri.EscapeDataString(MensajeConfirmacion(r))}";
    }

    string MensajeConfirmacion(Reserva r)
    {
        var personasTexto = $"{r.CantidadPersonas} {(r.CantidadPersonas == 1 ? "persona" : "personas")}"
            + (r.CantidadMenores > 0 ? $" ({r.CantidadMenores} menor{(r.CantidadMenores == 1 ? "" : "es")})" : "");
        var pendiente = r.Valor.HasValue ? "$" + r.Valor.Value.ToString("N0") : "a confirmar";
        // Sidharta 1, 2 y 3 comparten una clave de wifi; Sidharta 5 y Maia (ex Sidharta 4) usan la otra.
        var claveWifi = r.Cabana?.Nombre is "Sidharta 1" or "Sidharta 2" or "Sidharta 3" ? "26114842" : "12122012";

        return $"Hola, cómo estás?\n\n" +
            $"Tu reserva en Cabañas Sidharta quedó confirmada, a nombre de {r.NombreHuesped}, para el período del {r.FechaDesde:dd/MM/yyyy} al {r.FechaHasta:dd/MM/yyyy}, para {personasTexto}.\n\n" +
            $"Ingreso: 12:00 hs. Salida: 10:00 hs.\n" +
            $"Queda pendiente pagar: {pendiente}.\n\n" +
            "Cuando puedas, pasame nombre, apellido y DNI de las personas que se van a hospedar, menores incluidos.\n\n" +
            "Recordá traer: repasador, sábanas, toallones y toalla de mano.\n\n" +
            "*WiFi*\n" +
            $"Red: Sidharta\nClave: {claveWifi}\n\n" +
            "*Reglamento de la pileta*\n" +
            "- Horario: de 10 a 20 hs\n" +
            "- Prohibido el alcohol\n" +
            "- Prohibida la música\n" +
            "- Prohibido zambullirse\n" +
            "- Los menores de 12 años no pueden estar sin la supervisión de un adulto\n\n" +
            "*Cómo llegar*\n" +
            "Arroyo Abra Vieja 230\n\n" +
            "*Opción 1: lancha remis*\n" +
            "Sale desde la Guardería Poseidón (Colón 10, San Fernando) y tarda 15 minutos.\n" +
            "Beto: +54 9 11 5618-7841\n" +
            "Leo: +54 9 11 6382-2361\n" +
            "En el GPS poné \"Colón 10, San Fernando\".\n\n" +
            "*Opción 2: en auto*\n" +
            "1. Desde el ramal Tigre, bajá en la salida de la RP 197.\n" +
            "2. Doblá a la derecha por la 197; vas a pasar por debajo de las vías, cerca de la estación Carupá.\n" +
            "3. Seguí por avenida Colón, cruzás otra vía (la del Tren de la Costa) y continuás derecho.\n" +
            "4. Después de esa vía empieza un empedrado; a la izquierda vas a ver un canal. Seguilo hasta el final de la calle.\n" +
            "5. La calle termina en una rotonda chica sobre el río Luján: a la izquierda está Prefectura, a la derecha la Guardería Poseidón y después un muelle público, donde paran las lanchas remis. Avisales que van a Cabañas Sidharta/Maia.\n\n" +
            "Estacionamiento: podés dejar el auto en cualquier lugar, menos en la puerta de la guardería.\n\n" +
            "Muchas gracias!";
    }
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-display text-2xl font-semibold text-ink-900">Reservas</h1>
    @if (filtro == EstadoReserva.Pendiente)
    {
        <a asp-action="Create" asp-route-estado="@EstadoReserva.Pendiente" class="whitespace-nowrap rounded-full bg-sky-500 px-4 py-2 text-sm sm:px-5 sm:py-2.5 font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-sky-600">+ Cargar solicitud</a>
    }
    else
    {
        <a asp-action="Create" asp-route-estado="@EstadoReserva.Confirmada" class="whitespace-nowrap rounded-full bg-river-700 px-4 py-2 text-sm sm:px-5 sm:py-2.5 font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">+ Cargar reserva</a>
    }
</div>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-2">
        <a asp-action="Index" asp-route-estado="Confirmada" asp-route-busqueda="@busqueda" asp-route-cabanaId="@cabanaIdFiltro" class="@ClasesTab(filtro == EstadoReserva.Confirmada)">Reservas</a>
        <a asp-action="Index" asp-route-estado="Pendiente" asp-route-busqueda="@busqueda" asp-route-cabanaId="@cabanaIdFiltro" class="inline-flex items-center gap-2 @ClasesTab(filtro == EstadoReserva.Pendiente)">
            Solicitudes
            @await Component.InvokeAsync("PendientesBadge")
        </a>
    </div>
    @if (!esSolicitudes)
    {
        <div class="flex items-center gap-1 rounded-full bg-white px-2 py-1.5 shadow-soft ring-1 ring-ink-100 sm:gap-3">
            <a asp-action="Index" asp-route-anio="@mesAnterior!.Value.Year" asp-route-mes="@mesAnterior!.Value.Month" asp-route-estado="@filtro" asp-route-busqueda="@busqueda" asp-route-cabanaId="@cabanaIdFiltro"
               class="flex h-8 w-8 items-center justify-center rounded-full text-ink-500 transition hover:bg-sand-50 hover:text-river-700">&larr;</a>
            <span class="min-w-[120px] whitespace-nowrap text-center font-display text-sm font-semibold text-ink-800 sm:min-w-[140px]">@TituloMes(primerDia!.Value)</span>
            <a asp-action="Index" asp-route-anio="@mesSiguiente!.Value.Year" asp-route-mes="@mesSiguiente!.Value.Month" asp-route-estado="@filtro" asp-route-busqueda="@busqueda" asp-route-cabanaId="@cabanaIdFiltro"
               class="flex h-8 w-8 items-center justify-center rounded-full text-ink-500 transition hover:bg-sand-50 hover:text-river-700">&rarr;</a>
        </div>
    }
</div>

<form id="form-filtros" asp-action="Index" method="get" class="mb-6 flex flex-wrap items-end gap-3 rounded-2.5xl bg-white p-4 shadow-soft ring-1 ring-ink-100">
    <input type="hidden" name="estado" value="@filtro" />
    @if (!esSolicitudes)
    {
        <input type="hidden" name="anio" value="@primerDia!.Value.Year" />
        <input type="hidden" name="mes" value="@primerDia!.Value.Month" />
    }
    <div class="min-w-[200px] flex-1">
        <label class="mb-1 block text-xs font-medium text-ink-600">Buscar por huésped</label>
        <input type="text" name="busqueda" value="@busqueda" placeholder="Ej: Juan Pérez" oninput="buscarReservasConDemora()"
               class="w-full rounded-xl border border-ink-200 px-3.5 py-2 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
    </div>
    <div class="w-full sm:w-auto sm:min-w-[180px]">
        <label class="mb-1 block text-xs font-medium text-ink-600">Cabaña</label>
        <select name="cabanaId" onchange="document.getElementById('form-filtros').requestSubmit()"
                class="w-full rounded-xl border border-ink-200 px-3.5 py-2 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100">
            <option value="">Todas las cabañas</option>
            @foreach (var c in cabanas)
            {
                <option value="@c.Id" selected="@(cabanaIdFiltro == c.Id)">@c.Nombre</option>
            }
        </select>
    </div>
    @if (esSolicitudes)
    {
        <div class="w-full sm:w-auto sm:min-w-[180px]">
            <label class="mb-1 block text-xs font-medium text-ink-600">Mes de la estadía</label>
            <select id="mes-filtro-input" onchange="aplicarFiltroMes(this.value)"
                    class="w-full rounded-xl border border-ink-200 px-3.5 py-2 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100">
                <option value="">Todos los meses</option>
                @foreach (var m in mesesConSolicitudes)
                {
                    var valor = m.ToString("yyyy-MM");
                    <option value="@valor" selected="@(primerDia.HasValue && primerDia.Value.Year == m.Year && primerDia.Value.Month == m.Month)">@TituloMes(m)</option>
                }
            </select>
            <input type="hidden" name="anio" id="input-anio" value="@primerDia?.Year" />
            <input type="hidden" name="mes" id="input-mes" value="@primerDia?.Month" />
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(busqueda) || cabanaIdFiltro.HasValue || (esSolicitudes && primerDia.HasValue))
    {
        <a asp-action="Index" asp-route-estado="@filtro" class="rounded-full border border-ink-200 px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-ink-300">Limpiar filtros</a>
    }
</form>

@{
    string sustantivo = esSolicitudes ? "solicitudes" : "reservas";
    string mensajeVacio = primerDia.HasValue
        ? $"No hay {sustantivo} para mostrar en {TituloMes(primerDia.Value).ToLowerInvariant()}."
        : $"No hay {sustantivo} para mostrar.";
}
<form id="form-token-contactado">@Html.AntiForgeryToken()</form>
@if (!Model.Any())
{
    <div class="rounded-2.5xl bg-white p-6 text-center text-sm text-ink-400 shadow-soft ring-1 ring-ink-100 sm:p-8">@mensajeVacio</div>
}
else
{
    @foreach (var grupo in grupos)
    {
        <div class="mb-8">
            @if (!esSolicitudes)
            {
                <h2 class="mb-3 font-display text-lg font-semibold text-ink-800">@grupo.Item1</h2>
            }
                        <div class="space-y-3 md:hidden">
                @foreach (var r in grupo.Item2)
                {
                    var personasTexto = $"{r.CantidadPersonas} {(r.CantidadPersonas == 1 ? "persona" : "personas")}"
                        + (r.CantidadMenores > 0 ? $" ({r.CantidadMenores} menor{(r.CantidadMenores == 1 ? "" : "es")})" : "");
                    <div class="rounded-2.5xl bg-white p-4 shadow-soft ring-1 ring-ink-100">
                        @if (esSolicitudes)
                        {
                            <div class="flex items-center justify-between gap-2">
                                <p class="text-xs font-medium text-river-700">@(r.Cabana?.Nombre ?? "Sin cabaña")</p>
                                <label class="flex items-center gap-1.5 text-xs font-medium text-ink-500">
                                    Contactado
                                    <input type="checkbox" class="toggle-contactado h-4 w-4 rounded border-ink-300 text-river-600 focus:ring-river-400" data-id="@r.Id" checked="@(r.Contactado ? "checked" : null)" />
                                </label>
                            </div>
                        }
                        <p class="font-semibold text-ink-900">@r.NombreHuesped</p>
                        <p class="mt-0.5 text-sm text-ink-600">
                            <span class="whitespace-nowrap">@r.FechaDesde.ToString("dd/MM/yyyy")</span> &ndash; <span class="whitespace-nowrap">@r.FechaHasta.ToString("dd/MM/yyyy")</span>
                        </p>
                        <p class="mt-0.5 text-xs text-ink-500">@personasTexto</p>
                        @if (esSolicitudes)
                        {
                            <p class="mt-0.5 text-xs text-ink-400">Solicitud creada el @r.FechaCreacion.ToString("dd/MM/yyyy")</p>
                        }
                        <dl class="mt-3 grid grid-cols-2 gap-2">
                            <div class="rounded-xl bg-sand-50 px-3 py-2">
                                <dt class="text-xs text-ink-400">Pagó</dt>
                                <dd class="whitespace-nowrap text-sm font-semibold text-ink-800">@(r.Pago.HasValue ? "$" + r.Pago.Value.ToString("N0") : "-")</dd>
                            </div>
                            <div class="rounded-xl bg-sand-50 px-3 py-2">
                                <dt class="text-xs text-ink-400">Pagar</dt>
                                <dd class="whitespace-nowrap text-sm font-semibold text-ink-800">@(r.Valor.HasValue ? "$" + r.Valor.Value.ToString("N0") : "-")</dd>
                            </div>
                        </dl>
                        @if (!string.IsNullOrWhiteSpace(r.Telefono))
                        {
                            <p class="mt-2 break-words text-sm text-ink-500">Tel: @r.Telefono</p>
                        }
                        <div class="mt-3 flex items-center gap-2">
                            @if (filtro == EstadoReserva.Pendiente)
                            {
                                <form asp-action="Confirmar" asp-route-id="@r.Id" method="post">
                                    <button type="submit" class="h-9 rounded-full bg-river-600 px-4 text-xs font-semibold text-white transition hover:bg-river-700">Confirmar</button>
                                </form>
                                var linkWa = LinkWhatsApp(r);
                                @if (linkWa != "")
                                {
                                    <a href="@linkWa" target="_blank" rel="noopener" title="Avisar por WhatsApp" data-id="@r.Id" class="marcar-contactado-whatsapp flex h-9 w-9 items-center justify-center rounded-full border border-emerald-200 text-emerald-600 transition hover:bg-emerald-50">
                                        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
                                            <path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.27 4.9L2 22l5.25-1.38a9.94 9.94 0 004.79 1.22h.01c5.52 0 10-4.48 10-10s-4.48-9.84-10.01-9.84zm5.88 14.15c-.25.7-1.45 1.34-2 1.42-.51.08-1.15.11-1.86-.12-.43-.13-.98-.31-1.68-.61-2.96-1.28-4.89-4.26-5.04-4.46-.15-.2-1.2-1.6-1.2-3.05s.75-2.17 1.02-2.46c.25-.29.55-.36.73-.36.19 0 .37 0 .53.01.17.01.4-.06.62.48.25.6.85 2.07.92 2.22.08.15.13.32.02.52-.1.2-.15.32-.3.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.37 1.47.29.15.46.13.63-.07.17-.2.72-.84.92-1.13.19-.29.39-.24.65-.14.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.18 1.42z"/>
                                        </svg>
                                    </a>
                                }
                            }
                            else if (filtro == EstadoReserva.Confirmada)
                            {
                                var linkWaConfirmacion = LinkWhatsAppConfirmacion(r);
                                @if (linkWaConfirmacion != "")
                                {
                                    <a href="@linkWaConfirmacion" target="_blank" rel="noopener" title="Enviar confirmación por WhatsApp" data-id="@r.Id" class="marcar-contactado-whatsapp flex h-9 w-9 items-center justify-center rounded-full border border-emerald-200 text-emerald-600 transition hover:bg-emerald-50">
                                        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
                                            <path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.27 4.9L2 22l5.25-1.38a9.94 9.94 0 004.79 1.22h.01c5.52 0 10-4.48 10-10s-4.48-9.84-10.01-9.84zm5.88 14.15c-.25.7-1.45 1.34-2 1.42-.51.08-1.15.11-1.86-.12-.43-.13-.98-.31-1.68-.61-2.96-1.28-4.89-4.26-5.04-4.46-.15-.2-1.2-1.6-1.2-3.05s.75-2.17 1.02-2.46c.25-.29.55-.36.73-.36.19 0 .37 0 .53.01.17.01.4-.06.62.48.25.6.85 2.07.92 2.22.08.15.13.32.02.52-.1.2-.15.32-.3.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.37 1.47.29.15.46.13.63-.07.17-.2.72-.84.92-1.13.19-.29.39-.24.65-.14.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.18 1.42z"/>
                                        </svg>
                                    </a>
                                }
                            }
                            <div class="ml-auto flex items-center gap-2">
                                <a asp-action="Edit" asp-route-id="@r.Id" title="Editar" class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-600 transition hover:border-river-300 hover:text-river-700">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 6.75L17.25 9" />
                                </svg>
                                </a>
                                <form asp-action="Delete" asp-route-id="@r.Id" asp-route-vista="Lista" asp-route-estado="@filtro" asp-route-busqueda="@busqueda" asp-route-cabanaId="@cabanaIdFiltro" asp-route-anio="@primerDia?.Year" asp-route-mes="@primerDia?.Month" method="post" onsubmit="return confirmarAccion(event, '¿Eliminar esta reserva? No se puede deshacer.');">
                                    <button type="submit" title="Eliminar" class="flex h-9 w-9 items-center justify-center rounded-full border border-rose-200 text-rose-600 transition hover:bg-rose-50">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.166m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                    </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="hidden overflow-x-auto rounded-2.5xl bg-white shadow-soft ring-1 ring-ink-100 md:block">
                <table class="w-full text-left text-sm">
                    <thead class="border-b border-ink-100 bg-ink-50/60 text-xs font-semibold uppercase tracking-wide text-ink-500">
                        <tr>
                            @if (esSolicitudes)
                            {
                                <th class="px-3 py-3">Cabaña</th>
                            }
                            <th class="px-5 py-3">Huésped</th>
                            <th class="px-3 py-3">Fechas</th>
                            <th class="px-3 py-3 text-center">Personas</th>
                            <th class="px-3 py-3">Pagó</th>
                            <th class="px-3 py-3">Pagar</th>
                            <th class="px-3 py-3">Contacto</th>
                            @if (esSolicitudes)
                            {
                                <th class="px-3 py-3">Solicitud creada</th>
                                <th class="px-3 py-3 text-center">Contactado</th>
                            }
                            <th class="px-5 py-3 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink-100">
                        @foreach (var r in grupo.Item2)
                        {
                            <tr class="transition hover:bg-sand-50/60">
                                @if (esSolicitudes)
                                {
                                    <td class="whitespace-nowrap px-3 py-3 text-ink-600">@(r.Cabana?.Nombre ?? "Sin cabaña")</td>
                                }
                                <td class="px-5 py-3 font-medium text-ink-900">@r.NombreHuesped</td>
                                <td class="whitespace-nowrap px-3 py-3 text-ink-600">@r.FechaDesde.ToString("dd/MM/yyyy") &ndash; @r.FechaHasta.ToString("dd/MM/yyyy")</td>
                                <td class="whitespace-nowrap px-3 py-3 text-center text-ink-600">@r.CantidadPersonas@(r.CantidadMenores > 0 ? $" ({r.CantidadMenores} menor{(r.CantidadMenores == 1 ? "" : "es")})" : "")</td>
                                <td class="px-3 py-3 text-ink-600">@(r.Pago.HasValue ? "$" + r.Pago.Value.ToString("N0") : "-")</td>
                                <td class="px-3 py-3 text-ink-600">@(r.Valor.HasValue ? "$" + r.Valor.Value.ToString("N0") : "-")</td>
                                <td class="px-3 py-3 text-ink-500">@r.Telefono</td>
                                @if (esSolicitudes)
                                {
                                    <td class="whitespace-nowrap px-3 py-3 text-ink-500">@r.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td class="px-3 py-3 text-center">
                                        <input type="checkbox" class="toggle-contactado h-4 w-4 rounded border-ink-300 text-river-600 focus:ring-river-400" data-id="@r.Id" checked="@(r.Contactado ? "checked" : null)" />
                                    </td>
                                }
                                <td class="px-5 py-3">
                                    <div class="flex justify-center gap-2 whitespace-nowrap">
                                        @if (filtro == EstadoReserva.Pendiente)
                                        {
                                            <form asp-action="Confirmar" asp-route-id="@r.Id" method="post">
                                                <button type="submit" class="rounded-full bg-river-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-river-700">Confirmar</button>
                                            </form>
                                            var linkWaTabla = LinkWhatsApp(r);
                                            @if (linkWaTabla != "")
                                            {
                                                <a href="@linkWaTabla" target="_blank" rel="noopener" title="Avisar por WhatsApp" data-id="@r.Id" class="marcar-contactado-whatsapp flex h-7 w-7 items-center justify-center rounded-full border border-emerald-200 text-emerald-600 transition hover:bg-emerald-50">
                                                    <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
                                                        <path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.27 4.9L2 22l5.25-1.38a9.94 9.94 0 004.79 1.22h.01c5.52 0 10-4.48 10-10s-4.48-9.84-10.01-9.84zm5.88 14.15c-.25.7-1.45 1.34-2 1.42-.51.08-1.15.11-1.86-.12-.43-.13-.98-.31-1.68-.61-2.96-1.28-4.89-4.26-5.04-4.46-.15-.2-1.2-1.6-1.2-3.05s.75-2.17 1.02-2.46c.25-.29.55-.36.73-.36.19 0 .37 0 .53.01.17.01.4-.06.62.48.25.6.85 2.07.92 2.22.08.15.13.32.02.52-.1.2-.15.32-.3.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.37 1.47.29.15.46.13.63-.07.17-.2.72-.84.92-1.13.19-.29.39-.24.65-.14.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.18 1.42z"/>
                                                    </svg>
                                                </a>
                                            }
                                        }
                                        else if (filtro == EstadoReserva.Confirmada)
                                        {
                                            var linkWaConfirmacionTabla = LinkWhatsAppConfirmacion(r);
                                            @if (linkWaConfirmacionTabla != "")
                                            {
                                                <a href="@linkWaConfirmacionTabla" target="_blank" rel="noopener" title="Enviar confirmación por WhatsApp" data-id="@r.Id" class="marcar-contactado-whatsapp flex h-7 w-7 items-center justify-center rounded-full border border-emerald-200 text-emerald-600 transition hover:bg-emerald-50">
                                                    <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
                                                        <path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.27 4.9L2 22l5.25-1.38a9.94 9.94 0 004.79 1.22h.01c5.52 0 10-4.48 10-10s-4.48-9.84-10.01-9.84zm5.88 14.15c-.25.7-1.45 1.34-2 1.42-.51.08-1.15.11-1.86-.12-.43-.13-.98-.31-1.68-.61-2.96-1.28-4.89-4.26-5.04-4.46-.15-.2-1.2-1.6-1.2-3.05s.75-2.17 1.02-2.46c.25-.29.55-.36.73-.36.19 0 .37 0 .53.01.17.01.4-.06.62.48.25.6.85 2.07.92 2.22.08.15.13.32.02.52-.1.2-.15.32-.3.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.37 1.47.29.15.46.13.63-.07.17-.2.72-.84.92-1.13.19-.29.39-.24.65-.14.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.18 1.42z"/>
                                                    </svg>
                                                </a>
                                            }
                                        }
                                        <a asp-action="Edit" asp-route-id="@r.Id" title="Editar" class="flex h-7 w-7 items-center justify-center rounded-full border border-ink-200 text-ink-600 transition hover:border-river-300 hover:text-river-700">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-3.5 w-3.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 6.75L17.25 9" />
                                            </svg>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@r.Id" asp-route-vista="Lista" asp-route-estado="@filtro" asp-route-busqueda="@busqueda" asp-route-cabanaId="@cabanaIdFiltro" asp-route-anio="@primerDia?.Year" asp-route-mes="@primerDia?.Month" method="post" onsubmit="return confirmarAccion(event, '¿Eliminar esta reserva? No se puede deshacer.');">
                                            <button type="submit" title="Eliminar" class="flex h-7 w-7 items-center justify-center rounded-full border border-rose-200 text-rose-600 transition hover:bg-rose-50">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-3.5 w-3.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.166m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<partial name="_ModalConflictos" />

@section Scripts {
    <script>
        let __buscarReservasTimeout = null;
        function buscarReservasConDemora() {
            clearTimeout(__buscarReservasTimeout);
            __buscarReservasTimeout = setTimeout(() => {
                document.getElementById('form-filtros').requestSubmit();
            }, 450);
        }

        function aplicarFiltroMes(valor) {
            const [anio, mes] = valor ? valor.split('-') : ['', ''];
            document.getElementById('input-anio').value = anio;
            document.getElementById('input-mes').value = mes ? parseInt(mes, 10) : '';
            document.getElementById('form-filtros').requestSubmit();
        }

        (function () {
            const input = document.querySelector('input[name="busqueda"]');
            if (input && input.value) {
                input.focus();
                input.setSelectionRange(input.value.length, input.value.length);
            }
        })();

        document.querySelectorAll('.toggle-contactado').forEach(function (checkbox) {
            checkbox.addEventListener('change', async function () {
                const tokenInput = document.querySelector('#form-token-contactado input[name="__RequestVerificationToken"]');
                const body = new URLSearchParams();
                body.set('id', checkbox.dataset.id);
                body.set('contactado', checkbox.checked);
                body.set('__RequestVerificationToken', tokenInput.value);
                try {
                    const resp = await fetch('@Url.Action("ToggleContactado", "Reservas")', { method: 'POST', body });
                    if (!resp.ok) throw new Error();
                } catch {
                    checkbox.checked = !checkbox.checked;
                }
            });
        });

        // Avisar/confirmar por WhatsApp implica que ya se contactó al huésped: se tilda solo.
        document.querySelectorAll('.marcar-contactado-whatsapp').forEach(function (link) {
            link.addEventListener('click', function () {
                const tokenInput = document.querySelector('#form-token-contactado input[name="__RequestVerificationToken"]');
                if (!tokenInput) return;
                const body = new URLSearchParams();
                body.set('id', link.dataset.id);
                body.set('contactado', 'true');
                body.set('__RequestVerificationToken', tokenInput.value);
                fetch('@Url.Action("ToggleContactado", "Reservas")', { method: 'POST', body }).catch(() => {});
                document.querySelectorAll('.toggle-contactado[data-id="' + link.dataset.id + '"]').forEach(function (checkbox) {
                    checkbox.checked = true;
                });
            });
        });
    </script>
}
