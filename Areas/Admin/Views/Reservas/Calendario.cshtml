                    }
                </li>
                <li>
                    @if (!string.IsNullOrEmpty(syncDetalleEliminadas))
                    {
                        <details>
                            <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-lg py-1 transition hover:bg-sand-50">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-rose-500">
