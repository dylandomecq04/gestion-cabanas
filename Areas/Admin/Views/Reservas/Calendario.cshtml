<div id="modal-promo" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-ink-950/60 p-4 backdrop-blur-sm" onclick="if (event.target === this) cerrarModalPromo();">
    <div class="w-full max-w-md max-h-[90vh] overflow-y-auto rounded-2.5xl bg-white p-5 shadow-lift sm:max-h-[85vh] sm:p-6">
        <h3 class="font-display text-lg font-semibold text-ink-900">🎉 Crear promoción</h3>
        <p id="promo-rango-texto" class="mt-1 text-sm font-semibold text-red-700"></p>
        <p class="mt-1 text-xs text-ink-500">Definí un precio especial para 1, 2 y/o 3 noches (podés cargar sólo alguno). Elegí a qué cabañas aplicarla.</p>

        <form asp-action="CrearPromoEstadia" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post" class="mt-4 space-y-3">
            <input type="hidden" id="promo-fecha-desde" name="FechaDesde" />
            <input type="hidden" id="promo-fecha-hasta" name="FechaHasta" />

            <div>
                <label class="mb-1 block text-sm font-medium text-ink-700">Cabañas</label>
                <div class="grid grid-cols-2 gap-1.5 rounded-xl border border-ink-200 p-2.5">
                    @foreach (var c in cabanas)
                    {
                        <label class="flex items-center gap-1.5 text-sm text-ink-700">
                            <input type="checkbox" class="promo-cabana-check h-4 w-4 rounded border-ink-300 text-amber-600 focus:ring-amber-400" name="CabanaIds" value="@c.Id" />
                            @c.Nombre
                        </label>
                    }
                </div>
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-ink-700">Nombre (opcional)</label>
                <input name="Nombre" maxlength="80" placeholder="Ej: Promo temporada baja"
                       class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
            <div>
                <label class="mb-1 block text-sm font-medium text-ink-700">Descripción (opcional)</label>
                <textarea name="Descripcion" rows="2" maxlength="300" placeholder="Ej: Reservando 3 noches o más, la última corre por nuestra cuenta."
                          class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100"></textarea>
                <p class="mt-1 text-xs text-ink-400">Se muestra en el cartel de oferta de la página de inicio mientras la promoción esté vigente.</p>
            </div>
            <div id="promo-campos-precio" class="grid grid-cols-3 gap-2 sm:gap-3">
                <div id="promo-campo-1noche">
                    <label class="mb-1 block text-sm font-medium text-ink-700">1 noche</label>
                    <input id="promo-input-1noche" type="text" inputmode="numeric" placeholder="$"
                           oninput="formatearMiles(this, 'promo-real-1noche')"
                           class="w-full rounded-xl border border-ink-200 px-2 py-2.5 sm:px-3 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
                    <input type="hidden" id="promo-real-1noche" name="Precio1Noche" />
                </div>
                <div id="promo-campo-2noches">
                    <label class="mb-1 block text-sm font-medium text-ink-700">2 noches</label>
                    <input id="promo-input-2noches" type="text" inputmode="numeric" placeholder="$"
                           oninput="formatearMiles(this, 'promo-real-2noches')"
                           class="w-full rounded-xl border border-ink-200 px-2 py-2.5 sm:px-3 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
                    <input type="hidden" id="promo-real-2noches" name="Precio2Noches" />
                </div>
                <div id="promo-campo-3noches">
                    <label class="mb-1 block text-sm font-medium text-ink-700">3 noches</label>
                    <input id="promo-input-3noches" type="text" inputmode="numeric" placeholder="$"
                           oninput="formatearMiles(this, 'promo-real-3noches')"
                           class="w-full rounded-xl border border-ink-200 px-2 py-2.5 sm:px-3 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
                    <input type="hidden" id="promo-real-3noches" name="Precio3Noches" />
