@{
    ViewData["Title"] = "Calendario de disponibilidad";
    var cabanas = (List<Cabana>)ViewBag.Cabanas;
    var reservas = (List<Reserva>)ViewBag.Reservas;
    var tarifas = (List<TarifaDia>)ViewBag.Tarifas;
    var promos = (List<PromoEstadia>)ViewBag.Promos;
    DateTime primerDia = ViewBag.PrimerDia;
    DateTime ultimoDia = ViewBag.UltimoDia;
    DateTime mesAnterior = ViewBag.MesAnterior;
    DateTime mesSiguiente = ViewBag.MesSiguiente;
    var dias = Enumerable.Range(0, (ultimoDia - primerDia).Days + 1).Select(i => primerDia.AddDays(i)).ToList();
    var hoy = DateTime.Today;
    int indice = 0;

    List<Reserva> ReservasDeLaCabanaEnElDia(int cabanaId, DateTime dia)
        => reservas.Where(r => r.CabanaId == cabanaId && r.FechaDesde <= dia && dia < r.FechaHasta)
            .OrderByDescending(r => r.Estado).ThenBy(r => r.FechaCreacion).ToList();

    Reserva? ReservaQueLlegaEseDia(int cabanaId, DateTime dia)
        => reservas.FirstOrDefault(r => r.CabanaId == cabanaId && r.FechaDesde.Date == dia.Date);

    Reserva? ReservaQueSaleEseDia(int cabanaId, DateTime dia)
        => reservas.FirstOrDefault(r => r.CabanaId == cabanaId && r.FechaHasta.Date == dia.Date);

    TarifaDia? TarifaDeLaCabanaEnElDia(int cabanaId, DateTime dia)
        => tarifas.FirstOrDefault(t => t.CabanaId == cabanaId && t.Fecha.Date == dia.Date);

    PromoEstadia? PromoDeLaCabanaEnElDia(int cabanaId, DateTime dia)
        => promos.FirstOrDefault(p => p.CabanaId == cabanaId && p.FechaDesde.Date <= dia.Date && p.FechaHasta.Date >= dia.Date);

    string Miles(decimal? precio) => precio.HasValue ? precio.Value.ToString("N0") : "–";
    string Plano(decimal? precio) => precio?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "";
    // Cada cabaña solo tiene los tramos de precio que admite (una para 4 no tiene "para 6").
    string AtributosPrecios(Cabana cabana, TarifaDia? t)
        => $"data-tramos=\"{string.Join(",", cabana.TramosDePrecio())}\" "
            + string.Concat(cabana.TramosDePrecio().Select(tramo => $"data-precio{tramo}=\"{Plano(t?.PrecioDelTramo(tramo))}\" "));
    string EtiquetaPrecios(Cabana cabana, TarifaDia? t)
        => string.Concat(cabana.TramosDePrecio().Select(tramo => $"<span data-tramo=\"{tramo}\">{Miles(t?.PrecioDelTramo(tramo))}</span>"));
    string InputsPrecios(int indice, Cabana cabana, TarifaDia? t, string atributosExtra)
        => string.Concat(cabana.TramosDePrecio().Select(tramo =>
            $"<input type=\"hidden\" {atributosExtra} name=\"dias[{indice}].Precio{tramo}\" value=\"{Plano(t?.PrecioDelTramo(tramo))}\" />"));

    bool EsFinDeSemana(DateTime dia) => dia.DayOfWeek == DayOfWeek.Saturday || dia.DayOfWeek == DayOfWeek.Sunday;

    string[] diasSemana = { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" };
    int IndiceDiaSemana(DateTime dia) => ((int)dia.DayOfWeek + 6) % 7;

    var mesTitulo = primerDia.ToString("MMMM yyyy");
    mesTitulo = char.ToUpper(mesTitulo[0]) + mesTitulo.Substring(1);

    bool syncConfigurada = ViewBag.SincronizacionConfigurada;
    var syncConexion = ViewBag.SincronizacionConexion as OneDriveConexion;
    bool syncConectada = syncConexion?.RefreshTokenCifrado is not null;

    int? syncCreadas = TempData["ResultadoCreadas"] as int?;
    int? syncActualizadas = TempData["ResultadoActualizadas"] as int?;
    int? syncOmitidas = TempData["ResultadoOmitidas"] as int?;
    int? syncEliminadas = TempData["ResultadoEliminadas"] as int?;
    string? syncDetalleCreadas = TempData["ResultadoDetalleCreadas"] as string;
    string? syncDetalleActualizadas = TempData["ResultadoDetalleActualizadas"] as string;
    string? syncDetalleOmitidas = TempData["ResultadoDetalleOmitidas"] as string;
    string? syncDetalleEliminadas = TempData["ResultadoDetalleEliminadas"] as string;
    string? syncNoInterpretadas = TempData["ResultadoNoInterpretadas"] as string;
    string? syncCabanasNoEncontradas = TempData["ResultadoCabanasNoEncontradas"] as string;
    string? syncSuperposiciones = TempData["ResultadoSuperposiciones"] as string;

    string SyncPlural(int n, string singular, string plural) => $"{n} {(n == 1 ? singular : plural)}";

    // Para que el aviso de conflictos ("Mover acá") vuelva a este mes del calendario.
    ViewData["Vista"] = "Calendario";
    ViewData["Anio"] = primerDia.Year;
    ViewData["Mes"] = primerDia.Month;
}

<div class="relative left-1/2 w-screen -translate-x-1/2 px-3 sm:px-8">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2 sm:gap-3">
        <h1 class="font-display text-lg font-semibold text-ink-900 sm:text-2xl">Calendario &middot; @mesTitulo</h1>
        <div class="flex gap-2">
            <a class="rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700 sm:px-4 sm:py-2 sm:text-sm"
               asp-action="Calendario" asp-route-anio="@mesAnterior.Year" asp-route-mes="@mesAnterior.Month">&larr; <span class="hidden sm:inline">Mes </span>anterior</a>
            <a class="rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700 sm:px-4 sm:py-2 sm:text-sm"
               asp-action="Calendario" asp-route-anio="@mesSiguiente.Year" asp-route-mes="@mesSiguiente.Month"><span class="hidden sm:inline">Mes </span>siguiente &rarr;</a>
        </div>
    </div>

    <div class="mb-6 flex flex-wrap items-center gap-2 sm:gap-3">
        <button type="button" id="btn-toggle-solicitudes" onclick="alternarVisibilidadSolicitudes()" aria-pressed="false"
                class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700">
            <svg id="icono-ojo-abierto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <svg id="icono-ojo-cerrado" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="hidden h-4 w-4 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12c1.292 4.338 5.31 7.5 10.066 7.5.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
            </svg>
            <span id="texto-toggle-solicitudes">Ocultar solicitudes</span>
        </button>

        @if (syncConfigurada)
        {
            @if (syncConectada)
            {
                <form id="form-sincronizar" asp-controller="Sincronizacion" asp-action="Sincronizar" method="post" class="hidden">
                    <input type="hidden" name="anio" value="@primerDia.Year" />
                    <input type="hidden" name="mes" value="@primerDia.Month" />
                </form>
            }
            else
            {
                <a asp-controller="Sincronizacion" asp-action="Conectar" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month"
                   class="inline-flex items-center gap-1.5 rounded-full border border-river-300 px-3 py-1.5 text-xs font-semibold text-river-700 transition hover:bg-river-50 sm:gap-2 sm:px-4 sm:py-2 sm:text-sm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                    </svg>
                    Conectar OneDrive para sincronizar
                </a>
            }
        }
    </div>

    <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[11px] font-medium text-ink-500 sm:gap-4 sm:text-xs">
        <span class="flex shrink-0 items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-green-300"></span> Reservada</span>
        <span class="flex shrink-0 items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-sky-200"></span> Solicitud</span>
        <span class="flex shrink-0 items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-red-400"></span> Disponible</span>
        <span class="flex shrink-0 items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-amber-100 ring-1 ring-ink-200"></span> Sin reservar</span>
        <span class="flex shrink-0 items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-river-50 ring-2 ring-river-600"></span> Seleccionado</span>
        <span class="flex shrink-0 items-center gap-1.5"><span class="font-bold text-ink-700">$</span> Precios de arriba a abajo: para 2 · 4 · 6 personas</span>
        <span class="flex shrink-0 items-center gap-1.5"><span class="font-bold text-river-700">↑</span> Ingresa ese día</span>
        <span class="flex shrink-0 items-center gap-1.5"><span class="font-bold text-rose-600">↓</span> Sale ese día</span>
    </div>

    <div id="scroll-arriba" class="scroll-fino mb-1.5 overflow-x-auto overflow-y-hidden">
        <div id="scroll-arriba-ancho" class="h-px"></div>
    </div>

    <form id="form-tarifas" asp-action="GuardarTarifasCalendario" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post" class="pb-44 sm:pb-24">
        <div id="scroll-tabla" class="scroll-fino overflow-x-auto rounded-2.5xl bg-white p-2 shadow-soft ring-1 ring-ink-100 sm:p-3">
            <table class="w-full border-separate text-xs [border-spacing:2px_7px] sm:[border-spacing:4px_10px]">
                <thead>
                    <tr>
                        <th class="sticky left-0 z-20 min-w-[72px] rounded-lg bg-sand-50 px-2 py-1.5 text-left text-xs font-semibold text-ink-700 shadow-[6px_0_10px_-6px_rgba(15,23,42,0.25)] sm:min-w-[160px] sm:px-3 sm:py-2 sm:text-sm">Cabaña</th>
                        @foreach (var dia in dias)
                        {
                            var clasesHeader = dia.Date == hoy
                                ? "bg-river-600 text-white"
                                : EsFinDeSemana(dia)
                                    ? "bg-sand-100 text-sand-800"
                                    : "text-ink-400";
                            <th id="@(dia.Date == hoy ? "col-hoy" : null)" class="min-w-[60px] rounded-lg px-0.5 py-1.5 text-center font-semibold sm:min-w-[112px] sm:px-1 sm:py-2.5 @clasesHeader">
                                <div class="text-[10px] uppercase opacity-80 sm:text-xs">@diasSemana[IndiceDiaSemana(dia)]</div>
                                <div class="text-sm sm:text-lg">@dia.Day</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var iCabana = 0; iCabana < cabanas.Count; iCabana++)
                    {
                        var cabana = cabanas[iCabana];
                        var filaClara = iCabana % 2 == 0;
                        var bgFila = filaClara ? "bg-white" : "bg-sand-50/60";
                        var claseBordeFila = "border-b border-ink-100";
                        <tr>
                            <td class="sticky left-0 z-20 align-top @bgFila px-1.5 py-2 shadow-[6px_0_10px_-6px_rgba(15,23,42,0.25)] @claseBordeFila sm:px-3 sm:py-2.5">
                                <span class="inline-flex items-center whitespace-nowrap rounded-full bg-sand-100 px-2 py-1 text-[11px] font-semibold text-ink-800 ring-1 ring-sand-200 sm:px-3 sm:text-sm">@cabana.Nombre</span>
                            </td>
                            @foreach (var dia in dias)
                            {
                                var reservasDia = ReservasDeLaCabanaEnElDia(cabana.Id, dia);
                                var llega = ReservaQueLlegaEseDia(cabana.Id, dia);
                                var sale = ReservaQueSaleEseDia(cabana.Id, dia);
                                var fechaAttr = dia.ToString("yyyy-MM-dd");
                                var fechaTexto = dia.ToString("dd/MM/yyyy");
                                var promoDelDia = PromoDeLaCabanaEnElDia(cabana.Id, dia);

                                if (reservasDia.Count == 1)
                                {
                                    var reserva = reservasDia[0];
                                    var esPendiente = reserva.Estado == EstadoReserva.Pendiente;
                                    var etiquetaReserva = esPendiente ? "Solicitud" : "Reservada";
                                    var pagoTexto = reserva.Pago.HasValue ? "$" + reserva.Pago.Value.ToString("N0") : "-";
                                    var pagarTexto = reserva.Valor.HasValue ? "$" + reserva.Valor.Value.ToString("N0") : "-";
                                    var infoResumen = $"{reserva.NombreHuesped} — {reserva.FechaDesde:dd/MM} al {reserva.FechaHasta:dd/MM}";
                                    var claseReserva = esPendiente
                                        ? "bg-sky-200 hover:bg-sky-300 text-sky-900"
                                        : "bg-green-300 hover:bg-green-400 text-green-900";

                                    // Si es una solicitud (pendiente), preparamos una celda "Disponible" alternativa,
                                    // oculta por defecto, que se muestra cuando se activa "Ocultar solicitudes".
                                    var tarifaAlt = esPendiente ? TarifaDeLaCabanaEnElDia(cabana.Id, dia) : null;
                                    var yaPasoAlt = dia.Date < hoy;
                                    var etiquetaEstadoAlt = yaPasoAlt ? "Sin reservar" : "Disponible";
                                    var claseAlt = yaPasoAlt
                                        ? "bg-amber-100 text-amber-800 hover:bg-amber-200"
                                        : "bg-red-50 text-red-700 hover:bg-red-100";
                                    var indiceAlt = indice;

                                    <td class="p-0">
                                        <div class="relative">
                                            <button type="button" onclick="abrirReserva(this)"
                                                    data-cabana-nombre="@cabana.Nombre"
                                                    data-fecha-texto="@fechaTexto"
                                                    data-reserva-id="@reserva.Id"
                                                    data-info-resumen="@infoResumen"
                                                    data-info-estado="@etiquetaReserva"
                                                    data-info-pendiente="@(esPendiente ? "true" : "false")"
                                                    data-info-pago="@pagoTexto"
                                                    data-info-pagar="@pagarTexto"
                                                    title="@infoResumen (@etiquetaReserva)"
                                                    class="day-cell @(esPendiente ? "solicitud-cell" : "") relative flex h-16 w-16 flex-col items-center justify-center gap-0.5 rounded-lg px-1 text-[11px] font-bold leading-tight sm:h-28 sm:w-28 sm:gap-1 sm:px-1.5 sm:text-sm @claseReserva">
                                                <span>@etiquetaReserva</span>
                                                <span class="truncate text-[9px] font-normal opacity-90 max-w-full sm:text-xs">@reserva.NombreHuesped</span>
                                                @if (llega is not null)
                                                {
                                                    <span title="Ingresa: @llega.NombreHuesped" class="absolute bottom-0.5 left-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-white text-[10px] font-bold text-river-700 shadow ring-1 ring-ink-200 sm:bottom-1 sm:left-1 sm:h-6 sm:w-6 sm:text-base">↑</span>
                                                }
                                                @if (sale is not null)
                                                {
                                                    <span title="Sale: @sale.NombreHuesped" class="absolute bottom-0.5 right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-white text-[10px] font-bold text-rose-600 shadow ring-1 ring-ink-200 sm:bottom-1 sm:right-1 sm:h-6 sm:w-6 sm:text-base">↓</span>
                                                }
                                            </button>
                                            @if (esPendiente)
                                            {
                                                <button type="button" data-index="@indiceAlt"
                                                        data-cabana-id="@cabana.Id"
                                                        data-cabana-nombre="@cabana.Nombre"
                                                        data-fecha="@fechaAttr"
                                                        data-fecha-texto="@fechaTexto"
                                                        @Html.Raw(AtributosPrecios(cabana, tarifaAlt))
                                                        data-promo-id="@(promoDelDia is not null ? promoDelDia!.Id.ToString() : "")"
                                                        onclick="alternarSeleccionDia(this)"
                                                        class="dia-editable solicitud-alt-cell hidden day-cell relative flex h-16 w-16 flex-col items-center justify-center gap-0.5 rounded-lg text-[11px] font-bold leading-tight ring-2 ring-inset ring-transparent transition hover:ring-river-300 sm:h-28 sm:w-28 sm:gap-1 sm:text-sm @claseAlt">
                                                    <span class="etiqueta-estado leading-tight">@etiquetaEstadoAlt</span>
                                                    @if (!yaPasoAlt)
                                                    {
                                                        <span class="etiqueta-precio flex flex-col items-center text-[9px] font-normal leading-tight opacity-70 sm:text-xs">@Html.Raw(EtiquetaPrecios(cabana, tarifaAlt))</span>
                                                    }
                                                    <span class="badge-seleccionado absolute -right-1 -top-1 hidden h-4 w-4 items-center justify-center rounded-full bg-river-700 text-xs text-white shadow-soft sm:h-6 sm:w-6 sm:text-sm">✓</span>
                                                    @if (llega is not null)
                                                    {
                                                        <span title="Ingresa: @llega.NombreHuesped" class="absolute bottom-0.5 left-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-white text-[10px] font-bold text-river-700 shadow ring-1 ring-ink-200 sm:bottom-1 sm:left-1 sm:h-6 sm:w-6 sm:text-base">↑</span>
                                                    }
                                                    @if (sale is not null)
                                                    {
                                                        <span title="Sale: @sale.NombreHuesped" class="absolute bottom-0.5 right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-white text-[10px] font-bold text-rose-600 shadow ring-1 ring-ink-200 sm:bottom-1 sm:right-1 sm:h-6 sm:w-6 sm:text-base">↓</span>
                                                    }
                                                </button>
                                                <input type="hidden" class="solicitud-alt-input" disabled name="dias.Index" value="@indiceAlt" />
                                                <input type="hidden" class="solicitud-alt-input" disabled name="dias[@indiceAlt].CabanaId" value="@cabana.Id" />
                                                <input type="hidden" class="solicitud-alt-input" disabled name="dias[@indiceAlt].Fecha" value="@fechaAttr" />
                                                <text>@Html.Raw(InputsPrecios(indiceAlt, cabana, tarifaAlt, "class=\"solicitud-alt-input\" disabled"))</text>
                                                indice++;
                                            }
                                            @if (promoDelDia is not null)
                                            {
                                                <button type="button" onclick="event.stopPropagation(); eliminarPromoDesdeCelda(@promoDelDia.Id)"
                                                        title="Eliminar la promoción de estos días"
                                                        class="absolute -top-2 left-1 z-10 rounded-full bg-amber-500 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white shadow transition hover:bg-amber-600 sm:-top-2.5 sm:text-[10px]">
                                                    Promo ✕
                                                </button>
                                            }
                                        </div>
                                    </td>
                                }
                                else if (reservasDia.Count > 1)
                                {
                                    // Si todas las reservas del día son solicitudes (sin ninguna confirmada), agregamos
                                    // una celda "Disponible" alternativa para cuando se activa "Ocultar solicitudes".
                                    var todasPendientes = reservasDia.All(r => r.Estado == EstadoReserva.Pendiente);
                                    var tarifaAltMulti = todasPendientes ? TarifaDeLaCabanaEnElDia(cabana.Id, dia) : null;
                                    var yaPasoAltMulti = dia.Date < hoy;
                                    var etiquetaEstadoAltMulti = yaPasoAltMulti ? "Sin reservar" : "Disponible";
                                    var claseAltMulti = yaPasoAltMulti
                                        ? "bg-amber-100 text-amber-800 hover:bg-amber-200"
                                        : "bg-red-50 text-red-700 hover:bg-red-100";
                                    var indiceAltMulti = indice;

                                    <td class="p-0 align-top">
                                        <div class="relative flex w-16 flex-col gap-0.5 sm:w-28">
                                            @foreach (var reserva in reservasDia)
                                            {
                                                var esPendiente = reserva.Estado == EstadoReserva.Pendiente;
                                                var etiquetaReserva = esPendiente ? "Solicitud" : "Reservada";
                                                var pagoTexto = reserva.Pago.HasValue ? "$" + reserva.Pago.Value.ToString("N0") : "-";
                                                var pagarTexto = reserva.Valor.HasValue ? "$" + reserva.Valor.Value.ToString("N0") : "-";
                                                var infoResumen = $"{reserva.NombreHuesped} — {reserva.FechaDesde:dd/MM} al {reserva.FechaHasta:dd/MM}";
                                                var claseReserva = esPendiente
                                                    ? "bg-sky-200 hover:bg-sky-300 text-sky-900"
                                                    : "bg-green-300 hover:bg-green-400 text-green-900";
                                                <button type="button" onclick="abrirReserva(this)"
                                                        data-cabana-nombre="@cabana.Nombre"
                                                        data-fecha-texto="@fechaTexto"
                                                        data-reserva-id="@reserva.Id"
                                                        data-info-resumen="@infoResumen"
                                                        data-info-estado="@etiquetaReserva"
                                                        data-info-pendiente="@(esPendiente ? "true" : "false")"
                                                        data-info-pago="@pagoTexto"
                                                        data-info-pagar="@pagarTexto"
                                                        title="@infoResumen (@etiquetaReserva)"
                                                        class="day-cell @(esPendiente ? "solicitud-cell" : "") flex h-8 w-16 flex-col items-center justify-center gap-0 rounded-md px-1 text-[9px] font-bold leading-none sm:h-[3.3rem] sm:w-28 sm:gap-0.5 sm:px-1.5 sm:text-[11px] @claseReserva">
                                                    <span class="max-w-full truncate">@etiquetaReserva</span>
                                                    <span class="max-w-full truncate text-[8px] font-normal opacity-90 sm:text-[10px]">@reserva.NombreHuesped</span>
                                                </button>
                                            }
                                            @if (todasPendientes)
                                            {
                                                <button type="button" data-index="@indiceAltMulti"
                                                        data-cabana-id="@cabana.Id"
                                                        data-cabana-nombre="@cabana.Nombre"
                                                        data-fecha="@fechaAttr"
                                                        data-fecha-texto="@fechaTexto"
                                                        @Html.Raw(AtributosPrecios(cabana, tarifaAltMulti))
                                                        data-promo-id="@(promoDelDia is not null ? promoDelDia!.Id.ToString() : "")"
                                                        onclick="alternarSeleccionDia(this)"
                                                        class="dia-editable solicitud-alt-cell hidden day-cell relative flex h-16 w-16 flex-col items-center justify-center gap-0.5 rounded-lg text-[11px] font-bold leading-tight ring-2 ring-inset ring-transparent transition hover:ring-river-300 sm:h-28 sm:w-28 sm:gap-1 sm:text-sm @claseAltMulti">
                                                    <span class="etiqueta-estado leading-tight">@etiquetaEstadoAltMulti</span>
                                                    @if (!yaPasoAltMulti)
                                                    {
                                                        <span class="etiqueta-precio flex flex-col items-center text-[9px] font-normal leading-tight opacity-70 sm:text-xs">@Html.Raw(EtiquetaPrecios(cabana, tarifaAltMulti))</span>
                                                    }
                                                    <span class="badge-seleccionado absolute -right-1 -top-1 hidden h-4 w-4 items-center justify-center rounded-full bg-river-700 text-xs text-white shadow-soft sm:h-6 sm:w-6 sm:text-sm">✓</span>
                                                </button>
                                                <input type="hidden" class="solicitud-alt-input" disabled name="dias.Index" value="@indiceAltMulti" />
                                                <input type="hidden" class="solicitud-alt-input" disabled name="dias[@indiceAltMulti].CabanaId" value="@cabana.Id" />
                                                <input type="hidden" class="solicitud-alt-input" disabled name="dias[@indiceAltMulti].Fecha" value="@fechaAttr" />
                                                <text>@Html.Raw(InputsPrecios(indiceAltMulti, cabana, tarifaAltMulti, "class=\"solicitud-alt-input\" disabled"))</text>
                                                indice++;
                                            }
                                            @if (llega is not null)
                                            {
                                                <span title="Ingresa: @llega.NombreHuesped" class="absolute bottom-0.5 left-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-white text-[10px] font-bold text-river-700 shadow ring-1 ring-ink-200 sm:bottom-1 sm:left-1 sm:h-6 sm:w-6 sm:text-base">↑</span>
                                            }
                                            @if (sale is not null)
                                            {
                                                <span title="Sale: @sale.NombreHuesped" class="absolute bottom-0.5 right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-white text-[10px] font-bold text-rose-600 shadow ring-1 ring-ink-200 sm:bottom-1 sm:right-1 sm:h-6 sm:w-6 sm:text-base">↓</span>
                                            }
                                            @if (promoDelDia is not null)
                                            {
                                                <button type="button" onclick="event.stopPropagation(); eliminarPromoDesdeCelda(@promoDelDia.Id)"
                                                        title="Eliminar la promoción de estos días"
                                                        class="absolute -top-2 left-1 z-10 rounded-full bg-amber-500 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white shadow transition hover:bg-amber-600 sm:-top-2.5 sm:text-[10px]">
                                                    Promo ✕
                                                </button>
                                            }
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    var tarifa = TarifaDeLaCabanaEnElDia(cabana.Id, dia);
                                    var enPromoDia = promoDelDia is not null;
                                    var yaPaso = dia.Date < hoy;
                                    var etiquetaEstado = yaPaso ? "Sin reservar" : "Disponible";
                                    var clase = yaPaso
                                        ? "bg-amber-100 text-amber-800 hover:bg-amber-200"
                                        : "bg-red-50 text-red-700 hover:bg-red-100";

                                    <td class="p-0">
                                        <button type="button" data-index="@indice"
                                                data-cabana-id="@cabana.Id"
                                                data-cabana-nombre="@cabana.Nombre"
                                                data-fecha="@fechaAttr"
                                                data-fecha-texto="@fechaTexto"
                                                @Html.Raw(AtributosPrecios(cabana, tarifa))
                                                data-promo-id="@(enPromoDia ? promoDelDia!.Id.ToString() : "")"
                                                onclick="alternarSeleccionDia(this)"
                                                class="dia-editable day-cell relative flex h-16 w-16 flex-col items-center justify-center gap-0.5 rounded-lg text-[11px] font-bold leading-tight ring-2 ring-inset ring-transparent transition hover:ring-river-300 sm:h-28 sm:w-28 sm:gap-1 sm:text-sm @clase @(enPromoDia ? "promo-glow" : "")">
                                            @if (enPromoDia)
                                            {
                                                <span class="absolute -top-2 left-1 text-[9px] font-bold uppercase tracking-wide text-amber-600 sm:-top-2.5 sm:text-[10px]">Promo</span>
                                            }
                                            <span class="etiqueta-estado leading-tight">@etiquetaEstado</span>
                                            @if (!yaPaso)
                                            {
                                                <span class="etiqueta-precio flex flex-col items-center text-[9px] font-normal leading-tight opacity-70 sm:text-xs">@Html.Raw(EtiquetaPrecios(cabana, tarifa))</span>
                                            }
                                            <span class="badge-seleccionado absolute -right-1 -top-1 hidden h-4 w-4 items-center justify-center rounded-full bg-river-700 text-xs text-white shadow-soft sm:h-6 sm:w-6 sm:text-sm">✓</span>
                                            @if (llega is not null)
                                            {
                                                <span title="Ingresa: @llega.NombreHuesped" class="absolute bottom-0.5 left-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-white text-[10px] font-bold text-river-700 shadow ring-1 ring-ink-200 sm:bottom-1 sm:left-1 sm:h-6 sm:w-6 sm:text-base">↑</span>
                                            }
                                            @if (sale is not null)
                                            {
                                                <span title="Sale: @sale.NombreHuesped" class="absolute bottom-0.5 right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-white text-[10px] font-bold text-rose-600 shadow ring-1 ring-ink-200 sm:bottom-1 sm:right-1 sm:h-6 sm:w-6 sm:text-base">↓</span>
                                            }
                                        </button>
                                        <input type="hidden" name="dias.Index" value="@indice" />
                                        <input type="hidden" name="dias[@indice].CabanaId" value="@cabana.Id" />
                                        <input type="hidden" name="dias[@indice].Fecha" value="@fechaAttr" />
                                        @Html.Raw(InputsPrecios(indice, cabana, tarifa, ""))
                                    </td>
                                    indice++;
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<div id="barra-seleccion" class="hidden fixed inset-x-0 bottom-0 z-40 border-t border-ink-100 bg-white/95 shadow-lift backdrop-blur">
    @* En el celu la barra son dos renglones sin scroll: arriba contador + precios + tilde de aplicar,
       abajo las acciones. En pantallas grandes vuelve a ser un solo renglón. *@
    <div class="mx-auto flex max-w-5xl flex-wrap items-end gap-x-2 gap-y-2 px-3 py-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] sm:items-center sm:gap-4 sm:px-4 sm:py-3">
        <div id="texto-seleccion" class="flex h-9 shrink-0 items-center whitespace-nowrap rounded-full bg-river-50 px-2.5 text-xs font-semibold text-river-800 sm:h-auto sm:px-3.5 sm:py-2 sm:text-sm">
            0 días seleccionados
        </div>

        <div class="hidden h-9 w-px bg-ink-200 sm:block"></div>

        <div class="flex min-w-0 flex-1 items-end gap-1.5 sm:flex-none sm:gap-3">
            @foreach (var tramo in new[] { 2, 4, 6 })
            {
                <div class="min-w-0 flex-1 sm:w-28 sm:flex-none">
                    <label class="mb-0.5 block text-[11px] font-medium text-ink-500 sm:mb-1 sm:text-xs">Para @tramo</label>
                    <input id="bulk-precio-@tramo" type="text" inputmode="numeric" placeholder="$"
                           title="@(tramo > 2 ? $"Solo se aplica a las cabañas con lugar para {tramo} personas" : "")"
                           oninput="formatearMiles(this)"
                           class="h-9 w-full rounded-xl border border-ink-200 px-2 text-sm text-ink-900 shadow-sm transition placeholder:text-xs focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100 disabled:cursor-not-allowed disabled:bg-ink-50 sm:h-10 sm:px-3 sm:placeholder:text-sm" />
                </div>
            }
        </div>

        <button type="button" onclick="aplicarSeleccion(false)" title="Aplicar precios (los campos vacíos no se modifican)" aria-label="Aplicar precios" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-river-700 text-white shadow-soft transition hover:bg-river-800 sm:order-last sm:-ml-2 sm:h-10 sm:w-10">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4 sm:h-5 sm:w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
        </button>

        <div class="flex w-full flex-wrap items-center gap-2 sm:ml-auto sm:w-auto sm:flex-nowrap">
            <a id="link-cargar-reserva-bulk" href="#" class="hidden inline-flex h-9 flex-1 shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-full border border-ink-200 px-2.5 text-xs font-semibold text-ink-700 transition hover:border-river-300 sm:h-10 sm:flex-none sm:gap-1.5 sm:px-4 sm:text-sm">
                <span class="hidden sm:inline">➕</span> Cargar reserva
            </a>
            <button type="button" onclick="abrirModalPromoDesdeSeleccion()" class="inline-flex h-9 flex-1 shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-full bg-violet-600 px-2.5 text-xs font-semibold text-white shadow-soft transition hover:bg-violet-700 sm:h-10 sm:flex-none sm:gap-1.5 sm:px-4 sm:text-sm">
                <span class="hidden sm:inline">🎉</span> Crear promo
            </button>
            <form id="form-eliminar-promo" class="hidden flex-1 shrink-0 sm:flex-none" asp-action="EliminarPromoCalendario" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post"
                  onsubmit="return confirmarAccion(event, '¿Eliminar la promoción de los días seleccionados? No se puede deshacer.');">
                <div id="eliminar-promo-inputs"></div>
                <button type="submit" id="btn-eliminar-promo" class="inline-flex h-9 w-full shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-full border border-rose-200 px-2.5 text-xs font-semibold text-rose-600 transition hover:bg-rose-50 sm:h-10 sm:w-auto sm:gap-1.5 sm:px-4 sm:text-sm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-3.5 w-3.5 shrink-0">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.166m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                    Eliminar promo
                </button>
            </form>
            <button type="button" onclick="aplicarSeleccion(true)" title="Borrar los precios de los días seleccionados" class="h-9 flex-1 shrink-0 whitespace-nowrap rounded-full border border-rose-200 px-2.5 text-xs font-semibold text-rose-600 transition hover:bg-rose-50 sm:h-10 sm:flex-none sm:px-4 sm:text-sm">
                Borrar precios
            </button>
        </div>
    </div>
</div>

@if (syncCreadas.HasValue)
{
    <div id="modal-sincronizacion" class="fixed inset-0 z-50 flex items-center justify-center bg-ink-950/40 p-4 backdrop-blur-sm" onclick="if (event.target === this) cerrarModalSincronizacion();">
        <div class="flex max-h-[85vh] w-full max-w-md flex-col rounded-2.5xl bg-white p-5 shadow-lift sm:p-6">
            <div class="mb-4 flex shrink-0 items-center justify-between">
                <h3 class="font-display text-lg font-semibold text-ink-900">Sincronización con Excel</h3>
                <button type="button" onclick="cerrarModalSincronizacion()" aria-label="Cerrar" class="flex h-7 w-7 items-center justify-center rounded-full text-ink-400 transition hover:bg-sand-100 hover:text-ink-600">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="overflow-y-auto">
            <ul class="space-y-1 text-sm text-ink-700">
                <li>
                    @if (!string.IsNullOrEmpty(syncDetalleCreadas))
                    {
                        <details>
                            <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-lg py-1 transition hover:bg-sand-50">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-emerald-500">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                                @SyncPlural(syncCreadas.Value, "reserva nueva", "reservas nuevas")
                            </summary>
                            <ul class="mt-1 list-disc space-y-0.5 py-1 pl-7 text-xs text-ink-500 sm:pl-10">
                                @foreach (var linea in syncDetalleCreadas.Split(" | "))
                                {
                                    <li>@linea</li>
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <div class="flex items-center gap-2.5 py-1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-emerald-500">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            @SyncPlural(syncCreadas.Value, "reserva nueva", "reservas nuevas")
                        </div>
                    }
                </li>
                <li>
                    @if (!string.IsNullOrEmpty(syncDetalleActualizadas))
                    {
                        <details>
                            <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-lg py-1 transition hover:bg-sand-50">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-amber-500">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
                                </svg>
                                @SyncPlural(syncActualizadas ?? 0, "reserva actualizada", "reservas actualizadas")
                            </summary>
                            <ul class="mt-1 list-disc space-y-0.5 py-1 pl-7 text-xs text-ink-500 sm:pl-10">
                                @foreach (var linea in syncDetalleActualizadas.Split(" | "))
                                {
                                    <li>@linea</li>
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <div class="flex items-center gap-2.5 py-1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-amber-500">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
                            </svg>
                            @SyncPlural(syncActualizadas ?? 0, "reserva actualizada", "reservas actualizadas")
                        </div>
                    }
                </li>
                <li>
                    @if (!string.IsNullOrEmpty(syncDetalleOmitidas))
                    {
                        <details>
                            <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-lg py-1 transition hover:bg-sand-50">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-ink-300">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                                </svg>
                                @SyncPlural(syncOmitidas ?? 0, "reserva sin cambios", "reservas sin cambios")
                            </summary>
                            <ul class="mt-1 list-disc space-y-0.5 py-1 pl-7 text-xs text-ink-500 sm:pl-10">
                                @foreach (var linea in syncDetalleOmitidas.Split(" | "))
                                {
                                    <li>@linea</li>
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <div class="flex items-center gap-2.5 py-1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-ink-300">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                            </svg>
                            @SyncPlural(syncOmitidas ?? 0, "reserva sin cambios", "reservas sin cambios")
