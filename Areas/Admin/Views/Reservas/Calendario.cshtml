@{
    ViewData["Title"] = "Calendario de disponibilidad";
    var cabanas = (List<Cabana>)ViewBag.Cabanas;
    var reservas = (List<Reserva>)ViewBag.Reservas;
    var tarifas = (List<TarifaDia>)ViewBag.Tarifas;
    DateTime primerDia = ViewBag.PrimerDia;
    DateTime ultimoDia = ViewBag.UltimoDia;
    DateTime mesAnterior = ViewBag.MesAnterior;
    DateTime mesSiguiente = ViewBag.MesSiguiente;
    var dias = Enumerable.Range(0, (ultimoDia - primerDia).Days + 1).Select(i => primerDia.AddDays(i)).ToList();
    var hoy = DateTime.Today;
    int indice = 0;

    Reserva? ReservaDeLaCabanaEnElDia(int cabanaId, DateTime dia)
        => reservas.FirstOrDefault(r => r.CabanaId == cabanaId && r.FechaDesde <= dia && dia < r.FechaHasta);

    Reserva? ReservaQueLlegaEseDia(int cabanaId, DateTime dia)
        => reservas.FirstOrDefault(r => r.CabanaId == cabanaId && r.FechaDesde.Date == dia.Date);

    Reserva? ReservaQueSaleEseDia(int cabanaId, DateTime dia)
        => reservas.FirstOrDefault(r => r.CabanaId == cabanaId && r.FechaHasta.Date == dia.Date);

    TarifaDia? TarifaDeLaCabanaEnElDia(int cabanaId, DateTime dia)
        => tarifas.FirstOrDefault(t => t.CabanaId == cabanaId && t.Fecha.Date == dia.Date);

    bool EsFinDeSemana(DateTime dia) => dia.DayOfWeek == DayOfWeek.Saturday || dia.DayOfWeek == DayOfWeek.Sunday;

    string[] diasSemana = { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" };
    int IndiceDiaSemana(DateTime dia) => ((int)dia.DayOfWeek + 6) % 7;

    var mesTitulo = primerDia.ToString("MMMM yyyy");
    mesTitulo = char.ToUpper(mesTitulo[0]) + mesTitulo.Substring(1);

    bool syncConfigurada = ViewBag.SincronizacionConfigurada;
    var syncConexion = ViewBag.SincronizacionConexion as OneDriveConexion;
    bool syncConectada = syncConexion?.RefreshTokenCifrado is not null;

    int? syncCreadas = TempData["ResultadoCreadas"] as int?;
    int? syncActualizadas = TempData["ResultadoActualizadas"] as int?;
    int? syncOmitidas = TempData["ResultadoOmitidas"] as int?;
    int? syncEliminadas = TempData["ResultadoEliminadas"] as int?;
    string? syncDetalleCreadas = TempData["ResultadoDetalleCreadas"] as string;
    string? syncDetalleActualizadas = TempData["ResultadoDetalleActualizadas"] as string;
    string? syncDetalleOmitidas = TempData["ResultadoDetalleOmitidas"] as string;
    string? syncDetalleEliminadas = TempData["ResultadoDetalleEliminadas"] as string;
    string? syncNoInterpretadas = TempData["ResultadoNoInterpretadas"] as string;
    string? syncCabanasNoEncontradas = TempData["ResultadoCabanasNoEncontradas"] as string;
    string? syncSuperposiciones = TempData["ResultadoSuperposiciones"] as string;

    string SyncPlural(int n, string singular, string plural) => $"{n} {(n == 1 ? singular : plural)}";
}

<div class="relative left-1/2 w-screen -translate-x-1/2 px-4 sm:px-8">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-3">
        <h1 class="font-display text-2xl font-semibold text-ink-900">Calendario &middot; @mesTitulo</h1>
        <div class="flex gap-2">
            <a class="rounded-full border border-ink-200 px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700"
               asp-action="Calendario" asp-route-anio="@mesAnterior.Year" asp-route-mes="@mesAnterior.Month">&larr; Mes anterior</a>
            <a class="rounded-full border border-ink-200 px-4 py-2 text-sm font-medium text-ink-600 transition hover:border-river-300 hover:text-river-700"
               asp-action="Calendario" asp-route-anio="@mesSiguiente.Year" asp-route-mes="@mesSiguiente.Month">Mes siguiente &rarr;</a>
        </div>
    </div>

    @if (syncConfigurada)
    {
        <div class="mb-6 flex flex-wrap items-center gap-3">
            @if (syncConectada)
            {
                <form asp-controller="Sincronizacion" asp-action="Sincronizar" method="post" class="flex items-center gap-2">
                    <input type="hidden" name="anio" value="@primerDia.Year" />
                    <input type="hidden" name="mes" value="@primerDia.Month" />
                    <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-river-700 px-4 py-2 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 text-emerald-300">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                        </svg>
                        Sincronizar con Excel
                    </button>
                </form>
                <span class="text-xs text-ink-400">
                    @if (syncConexion!.UltimaSincronizacion.HasValue)
                    {
                        <text>Última sincronización: @syncConexion.UltimaSincronizacion.Value.ToString("dd/MM/yyyy HH:mm")</text>
                    }
                    else
                    {
                        <text>Todavía no sincronizaste</text>
                    }
                </span>
                <form asp-controller="Sincronizacion" asp-action="Desconectar" method="post" onsubmit="return confirmarAccion(event, '¿Desconectar la cuenta de OneDrive?');">
                    <input type="hidden" name="anio" value="@primerDia.Year" />
                    <input type="hidden" name="mes" value="@primerDia.Month" />
                    <button type="submit" class="text-xs font-medium text-ink-400 underline transition hover:text-rose-600">Desconectar OneDrive</button>
                </form>
            }
            else
            {
                <a asp-controller="Sincronizacion" asp-action="Conectar" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month"
                   class="inline-flex items-center gap-2 rounded-full border border-river-300 px-4 py-2 text-sm font-semibold text-river-700 transition hover:bg-river-50">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                    </svg>
                    Conectar OneDrive para sincronizar
                </a>
            }
        </div>
    }

    <div class="mb-1 flex flex-wrap items-center gap-4 text-xs font-medium text-ink-500">
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-green-300"></span> Reservada</span>
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-amber-200"></span> Pendiente</span>
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-red-400"></span> Disponible</span>
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-green-100 ring-1 ring-ink-200"></span> Bloqueada</span>
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-full bg-river-50 ring-2 ring-river-600"></span> Seleccionado</span>
        <span class="flex items-center gap-1.5">🔑 Ingresa ese día</span>
        <span class="flex items-center gap-1.5">🧳 Sale ese día</span>
    </div>
    <p class="mb-4 text-xs text-ink-400">Tocá una o varias celdas libres para bloquearlas o ponerles precio juntas. Tocá una celda con reserva para verla o editarla.</p>

    <div id="scroll-arriba" class="scroll-fino mb-1.5 overflow-x-auto overflow-y-hidden">
        <div id="scroll-arriba-ancho" class="h-px"></div>
    </div>

    <form id="form-tarifas" asp-action="GuardarTarifasCalendario" asp-route-anio="@primerDia.Year" asp-route-mes="@primerDia.Month" method="post" class="pb-24">
        <div id="scroll-tabla" class="scroll-fino overflow-x-auto rounded-2.5xl bg-white p-3 shadow-soft ring-1 ring-ink-100">
            <table class="w-full border-separate text-xs" style="border-spacing: 4px;">
                <thead>
                    <tr>
                        <th class="sticky left-0 z-20 min-w-[160px] rounded-lg bg-sand-50 px-3 py-2 text-left text-sm font-semibold text-ink-700 shadow-[6px_0_10px_-6px_rgba(15,23,42,0.25)]">Cabaña</th>
                        @foreach (var dia in dias)
                        {
                            var clasesHeader = dia.Date == hoy
                                ? "bg-river-600 text-white"
                                : EsFinDeSemana(dia)
                                    ? "bg-sand-100 text-sand-800"
                                    : "text-ink-400";
                            <th class="min-w-[112px] rounded-lg px-1 py-2.5 text-center font-semibold @clasesHeader">
                                <div class="text-xs uppercase opacity-80">@diasSemana[IndiceDiaSemana(dia)]</div>
                                <div class="text-lg">@dia.Day</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cabana in cabanas)
                    {
                        <tr>
                            <td class="sticky left-0 z-20 rounded-lg bg-sand-50 px-3 py-2 text-sm font-semibold text-ink-800 shadow-[6px_0_10px_-6px_rgba(15,23,42,0.25)]">@cabana.Nombre</td>
                            @foreach (var dia in dias)
                            {
                                var reserva = ReservaDeLaCabanaEnElDia(cabana.Id, dia);
                                var llega = ReservaQueLlegaEseDia(cabana.Id, dia);
                                var sale = ReservaQueSaleEseDia(cabana.Id, dia);
                                var fechaAttr = dia.ToString("yyyy-MM-dd");
                                var fechaTexto = dia.ToString("dd/MM/yyyy");

                                if (reserva is not null)
                                {
                                    var esPendiente = reserva.Estado == EstadoReserva.Pendiente;
                                    var etiquetaReserva = esPendiente ? "Pendiente" : "Reservada";
                                    var infoReserva = $"{reserva.NombreHuesped} — {reserva.FechaDesde:dd/MM} al {reserva.FechaHasta:dd/MM} ({etiquetaReserva})";
                                    var claseReserva = esPendiente
                                        ? "bg-amber-200 hover:bg-amber-300 text-amber-900"
                                        : "bg-green-300 hover:bg-green-400 text-green-900";
                                    <td class="p-0">
                                        <button type="button" onclick="abrirReserva(this)"
                                                data-cabana-nombre="@cabana.Nombre"
                                                data-fecha-texto="@fechaTexto"
                                                data-reserva-id="@reserva.Id"
                                                data-info-reserva="@infoReserva"
                                                title="@infoReserva"
                                                class="day-cell relative flex h-28 w-28 flex-col items-center justify-center gap-1 rounded-lg px-1.5 text-sm font-bold leading-tight @claseReserva">
                                            <span>@etiquetaReserva</span>
                                            <span class="truncate text-xs font-normal opacity-90 max-w-full">@reserva.NombreHuesped</span>
                                            @if (llega is not null)
                                            {
                                                <span title="Ingresa: @llega.NombreHuesped" class="absolute bottom-1 left-1 flex h-6 w-6 items-center justify-center rounded-full bg-white text-sm shadow ring-1 ring-ink-200">🔑</span>
                                            }
                                            @if (sale is not null)
                                            {
                                                <span title="Sale: @sale.NombreHuesped" class="absolute bottom-1 right-1 flex h-6 w-6 items-center justify-center rounded-full bg-white text-sm shadow ring-1 ring-ink-200">🧳</span>
                                            }
                                        </button>
                                    </td>
                                }
                                else
                                {
                                    var tarifa = TarifaDeLaCabanaEnElDia(cabana.Id, dia);
                                    var bloqueada = tarifa?.Bloqueada ?? false;
                                    var precioTexto = tarifa?.Precio?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "";
                                    var precioMostrar = tarifa?.Precio ?? cabana.PrecioPorNoche;
                                    var etiquetaEstado = bloqueada ? "Bloqueada" : "Disponible";
                                    var etiquetaPrecio = precioMostrar.HasValue ? "$" + precioMostrar.Value.ToString("N0") : "Sin precio";
                                    var clase = bloqueada
                                        ? "bg-green-100 text-green-700 hover:bg-green-200"
                                        : "bg-red-50 text-red-700 hover:bg-red-100";

                                    <td class="p-0">
                                        <button type="button" data-index="@indice"
                                                data-cabana-id="@cabana.Id"
                                                data-cabana-nombre="@cabana.Nombre"
                                                data-fecha="@fechaAttr"
                                                data-fecha-texto="@fechaTexto"
                                                data-precio="@precioTexto"
                                                data-bloqueada="@(bloqueada ? "true" : "false")"
                                                onclick="alternarSeleccionDia(this)"
                                                class="dia-editable day-cell relative flex h-28 w-28 flex-col items-center justify-center gap-1 rounded-lg text-sm font-bold leading-tight ring-2 ring-inset ring-transparent transition hover:ring-river-300 @clase">
                                            <span class="etiqueta-estado leading-tight">@etiquetaEstado</span>
                                            <span class="etiqueta-precio text-xs font-normal leading-tight opacity-70">@etiquetaPrecio</span>
                                            <span class="badge-seleccionado absolute -right-1 -top-1 hidden h-6 w-6 items-center justify-center rounded-full bg-river-700 text-sm text-white shadow-soft">✓</span>
                                            @if (llega is not null)
                                            {
                                                <span title="Ingresa: @llega.NombreHuesped" class="absolute bottom-1 left-1 flex h-6 w-6 items-center justify-center rounded-full bg-white text-sm shadow ring-1 ring-ink-200">🔑</span>
                                            }
                                            @if (sale is not null)
                                            {
                                                <span title="Sale: @sale.NombreHuesped" class="absolute bottom-1 right-1 flex h-6 w-6 items-center justify-center rounded-full bg-white text-sm shadow ring-1 ring-ink-200">🧳</span>
                                            }
                                        </button>
                                        <input type="hidden" name="dias[@indice].CabanaId" value="@cabana.Id" />
                                        <input type="hidden" name="dias[@indice].Fecha" value="@fechaAttr" />
                                        <input type="hidden" name="dias[@indice].Precio" value="@precioTexto" />
                                        <input type="hidden" name="dias[@indice].Bloqueada" value="@(bloqueada ? "true" : "false")" />
                                    </td>
                                    indice++;
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<div id="barra-seleccion" class="hidden fixed inset-x-0 bottom-0 z-40 border-t border-ink-100 bg-white/95 shadow-lift backdrop-blur">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-4 px-4 py-3">
        <div id="texto-seleccion" class="whitespace-nowrap rounded-full bg-river-50 px-3.5 py-2 text-sm font-semibold text-river-800">
            0 días seleccionados
        </div>

        <div class="hidden h-9 w-px bg-ink-200 sm:block"></div>

        <div class="flex flex-wrap items-end gap-3">
            <div class="w-28">
                <label class="mb-1 block text-xs font-medium text-ink-500">Precio</label>
                <input id="bulk-precio" type="text" inputmode="numeric" placeholder="Base"
                       oninput="formatearMiles(this)"
                       class="h-10 w-full rounded-xl border border-ink-200 px-3 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            </div>
            <div>
                <label class="mb-1 block text-xs font-medium text-ink-500">Disponibilidad</label>
                <div class="flex h-10 items-center gap-1 rounded-xl border border-ink-200 p-1">
                    <button type="button" id="btn-bloquear" onclick="elegirBloqueo(true)"
                            class="h-8 rounded-lg px-3 text-sm font-medium text-ink-500 transition hover:bg-rose-50">Bloquear</button>
                    <button type="button" id="btn-desbloquear" onclick="elegirBloqueo(false)"
                            class="h-8 rounded-lg px-3 text-sm font-medium text-ink-500 transition hover:bg-emerald-50">Desbloquear</button>
                </div>
                <input type="hidden" id="bulk-bloqueada" value="false" />
            </div>
        </div>

        <div class="ml-auto flex items-center gap-2">
            <a id="link-cargar-reserva-bulk" href="#" class="hidden h-10 inline-flex items-center gap-1.5 rounded-full border border-ink-200 px-4 text-sm font-semibold text-ink-700 transition hover:border-river-300">
                ➕ Cargar reserva acá
            </a>
            <button type="button" onclick="cancelarSeleccion()" class="h-10 rounded-full border border-ink-200 px-4 text-sm font-medium text-ink-600 transition hover:border-ink-300">
                Cancelar
            </button>
            <button type="button" onclick="aplicarSeleccion()" class="h-10 rounded-full bg-river-700 px-5 text-sm font-semibold text-white shadow-soft transition hover:bg-river-800">
                Aplicar
            </button>
        </div>
    </div>
</div>

@if (syncCreadas.HasValue)
{
    <div id="modal-sincronizacion" class="fixed inset-0 z-50 flex items-center justify-center bg-ink-950/40 p-4 backdrop-blur-sm" onclick="if (event.target === this) cerrarModalSincronizacion();">
        <div class="flex max-h-[85vh] w-full max-w-md flex-col rounded-2.5xl bg-white p-6 shadow-lift">
            <div class="mb-4 flex shrink-0 items-center justify-between">
                <h3 class="font-display text-lg font-semibold text-ink-900">Sincronización con Excel</h3>
                <button type="button" onclick="cerrarModalSincronizacion()" aria-label="Cerrar" class="flex h-7 w-7 items-center justify-center rounded-full text-ink-400 transition hover:bg-sand-100 hover:text-ink-600">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="overflow-y-auto">
            <ul class="space-y-1 text-sm text-ink-700">
                <li>
                    @if (!string.IsNullOrEmpty(syncDetalleCreadas))
                    {
                        <details>
                            <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-lg py-1 transition hover:bg-sand-50">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-emerald-500">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                                @SyncPlural(syncCreadas.Value, "reserva nueva", "reservas nuevas")
                            </summary>
                            <ul class="mt-1 list-disc space-y-0.5 py-1 pl-10 text-xs text-ink-500">
                                @foreach (var linea in syncDetalleCreadas.Split(" | "))
                                {
                                    <li>@linea</li>
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <div class="flex items-center gap-2.5 py-1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-emerald-500">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            @SyncPlural(syncCreadas.Value, "reserva nueva", "reservas nuevas")
                        </div>
                    }
                </li>
                <li>
                    @if (!string.IsNullOrEmpty(syncDetalleActualizadas))
                    {
                        <details>
                            <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-lg py-1 transition hover:bg-sand-50">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-amber-500">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
                                </svg>
                                @SyncPlural(syncActualizadas ?? 0, "reserva actualizada", "reservas actualizadas")
                            </summary>
                            <ul class="mt-1 list-disc space-y-0.5 py-1 pl-10 text-xs text-ink-500">
                                @foreach (var linea in syncDetalleActualizadas.Split(" | "))
                                {
                                    <li>@linea</li>
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <div class="flex items-center gap-2.5 py-1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-amber-500">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
                            </svg>
                            @SyncPlural(syncActualizadas ?? 0, "reserva actualizada", "reservas actualizadas")
                        </div>
                    }
                </li>
                <li>
                    @if (!string.IsNullOrEmpty(syncDetalleOmitidas))
                    {
                        <details>
                            <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-lg py-1 transition hover:bg-sand-50">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-ink-300">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                                </svg>
                                @SyncPlural(syncOmitidas ?? 0, "reserva sin cambios", "reservas sin cambios")
                            </summary>
                            <ul class="mt-1 list-disc space-y-0.5 py-1 pl-10 text-xs text-ink-500">
                                @foreach (var linea in syncDetalleOmitidas.Split(" | "))
                                {
                                    <li>@linea</li>
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <div class="flex items-center gap-2.5 py-1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-ink-300">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                            </svg>
                            @SyncPlural(syncOmitidas ?? 0, "reserva sin cambios", "reservas sin cambios")
                        </div>
                    }
                </li>
                <li>
                    @if (!string.IsNullOrEmpty(syncDetalleEliminadas))
                    {
                        <details>
                            <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-lg py-1 transition hover:bg-sand-50">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-rose-500">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                </svg>
                                @SyncPlural(syncEliminadas ?? 0, "reserva eliminada", "reservas eliminadas")
                            </summary>
                            <p class="mt-1 pl-10 text-xs text-ink-400">Ya no estaban en el Excel, así que se borraron del sitio.</p>
                            <ul class="mt-1 list-disc space-y-0.5 py-1 pl-10 text-xs text-ink-500">
                                @foreach (var linea in syncDetalleEliminadas.Split(" | "))
                                {
                                    <li>@linea</li>
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <div class="flex items-center gap-2.5 py-1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 shrink-0 text-rose-500">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                            </svg>
                            @SyncPlural(syncEliminadas ?? 0, "reserva eliminada", "reservas eliminadas")
                        </div>
                    }
                </li>
            </ul>

            @if (!string.IsNullOrEmpty(syncCabanasNoEncontradas) || !string.IsNullOrEmpty(syncNoInterpretadas) || !string.IsNullOrEmpty(syncSuperposiciones))
            {
                <div class="mt-4 space-y-3 border-t border-ink-100 pt-4">
                    @if (!string.IsNullOrEmpty(syncSuperposiciones))
                    {
                        <div class="flex gap-2.5 text-sm text-ink-600">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="mt-0.5 h-4 w-4 shrink-0 text-rose-500">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                            </svg>
                            <div>
                                <p class="font-medium text-ink-700">Fechas superpuestas en la misma cabaña</p>
                                <ul class="mt-1 list-disc space-y-0.5 pl-4 text-xs text-ink-500">
                                    @foreach (var linea in syncSuperposiciones.Split(" | "))
                                    {
                                        <li>@linea</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(syncCabanasNoEncontradas))
                    {
                        <div class="flex gap-2.5 text-sm text-ink-600">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="mt-0.5 h-4 w-4 shrink-0 text-amber-500">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                            </svg>
                            <p><span class="font-medium text-ink-700">Cabañas no encontradas:</span> @syncCabanasNoEncontradas</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(syncNoInterpretadas))
                    {
                        <details>
                            <summary class="cursor-pointer text-sm font-medium text-ink-500 transition hover:text-ink-700">Filas que no pude interpretar</summary>
                            <p class="mt-1.5 pl-1 text-xs text-ink-500">@syncNoInterpretadas</p>
                        </details>
                    }
                </div>
            }
            </div>
        </div>
    </div>
}

<div id="modal-reserva" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-ink-950/60 p-4 backdrop-blur-sm" onclick="if (event.target === this) cerrarModalReserva();">
    <div class="w-full max-w-sm rounded-2.5xl bg-white p-6 shadow-lift">
        <h3 id="modal-reserva-titulo" class="font-display text-lg font-semibold text-ink-900"></h3>
        <p id="info-reserva" class="mt-4 rounded-xl bg-sand-50 p-3 text-sm text-ink-600"></p>
        <a id="link-editar-reserva" href="#" class="mt-4 block w-full rounded-full bg-river-700 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-soft transition hover:bg-river-800">
            ✏️ Ver / editar reserva
        </a>
        <button type="button" onclick="cerrarModalReserva()" class="mt-3 w-full text-sm font-medium text-ink-400 transition hover:text-ink-600">
            Cerrar
        </button>
    </div>
</div>

<style>
    .scroll-fino::-webkit-scrollbar { height: 10px; }
    .scroll-fino::-webkit-scrollbar-track { background: transparent; }
    .scroll-fino::-webkit-scrollbar-thumb { background-color: #d8d2c4; border-radius: 999px; }
    .scroll-fino::-webkit-scrollbar-thumb:hover { background-color: #c3bba8; }
    .scroll-fino { scrollbar-width: thin; scrollbar-color: #d8d2c4 transparent; }
</style>

@section Scripts {
    <script>
        (function sincronizarScrollCalendario() {
            const arriba = document.getElementById('scroll-arriba');
            const anchoArriba = document.getElementById('scroll-arriba-ancho');
            const tabla = document.getElementById('scroll-tabla');
            if (!arriba || !anchoArriba || !tabla) return;

            const actualizarAncho = () => { anchoArriba.style.width = tabla.scrollWidth + 'px'; };
            actualizarAncho();
            window.addEventListener('resize', actualizarAncho);

            let sincronizando = false;
            arriba.addEventListener('scroll', () => {
                if (sincronizando) return;
                sincronizando = true;
                tabla.scrollLeft = arriba.scrollLeft;
                sincronizando = false;
            });
            tabla.addEventListener('scroll', () => {
                if (sincronizando) return;
                sincronizando = true;
                arriba.scrollLeft = tabla.scrollLeft;
                sincronizando = false;
            });
        })();

        const seleccionDias = new Set();

        function alternarSeleccionDia(btn) {
            const idx = btn.dataset.index;
            const badge = btn.querySelector('.badge-seleccionado');
            if (seleccionDias.has(idx)) {
                seleccionDias.delete(idx);
                btn.classList.remove('ring-river-600');
                badge.classList.add('hidden');
                badge.classList.remove('flex');
            } else {
                seleccionDias.add(idx);
                btn.classList.add('ring-river-600');
                badge.classList.remove('hidden');
                badge.classList.add('flex');
            }
            actualizarBarraSeleccion();
        }

        function actualizarBarraSeleccion() {
            const barra = document.getElementById('barra-seleccion');
            const cantidadSeleccion = seleccionDias.size;
            document.getElementById('texto-seleccion').textContent =
                cantidadSeleccion + (cantidadSeleccion === 1 ? ' día seleccionado' : ' días seleccionados');
            barra.classList.toggle('hidden', seleccionDias.size === 0);

            const linkCargar = document.getElementById('link-cargar-reserva-bulk');
            const idxs = [...seleccionDias];
            const btns = idxs.map(idx => document.querySelector(`.dia-editable[data-index="${idx}"]`)).filter(Boolean);

            if (idxs.length === 1) {
                const btn = btns[0];
                linkCargar.href = '/Admin/Reservas/Create?cabanaId=' + btn.dataset.cabanaId + '&fecha=' + btn.dataset.fecha;
                linkCargar.classList.remove('hidden');
                document.getElementById('bulk-precio').value = btn.dataset.precio ? Number(btn.dataset.precio).toLocaleString('es-AR') : '';
            } else {
                linkCargar.classList.add('hidden');
            }

            if (btns.length > 0) {
                // Por defecto, dejamos el mismo estado de bloqueo que ya tienen los días
                // seleccionados: así aplicar sin tocar nada no cambia nada por accidente.
                const todosBloqueados = btns.every(b => b.dataset.bloqueada === 'true');
                document.getElementById('bulk-bloqueada').value = todosBloqueados ? 'true' : 'false';
                actualizarEstiloBotonesBloqueo();
            }
        }

        function elegirBloqueo(bloqueada) {
            document.getElementById('bulk-bloqueada').value = bloqueada ? 'true' : 'false';
            actualizarEstiloBotonesBloqueo();
        }

        function actualizarEstiloBotonesBloqueo() {
            const bloqueada = document.getElementById('bulk-bloqueada').value === 'true';
            const btnBloquear = document.getElementById('btn-bloquear');
            const btnDesbloquear = document.getElementById('btn-desbloquear');
            btnBloquear.classList.toggle('bg-rose-600', bloqueada);
            btnBloquear.classList.toggle('text-white', bloqueada);
            btnBloquear.classList.toggle('text-ink-500', !bloqueada);
            btnBloquear.classList.toggle('hover:bg-rose-50', !bloqueada);
            btnDesbloquear.classList.toggle('bg-emerald-600', !bloqueada);
            btnDesbloquear.classList.toggle('text-white', !bloqueada);
            btnDesbloquear.classList.toggle('text-ink-500', bloqueada);
            btnDesbloquear.classList.toggle('hover:bg-emerald-50', bloqueada);
        }

        function cancelarSeleccion() {
            seleccionDias.forEach(idx => {
                const btn = document.querySelector(`.dia-editable[data-index="${idx}"]`);
                if (!btn) return;
                btn.classList.remove('ring-river-600');
                const badge = btn.querySelector('.badge-seleccionado');
                badge.classList.add('hidden');
                badge.classList.remove('flex');
            });
            seleccionDias.clear();
            document.getElementById('bulk-precio').value = '';
            document.getElementById('bulk-bloqueada').value = 'false';
            actualizarEstiloBotonesBloqueo();
            actualizarBarraSeleccion();
        }

        function formatearMiles(input) {
            const soloDigitos = input.value.replace(/\D/g, '');
            input.value = soloDigitos ? Number(soloDigitos).toLocaleString('es-AR') : '';
        }

        function aplicarSeleccion() {
            const precioTexto = document.getElementById('bulk-precio').value.replace(/\D/g, '');
            const bloqueada = document.getElementById('bulk-bloqueada').value === 'true';

            seleccionDias.forEach(idx => {
                const btn = document.querySelector(`.dia-editable[data-index="${idx}"]`);
                if (!btn) return;

                btn.dataset.precio = precioTexto;
                btn.dataset.bloqueada = bloqueada ? 'true' : 'false';

                document.querySelector(`input[name="dias[${idx}].Precio"]`).value = precioTexto;
                document.querySelector(`input[name="dias[${idx}].Bloqueada"]`).value = bloqueada ? 'true' : 'false';

                btn.classList.remove('bg-green-100', 'text-green-700', 'hover:bg-green-200', 'bg-red-50', 'text-red-700', 'hover:bg-red-100');
                if (bloqueada) {
                    btn.classList.add('bg-green-100', 'text-green-700', 'hover:bg-green-200');
                } else {
                    btn.classList.add('bg-red-50', 'text-red-700', 'hover:bg-red-100');
                }

                const etiquetaEstado = btn.querySelector('.etiqueta-estado');
                if (etiquetaEstado) {
                    etiquetaEstado.textContent = bloqueada ? 'Bloqueada' : 'Disponible';
                }
                const etiquetaPrecio = btn.querySelector('.etiqueta-precio');
                if (etiquetaPrecio) {
                    etiquetaPrecio.textContent = precioTexto ? '$' + Number(precioTexto).toLocaleString('es-AR') : 'Sin precio';
                }
            });

            cancelarSeleccion();
            document.getElementById('form-tarifas').requestSubmit();
        }

        function abrirReserva(btn) {
            document.getElementById('modal-reserva-titulo').textContent = btn.dataset.cabanaNombre + ' · ' + btn.dataset.fechaTexto;
            document.getElementById('info-reserva').textContent = btn.dataset.infoReserva;
            document.getElementById('link-editar-reserva').href = '/Admin/Reservas/Edit/' + btn.dataset.reservaId;
            document.getElementById('modal-reserva').classList.remove('hidden');
        }

        function cerrarModalReserva() {
            document.getElementById('modal-reserva').classList.add('hidden');
        }

        function cerrarModalSincronizacion() {
            const modal = document.getElementById('modal-sincronizacion');
            if (modal) modal.classList.add('hidden');
        }
    </script>
}
