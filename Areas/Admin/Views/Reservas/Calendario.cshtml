@section Scripts {
    <script>
        (function sincronizarScrollCalendario() {
            const arriba = document.getElementById('scroll-arriba');
            const anchoArriba = document.getElementById('scroll-arriba-ancho');
            const tabla = document.getElementById('scroll-tabla');
            if (!arriba || !anchoArriba || !tabla) return;

            const actualizarAncho = () => { anchoArriba.style.width = tabla.scrollWidth + 'px'; };
            actualizarAncho();
            window.addEventListener('resize', actualizarAncho);

            let sincronizando = false;
            arriba.addEventListener('scroll', () => {
                if (sincronizando) return;
                sincronizando = true;
                tabla.scrollLeft = arriba.scrollLeft;
                sincronizando = false;
            });
            tabla.addEventListener('scroll', () => {
                if (sincronizando) return;
                sincronizando = true;
                arriba.scrollLeft = tabla.scrollLeft;
                sincronizando = false;
            });
        })();

        (function centrarScrollEnHoy() {
            const tabla = document.getElementById('scroll-tabla');
            const arriba = document.getElementById('scroll-arriba');
            const columnaHoy = document.getElementById('col-hoy');
            if (!tabla || !columnaHoy) return;

            const columnaNombres = tabla.querySelector('thead th');
            const anchoColumnaNombres = columnaNombres ? columnaNombres.offsetWidth : 0;
            const offset = columnaHoy.offsetLeft - anchoColumnaNombres;
            tabla.scrollLeft = Math.max(0, offset);
            if (arriba) arriba.scrollLeft = tabla.scrollLeft;
        })();

        const CLAVE_OCULTAR_SOLICITUDES = 'calendarioOcultarSolicitudes';

        function aplicarVisibilidadSolicitudes(ocultar) {
            document.querySelectorAll('.solicitud-cell').forEach(el => el.classList.toggle('hidden', ocultar));
            document.querySelectorAll('.solicitud-alt-cell').forEach(el => el.classList.toggle('hidden', !ocultar));
            document.querySelectorAll('.solicitud-alt-input').forEach(el => { el.disabled = !ocultar; });

            document.getElementById('icono-ojo-abierto').classList.toggle('hidden', ocultar);
            document.getElementById('icono-ojo-cerrado').classList.toggle('hidden', !ocultar);
            document.getElementById('texto-toggle-solicitudes').textContent = ocultar ? 'Mostrar solicitudes' : 'Ocultar solicitudes';
            document.getElementById('btn-toggle-solicitudes').setAttribute('aria-pressed', ocultar ? 'true' : 'false');
        }

        function alternarVisibilidadSolicitudes() {
            let ocultarActual = false;
            try { ocultarActual = localStorage.getItem(CLAVE_OCULTAR_SOLICITUDES) === '1'; } catch { }
            const ocultar = !ocultarActual;
            try { localStorage.setItem(CLAVE_OCULTAR_SOLICITUDES, ocultar ? '1' : '0'); } catch { }
            aplicarVisibilidadSolicitudes(ocultar);
        }

        (function inicializarVisibilidadSolicitudes() {
            let ocultar = false;
            try { ocultar = localStorage.getItem(CLAVE_OCULTAR_SOLICITUDES) === '1'; } catch { }
            aplicarVisibilidadSolicitudes(ocultar);
        })();

        const seleccionDias = new Set();

        function alternarSeleccionDia(btn) {
            const idx = btn.dataset.index;
            const badge = btn.querySelector('.badge-seleccionado');
            if (seleccionDias.has(idx)) {
                seleccionDias.delete(idx);
                btn.classList.remove('ring-river-600');
                badge.classList.add('hidden');
                badge.classList.remove('flex');
            } else {
                seleccionDias.add(idx);
                btn.classList.add('ring-river-600');
                badge.classList.remove('hidden');
                badge.classList.add('flex');
            }
            actualizarBarraSeleccion();
        }

        const TRAMOS = [2, 4, 6];
        // Parámetros para que Cargar / Editar / Aprobar vuelvan a este mes del calendario al terminar.
        const ORIGEN_CALENDARIO = '?vista=Calendario&anio=@primerDia.Year&mes=@primerDia.Month';

        // Cada celda lleva en data-tramos los tramos de precio que su cabaña admite: una cabaña
        // para 4 personas no tiene precio para 6.
        function tramosDeLaCelda(btn) {
            return (btn.dataset.tramos || TRAMOS.join(',')).split(',').map(Number);
        }

        // En la barra de precios, un tramo solo se puede cargar si alguna de las celdas
        // seleccionadas lo admite; si no, se deshabilita y se vacía.
        function actualizarTramosDeLaBarra(btns) {
            TRAMOS.forEach(t => {
                const input = document.getElementById('bulk-precio-' + t);
                const habilitado = btns.length === 0 || btns.some(b => tramosDeLaCelda(b).includes(t));
                input.disabled = !habilitado;
                input.placeholder = habilitado ? '$' : 'No aplica';
                if (!habilitado) {
                    input.value = '';
                }
                input.parentElement.classList.toggle('opacity-40', !habilitado);
            });
        }

        function sumarUnDia(fechaTexto) {
            const [anio, mes, dia] = fechaTexto.split('-').map(Number);
            const fecha = new Date(Date.UTC(anio, mes - 1, dia));
            fecha.setUTCDate(fecha.getUTCDate() + 1);
            return fecha.toISOString().slice(0, 10);
        }

        // Para poder cargar una reserva que cubra la selección, todos los días elegidos tienen que
        // ser de la misma cabaña y seguidos (sin huecos).
        function puedeCargarReservaEnSeleccion(btns) {
            const cabanaId = btns[0].dataset.cabanaId;
            if (!btns.every(b => b.dataset.cabanaId === cabanaId)) {
                return false;
            }

            const fechas = btns.map(b => b.dataset.fecha).sort();
            for (let i = 1; i < fechas.length; i++) {
                if (sumarUnDia(fechas[i - 1]) !== fechas[i]) {
                    return false;
                }
            }
            return true;
        }

        function actualizarBarraSeleccion() {
            const barra = document.getElementById('barra-seleccion');
            const cantidadSeleccion = seleccionDias.size;
            // En el celu alcanza con "2 días"; el "seleccionados" solo se muestra en pantallas grandes.
            document.getElementById('texto-seleccion').innerHTML =
                cantidadSeleccion + (cantidadSeleccion === 1 ? ' día' : ' días') +
                '<span class="hidden sm:inline">&nbsp;' + (cantidadSeleccion === 1 ? 'seleccionado' : 'seleccionados') + '</span>';
            barra.classList.toggle('hidden', seleccionDias.size === 0);

            const linkCargar = document.getElementById('link-cargar-reserva-bulk');
            const idxs = [...seleccionDias];
            const btns = idxs.map(idx => document.querySelector(`.dia-editable[data-index="${idx}"]`)).filter(Boolean);

            actualizarTramosDeLaBarra(btns);

            if (idxs.length === 1) {
                TRAMOS.forEach(t => {
                    const valor = btns[0].dataset['precio' + t];
                    document.getElementById('bulk-precio-' + t).value = valor ? Number(valor).toLocaleString('es-AR') : '';
                });
            }

            if (btns.length > 0 && puedeCargarReservaEnSeleccion(btns)) {
                const fechas = btns.map(b => b.dataset.fecha).sort();
                const fechaDesde = fechas[0];
                const fechaHastaExclusiva = sumarUnDia(fechas[fechas.length - 1]);
                linkCargar.href = '/Admin/Reservas/Create?cabanaId=' + btns[0].dataset.cabanaId + '&fecha=' + fechaDesde + '&fechaHasta=' + fechaHastaExclusiva + '&' + ORIGEN_CALENDARIO.substring(1);
                linkCargar.classList.remove('hidden');
            } else {
                linkCargar.classList.add('hidden');
            }

            actualizarBotonEliminarPromo(btns);
        }

        function actualizarBotonEliminarPromo(btns) {
            const idsPromo = [...new Set(btns.map(b => b.dataset.promoId).filter(Boolean))];
            const contenedor = document.getElementById('eliminar-promo-inputs');
            contenedor.innerHTML = '';
            idsPromo.forEach(id => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'ids';
                input.value = id;
                contenedor.appendChild(input);
            });
            document.getElementById('form-eliminar-promo').classList.toggle('hidden', idsPromo.length === 0);
        }

        // Permite borrar la promo de una celda que tiene una reserva encima (donde no se
        // puede seleccionar el día para el borrado en lote porque el clic abre la reserva).
        function eliminarPromoDesdeCelda(promoId) {
            const inputs = document.getElementById('eliminar-promo-inputs');
            inputs.innerHTML = '';
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'ids';
            input.value = promoId;
            inputs.appendChild(input);
            mostrarConfirmacion('¿Eliminar la promoción de estos días? No se puede deshacer.', document.getElementById('form-eliminar-promo'));
        }

        function cancelarSeleccion() {
            seleccionDias.forEach(idx => {
                const btn = document.querySelector(`.dia-editable[data-index="${idx}"]`);
                if (!btn) return;
                btn.classList.remove('ring-river-600');
                const badge = btn.querySelector('.badge-seleccionado');
                badge.classList.add('hidden');
                badge.classList.remove('flex');
            });
            seleccionDias.clear();
            TRAMOS.forEach(t => { document.getElementById('bulk-precio-' + t).value = ''; });
            actualizarBotonEliminarPromo([]);
            actualizarBarraSeleccion();
        }

        function formatearMiles(input, idCampoReal) {
            const soloDigitos = input.value.replace(/\D/g, '');
            input.value = soloDigitos ? Number(soloDigitos).toLocaleString('es-AR') : '';
            if (idCampoReal) {
                document.getElementById(idCampoReal).value = soloDigitos;
            }
        }

        // Con borrar = true se vacían los tres precios de los días elegidos; si no, sólo se
        // pisan los tramos que tengan un valor cargado.
        function aplicarSeleccion(borrar) {
            const nuevos = {};
            TRAMOS.forEach(t => {
                nuevos[t] = document.getElementById('bulk-precio-' + t).value.replace(/\D/g, '');
            });

            seleccionDias.forEach(idx => {
                const btn = document.querySelector(`.dia-editable[data-index="${idx}"]`);
                if (!btn) return;

                const tramosDeEstaCelda = tramosDeLaCelda(btn);
                TRAMOS.forEach(t => {
                    if (!tramosDeEstaCelda.includes(t)) return;
                    if (!borrar && !nuevos[t]) return;
                    const valor = borrar ? '' : nuevos[t];
                    btn.dataset['precio' + t] = valor;
                    document.querySelector(`input[name="dias[${idx}].Precio${t}"]`).value = valor;
                    const linea = btn.querySelector(`.etiqueta-precio [data-tramo="${t}"]`);
                    if (linea) {
                        linea.textContent = valor ? Number(valor).toLocaleString('es-AR') : '–';
                    }
                });
            });

            cancelarSeleccion();
            document.getElementById('form-tarifas').requestSubmit();
        }

        function abrirReserva(btn) {
            document.getElementById('modal-reserva-titulo').textContent = btn.dataset.cabanaNombre + ' · ' + btn.dataset.fechaTexto;
            document.getElementById('info-reserva-resumen').textContent = btn.dataset.infoResumen;
            document.getElementById('info-reserva-pago').textContent = btn.dataset.infoPago;
            document.getElementById('info-reserva-pagar').textContent = btn.dataset.infoPagar;

            const esPendiente = btn.dataset.infoPendiente === 'true';
            const estado = document.getElementById('info-reserva-estado');
            estado.textContent = btn.dataset.infoEstado;
            estado.className = 'shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold ' +
                (esPendiente ? 'bg-sky-100 text-sky-700' : 'bg-river-100 text-river-700');

            document.getElementById('link-editar-reserva').href = '/Admin/Reservas/Edit/' + btn.dataset.reservaId + ORIGEN_CALENDARIO;
            document.getElementById('input-eliminar-reserva-id').value = btn.dataset.reservaId;
            document.getElementById('input-aprobar-reserva-id').value = btn.dataset.reservaId;
            document.getElementById('form-aprobar-reserva').hidden = !esPendiente;
            document.getElementById('modal-reserva').classList.remove('hidden');
        }

        function cerrarModalReserva() {
            document.getElementById('modal-reserva').classList.add('hidden');
        }

        function cerrarModalSincronizacion() {
            const modal = document.getElementById('modal-sincronizacion');
            if (modal) modal.classList.add('hidden');
        }

        function formatearFechaTexto(fechaIso) {
            const [anio, mes, dia] = fechaIso.split('-');
            return dia + '/' + mes + '/' + anio;
        }

        function abrirModalPromoDesdeSeleccion() {
            const idxs = [...seleccionDias];
            const btns = idxs.map(idx => document.querySelector(`.dia-editable[data-index="${idx}"]`)).filter(Boolean);
            if (btns.length === 0) return;

            const fechas = btns.map(b => b.dataset.fecha).sort();
            const fechaDesde = fechas[0];
            const fechaHasta = fechas[fechas.length - 1];
            const cabanaIdsSeleccionadas = new Set(btns.map(b => b.dataset.cabanaId));
            const nochesSeleccionadas = new Set(fechas).size;

            document.getElementById('promo-fecha-desde').value = fechaDesde;
            document.getElementById('promo-fecha-hasta').value = fechaHasta;
            document.getElementById('promo-rango-texto').textContent =
                fechaDesde === fechaHasta
                    ? 'Para el ' + formatearFechaTexto(fechaDesde)
                    : 'Del ' + formatearFechaTexto(fechaDesde) + ' al ' + formatearFechaTexto(fechaHasta);

            document.querySelectorAll('.promo-cabana-check').forEach(function (chk) {
                chk.checked = cabanaIdsSeleccionadas.has(chk.value);
            });

            // La promo sólo puede cubrir estadías que entren enteras en el rango elegido: si se
            // seleccionan 1 o 2 noches, los precios de más noches no tienen sentido y se ocultan.
            [1, 2, 3].forEach(function (n) {
                const mostrar = nochesSeleccionadas >= 3 || n <= nochesSeleccionadas;
                const sufijo = n === 1 ? 'noche' : 'noches';
                const campo = document.getElementById('promo-campo-' + n + sufijo);
                const input = document.getElementById('promo-input-' + n + sufijo);
                const real = document.getElementById('promo-real-' + n + sufijo);
                campo.classList.toggle('hidden', !mostrar);
                if (!mostrar) {
                    input.value = '';
                    real.value = '';
                }
            });
            document.getElementById('promo-nota-3noches').classList.toggle('hidden', nochesSeleccionadas < 3);

            document.getElementById('modal-promo').classList.remove('hidden');
        }

        function cerrarModalPromo() {
            document.getElementById('modal-promo').classList.add('hidden');
        }

        (function autoSincronizarCalendario() {
            const anio = @primerDia.Year;
            const mes = @primerDia.Month;
            const syncConectada = @(syncConectada ? "true" : "false");
            const firmaActual = @Html.Raw(Json.Serialize((string)ViewBag.FirmaCalendario));
            let excelModificadoConocido = @Html.Raw(Json.Serialize(((DateTime?)ViewBag.ExcelModificado)?.ToString("o")));

            function hayInteraccionAbierta() {
                const abiertos = ['modal-reserva', 'modal-promo', 'modal-sincronizacion'].some(id => {
                    const el = document.getElementById(id);
                    return el && !el.classList.contains('hidden');
                });
                if (abiertos) return true;
                const barraSeleccion = document.getElementById('barra-seleccion');
                return !!barraSeleccion && !barraSeleccion.classList.contains('hidden');
            }

            async function obtenerEstado() {
                const resp = await fetch(`@Url.Action("EstadoCalendario", "Reservas")?anio=${anio}&mes=${mes}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                return resp.ok ? await resp.json() : null;
            }

            async function verificarCambios() {
                if (hayInteraccionAbierta()) return;

                let estado;
                try {
                    estado = await obtenerEstado();
                } catch {
                    return;
                }
                if (!estado) return;

                // El "modificado" del Excel puede cambiar solo (co-autoría/autoguardado) sin que
                // haya datos nuevos: se sincroniza en silencio, pero recién se recarga la página
                // si eso cambió algo realmente visible en el calendario (la firma).
                const huboCambioExcel = syncConectada && estado.excelModificado !== excelModificadoConocido;
                excelModificadoConocido = estado.excelModificado;

                if (huboCambioExcel) {
                    const form = document.getElementById('form-sincronizar');
                    const token = form ? form.querySelector('input[name="__RequestVerificationToken"]').value : null;
                    if (token) {
                        try {
                            const body = new URLSearchParams();
                            body.set('anio', anio);
                            body.set('mes', mes);
                            body.set('__RequestVerificationToken', token);
                            await fetch(form.action, { method: 'POST', body });
                        } catch {
                            // Si falla la sincronización silenciosa, igual chequeamos la firma más abajo.
                        }
                    }

                    try {
                        estado = await obtenerEstado();
                    } catch {
                        return;
                    }
                    if (!estado) return;
                }

                if (estado.firma === firmaActual || hayInteraccionAbierta()) return;

                window.location.reload();
            }

            setInterval(verificarCambios, 10000);
        })();
    </script>
}
