                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="mt-0.5 h-4 w-4 shrink-0 text-rose-500">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                            </svg>
                            <div>
                                <p class="font-medium text-ink-700">Fechas superpuestas en la misma cabaña</p>
                                <ul class="mt-1 list-disc space-y-0.5 pl-4 text-xs text-ink-500">
                                    @foreach (var linea in syncSuperposiciones.Split(" | "))
