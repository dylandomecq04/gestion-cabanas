            @if (!string.IsNullOrEmpty(syncCabanasNoEncontradas) || !string.IsNullOrEmpty(syncNoInterpretadas) || !string.IsNullOrEmpty(syncSuperposiciones))
            {
                <div class="mt-4 space-y-3 border-t border-ink-100 pt-4">
