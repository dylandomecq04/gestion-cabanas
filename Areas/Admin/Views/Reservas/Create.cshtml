@model Reserva
@{
    var esSolicitud = Model.Estado == EstadoReserva.Pendiente;
    var titulo = esSolicitud ? "Cargar solicitud" : "Cargar reserva";
    ViewData["Title"] = titulo;
    var cabanas = (List<Cabana>)ViewBag.Cabanas;
    string? vista = ViewBag.Vista;
    int? anioOrigen = ViewBag.Anio;
    int? mesOrigen = ViewBag.Mes;
    var volverACalendario = vista == "Calendario" && anioOrigen.HasValue && mesOrigen.HasValue;
}

<h1 class="mb-6 font-display text-2xl font-semibold text-ink-900">@titulo</h1>

<form asp-action="Create" asp-route-vista="@vista" asp-route-anio="@anioOrigen" asp-route-mes="@mesOrigen" method="post" class="max-w-2xl space-y-4 rounded-2.5xl bg-white p-4 shadow-soft ring-1 ring-ink-100 sm:p-6" data-loading-text="@(esSolicitud ? "Creando la solicitud..." : "Creando la reserva...")">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="@(ViewData.ModelState.IsValid ? "hidden" : "rounded-xl bg-rose-50 px-4 py-2 text-sm font-medium text-rose-700")"></div>
    }

    <div>
        <label class="mb-1 block text-sm font-medium text-ink-700">Cabaña</label>
        <select asp-for="CabanaId" asp-items="@(new SelectList(cabanas, "Id", "Nombre"))"
                class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100"></select>
    </div>
    <div>
        <label asp-for="NombreHuesped" class="mb-1 block text-sm font-medium text-ink-700"></label>
        <input asp-for="NombreHuesped" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
        <span asp-validation-for="NombreHuesped" class="mt-1 block text-xs font-medium text-rose-600"></span>
    </div>
    <div>
        <label asp-for="Telefono" class="mb-1 block text-sm font-medium text-ink-700"></label>
        <input asp-for="Telefono" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
    </div>
    <div class="grid grid-cols-2 gap-4">
        <div>
            <label asp-for="FechaDesde" class="mb-1 block text-sm font-medium text-ink-700"></label>
            <input asp-for="FechaDesde" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
        </div>
        <div>
            <label asp-for="FechaHasta" class="mb-1 block text-sm font-medium text-ink-700"></label>
            <input asp-for="FechaHasta" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            <span asp-validation-for="FechaHasta" class="mt-1 block text-xs font-medium text-rose-600"></span>
        </div>
    </div>
    <div id="disponibilidad" class="rounded-xl bg-river-50 px-4 py-3 text-sm">
        <p id="disponibilidad-titulo" class="font-medium text-river-800"></p>
        <div id="disponibilidad-lista" class="mt-2 flex flex-wrap gap-2"></div>
    </div>
    <div class="grid grid-cols-2 items-end gap-4">
        <div>
            <label asp-for="CantidadPersonas" class="mb-1 block text-sm font-medium text-ink-700"></label>
            <input asp-for="CantidadPersonas" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            <span asp-validation-for="CantidadPersonas" class="mt-1 block text-xs font-medium text-rose-600"></span>
        </div>
        <div>
            <label asp-for="CantidadMenores" class="mb-1 block text-sm font-medium text-ink-700">Menores (incluidos en el total)</label>
            <input asp-for="CantidadMenores" class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            <span asp-validation-for="CantidadMenores" class="mt-1 block text-xs font-medium text-rose-600"></span>
        </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
        <div>
            <label class="mb-1 block text-sm font-medium text-ink-700">Estado</label>
            <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoReserva>()"
                    class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100"></select>
        </div>
        <div></div>
    </div>
    <div class="grid grid-cols-2 gap-4">
        <div>
            <label asp-for="Pago" class="mb-1 block text-sm font-medium text-ink-700"></label>
            <input type="text" inputmode="numeric" id="pago-display" placeholder="0"
                   value="@(Model.Pago.HasValue ? Model.Pago.Value.ToString("N0", new System.Globalization.CultureInfo("es-AR")) : "")"
                   oninput="formatearMiles(this, 'pago-real')"
                   class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            <input type="hidden" asp-for="Pago" id="pago-real" />
        </div>
        <div>
            <label asp-for="Valor" class="mb-1 block text-sm font-medium text-ink-700"></label>
            <input type="text" inputmode="numeric" id="valor-display" placeholder="0"
                   value="@(Model.Valor.HasValue ? Model.Valor.Value.ToString("N0", new System.Globalization.CultureInfo("es-AR")) : "")"
                   oninput="formatearMiles(this, 'valor-real')"
                   class="w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 shadow-sm transition focus:border-river-400 focus:outline-none focus:ring-4 focus:ring-river-100" />
            <input type="hidden" asp-for="Valor" id="valor-real" />
        </div>
    </div>
    <div class="flex items-center gap-3 pt-2">
        <button type="submit" class="rounded-full bg-river-700 px-6 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-river-800">Guardar</button>
        @if (volverACalendario)
        {
            <a asp-action="Calendario" asp-route-anio="@anioOrigen" asp-route-mes="@mesOrigen" class="text-sm font-medium text-ink-500 hover:text-ink-700">Cancelar</a>
        }
        else
        {
            <a asp-action="Index" class="text-sm font-medium text-ink-500 hover:text-ink-700">Cancelar</a>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function formatearMiles(input, idCampoReal) {
            const soloDigitos = input.value.replace(/\D/g, '');
            input.value = soloDigitos ? Number(soloDigitos).toLocaleString('es-AR') : '';
            document.getElementById(idCampoReal).value = soloDigitos;
        }

        (function () {
            const selectCabana = document.getElementById('CabanaId');
            const inputDesde = document.getElementById('FechaDesde');
            const inputHasta = document.getElementById('FechaHasta');
            const titulo = document.getElementById('disponibilidad-titulo');
            const lista = document.getElementById('disponibilidad-lista');
            const urlDisponibles = '@Url.Action("CabanasDisponibles", "Reservas", new { area = "Admin" })';
            let libres = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((List<Cabana>?)ViewBag.Libres ?? new List<Cabana>()).Select(c => new { id = c.Id, nombre = c.Nombre })));
            let rangoValido = true;
            let pedido = 0;

            for (const opcion of selectCabana.options) {
                opcion.dataset.nombre = opcion.textContent;
            }

            function fmt(iso) {
                const [a, m, d] = iso.split('-');
                return d + '/' + m + '/' + a;
            }

            function pintar() {
                const idsLibres = new Set(libres.map(c => c.id));
                for (const opcion of selectCabana.options) {
                    opcion.textContent = idsLibres.has(Number(opcion.value)) || !rangoValido
                        ? opcion.dataset.nombre
                        : opcion.dataset.nombre + ' (ocupada)';
                }

                lista.replaceChildren();
                if (!rangoValido) {
                    titulo.textContent = 'Elegí una fecha de salida posterior a la de entrada para ver qué cabañas están libres.';
                    return;
                }

                const rango = fmt(inputDesde.value) + ' al ' + fmt(inputHasta.value);
                if (libres.length === 0) {
                    titulo.textContent = 'No hay ninguna cabaña libre del ' + rango + '.';
                    return;
                }

                titulo.textContent = (libres.length === 1 ? 'Cabaña libre' : 'Cabañas libres') + ' del ' + rango + ':';
                for (const cabana of libres) {
                    const elegida = Number(selectCabana.value) === cabana.id;
                    const boton = document.createElement('button');
                    boton.type = 'button';
                    boton.textContent = cabana.nombre;
                    boton.className = 'rounded-full px-3.5 py-1.5 text-sm font-semibold ring-1 transition ' +
                        (elegida
                            ? 'bg-river-700 text-white ring-river-700'
                            : 'bg-white text-river-800 ring-river-300 hover:bg-river-100');
                    boton.addEventListener('click', () => {
                        selectCabana.value = cabana.id;
                        pintar();
                    });
                    lista.appendChild(boton);
                }
            }

            async function actualizar() {
                rangoValido = !!inputDesde.value && !!inputHasta.value && inputHasta.value > inputDesde.value;
                if (!rangoValido) {
                    libres = [];
                    pintar();
                    return;
                }

                const actual = ++pedido;
                try {
                    const respuesta = await fetch(urlDisponibles + '?desde=' + inputDesde.value + '&hasta=' + inputHasta.value);
                    if (!respuesta.ok) return;
                    const datos = await respuesta.json();
                    if (actual !== pedido) return;
                    libres = datos;
                    pintar();
                } catch {
                    // Sin conexión: se deja lo que ya se estaba mostrando.
                }
            }

            rangoValido = !!inputDesde.value && !!inputHasta.value && inputHasta.value > inputDesde.value;
            pintar();
            selectCabana.addEventListener('change', pintar);
            inputDesde.addEventListener('change', actualizar);
            inputHasta.addEventListener('change', actualizar);
        })();
    </script>
}
